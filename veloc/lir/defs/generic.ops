import "../../defs/prelude.ops";

// Operand-array storage is independent of operation semantics and type contracts.
type StackSlot = rust("crate::StackSlot");
type Block = rust("veloc_mir::Block");

type Reg = rust("crate::Reg");
enum InstField {
    variants: [Imm(i64), FImm(f64), Block(Block), StackSlot(StackSlot), IntCC(IntCC), FloatCC(FloatCC), Global(SymbolId)],
}
enum ControlFlow {
    variants: [Next, Branch, Jump, Return, Call, Trap],
}
storage Operands {
    opcode: GenericOpcode,
    view: InstView,
    reader: InstRead,
    writer: InstBuild,
    prefix: "G_",
    register: Reg,
    attributes: InstField,
    control: ControlFlow::Next,
}

struct UnaryReg {
    dst: Reg,
    src: Reg,
}

struct BinaryReg {
    dst: Reg,
    lhs: Reg,
    rhs: Reg,
}

struct BinaryRegWithFlags {
    dst: Reg,
    flag: Reg,
    lhs: Reg,
    rhs: Reg,
    carry_in: optional(Reg),
}

struct Load {
    dst: Reg,
    base: Reg,
}

struct LoadOffset {
    dst: Reg,
    base: Reg,
    offset: i64,
}

struct IndexedLoad {
    dst: Reg,
    wb_dst: Reg,
    base: Reg,
    offset: i64,
}

struct Store {
    src: Reg,
    base: Reg,
}

struct StackLoad {
    dst: Reg,
    slot: StackSlot,
}

struct StackAddr {
    dst: Reg,
    slot: StackSlot,
}

struct StackStore {
    src: Reg,
    slot: StackSlot,
}

struct StoreOffset {
    src: Reg,
    base: Reg,
    offset: i64,
}

struct IndexedStore {
    wb_dst: Reg,
    src: Reg,
    base: Reg,
    offset: i64,
}

struct Constant {
    dst: Reg,
    imm: i64,
}

struct FloatConstant {
    dst: Reg,
    imm: f64,
}

struct Branch {
    target: Block,
}

struct BranchCond {
    cond: Reg,
    then_blk: Block,
    else_blk: Block,
}

struct BranchTable {
    index: Reg,
}

struct Select {
    dst: Reg,
    cond: Reg,
    v1: Reg,
    v2: Reg,
}

struct ICmp {
    dst: Reg,
    lhs: Reg,
    rhs: Reg,
    cc: IntCC,
}

struct FCmp {
    dst: Reg,
    lhs: Reg,
    rhs: Reg,
    cc: FloatCC,
}

struct Arg {
    dst: Reg,
    index: i64,
}

struct Return {
    values: sequence(Reg),
}

struct Unreachable {

}

struct Call {
    results: sequence(Reg),
    callee: SymbolId,
    args: sequence(Reg),
}
struct CallIndirect {
    results: sequence(Reg),
    callee: Reg,
    args: sequence(Reg),
}

// Logical signatures use the same operation model and type checker as every IR.

op G_ADD<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.add(lhs, rhs)
}

op G_SUB<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.sub(lhs, rhs)
}

op G_MUL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.mul(lhs, rhs)
}

op G_SDIV<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UDIV<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SREM<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UREM<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_NEG<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo {},
    storage: UnaryReg { dst, src },
    semantics: bv.neg(src)
}

op G_FADD<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FSUB<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FMUL<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FDIV<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FNEG<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FABS<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FSQRT<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_AND<T: Integer | Type::BOOL | vectors(Type::BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.and(lhs, rhs)
}

op G_OR<T: Integer | Type::BOOL | vectors(Type::BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.or(lhs, rhs)
}

op G_XOR<T: Integer | Type::BOOL | vectors(Type::BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.xor(lhs, rhs)
}

op G_CTPOP<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_CTLZ<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_CTTZ<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_SHL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_LSHR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ASHR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ROTL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ROTR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
