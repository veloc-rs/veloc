op G_SSUBSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_USUBSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_LOAD(base: Type::PTR) -> (dst: Any) {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: Load { dst, base },
}

op G_STORE(src: Any, base: Type::PTR) -> () {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: Store { src, base },
}

op G_PTR_ADD(lhs: Type::PTR, rhs: ScalarInteger) -> (dst: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_STACK_LOAD(slot: StackSlot) -> (dst: Any) {
    meta: OpInfo { memory: MemoryEffect::known(MemoryEffects::READ) },
    storage: StackLoad { dst, slot },
}

op G_STACK_STORE(src: Any, slot: StackSlot) -> () {
    meta: OpInfo { memory: MemoryEffect::known(MemoryEffects::WRITE) },
    storage: StackStore { src, slot },
}

op G_STACK_ADDR(slot: StackSlot) -> (dst: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: StackAddr { dst, slot },
}

op G_OFFSET_LOAD(base: Type::PTR, offset: i64) -> (dst: Any) {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: LoadOffset { dst, base, offset },
}

op G_OFFSET_STORE(src: Any, base: Type::PTR, offset: i64) -> () {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: StoreOffset { src, base, offset },
}

op G_INDEXED_LOAD(base: Type::PTR, offset: i64) -> (dst: Any, wb_dst: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: IndexedLoad { dst, wb_dst, base, offset },
}

op G_INDEXED_STORE(src: Any, base: Type::PTR, offset: i64) -> (wb_dst: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    storage: IndexedStore { wb_dst, src, base, offset },
}

op G_CONSTANT(imm: i64) -> (dst: ScalarInteger | Type::BOOL | Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: Constant { dst, imm },
}

op G_FCONSTANT(imm: f64) -> (dst: ScalarFloat) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: FloatConstant { dst, imm },
}

op G_TRUNC(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_ZEXT(src: Integer | Type::BOOL | vectors(Type::BOOL)) -> (dst: Integer) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_SEXT(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FPTOSI(src: Float) -> (dst: Integer) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FPTOUI(src: Float) -> (dst: Integer) {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_SITOFP(src: Integer) -> (dst: Float) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_UITOFP(src: Integer) -> (dst: Float) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FPTRUNC(src: Float) -> (dst: Float) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_FPEXT(src: Float) -> (dst: Float) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_BITCAST(src: Any) -> (dst: Any) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_INTTOPTR(src: ScalarInteger) -> (dst: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_PTRTOINT(src: Type::PTR) -> (dst: ScalarInteger) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_BR(target: Block) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    storage: Branch { target },
    flow: Jump,
}

op G_BRCOND(cond: Type::BOOL, then_blk: Block, else_blk: Block) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    storage: BranchCond { cond, then_blk, else_blk },
    flow: Jump,
}

op G_BRJT(index: ScalarInteger) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    storage: BranchTable { index },
    flow: Jump,
}

op G_RET(values: sequence(Value)) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    storage: Return { values },
    flow: Return,
}

op G_CALL(callee: SymbolId, args: sequence(Value)) -> signature {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::UNKNOWN },
    storage: Call { results: results(), callee, args },
    flow: Call,
}

op G_CALLIND(callee: Type::PTR, args: sequence(Value)) -> signature {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::UNKNOWN },
    storage: CallIndirect { results: results(), callee, args },
    flow: Call,
}

op G_ARG(index: i64) -> (dst: Any) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: Arg { dst, index },
    verify { require(index >= 0, "argument index must be nonnegative"); }
}

op G_SELECT<T: Any>(cond: Type::BOOL, v1: T, v2: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: Select { dst, cond, v1, v2 },
}

op G_COPY<T: Any>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_UNREACHABLE() -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR.union(OpTraits::ABORT).union(OpTraits::MAY_TRAP), memory: MemoryEffect::NONE },
    storage: Unreachable {},
    flow: Trap,
}
