// Operand-array storage is independent of operation semantics and type contracts.
storage Operands { prefix: "G_" }

record UnaryReg {
    dst: Def,
    src: Use,
}

record BinaryReg {
    dst: Def,
    lhs: Use,
    rhs: Use,
}

record BinaryRegWithFlags {
    dst: Def,
    flag: Def,
    lhs: Use,
    rhs: Use,
    carry_in: OptionalUse,
}

record Load {
    dst: Def,
    base: Use,
}

record LoadOffset {
    dst: Def,
    base: Use,
    offset: Imm,
}

record IndexedLoad {
    dst: Def,
    wb_dst: TiedDefUse,
    base: Use,
    offset: Imm,
}

record Store {
    src: Use,
    base: Use,
}

record StackLoad {
    dst: Def,
    slot: StackSlot,
}

record StackAddr {
    dst: Def,
    slot: StackSlot,
}

record StackStore {
    src: Use,
    slot: StackSlot,
}

record StoreOffset {
    src: Use,
    base: Use,
    offset: Imm,
}

record IndexedStore {
    wb_dst: TiedDefUse,
    src: Use,
    base: Use,
    offset: Imm,
}

record Constant {
    dst: Def,
    imm: Imm,
}

record FloatConstant {
    dst: Def,
    imm: FImm,
}
layout FloatConstant {
    view: FConstantInst,
    accessor: as_fconstant,
}

record Branch {
    target: Block,
}

record BranchCond {
    cond: Use,
    then_blk: Block,
    else_blk: Block,
}

record BranchTable {
    index: Use,
}

record Select {
    dst: Def,
    cond: Use,
    v1: Use,
    v2: Use,
}

record ICmp {
    dst: Def,
    lhs: Use,
    rhs: Use,
    cc: IntCC,
}
layout ICmp {
    accessor: as_icmp,
}

record FCmp {
    dst: Def,
    lhs: Use,
    rhs: Use,
    cc: FloatCC,
}
layout FCmp {
    accessor: as_fcmp,
}

record Arg {
    dst: Def,
    index: Index,
}

record Return {
    values: Uses,
}
layout Return {
    view: RetInst,
    accessor: as_ret,
}

record Unreachable {

}

record Call {
    shape: CallShape,
}
layout Call {
    view: CallShapeInst,
    accessor: as_call_shape_data,
}

// Logical signatures use the same operation model and type checker as every IR.

op G_ADD<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.add(lhs, rhs)
}

op G_SUB<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.sub(lhs, rhs)
}

op G_MUL<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.mul(lhs, rhs)
}

op G_SDIV<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg,
}

op G_UDIV<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg,
}

op G_SREM<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg,
}

op G_UREM<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg,
}

op G_NEG<T: Integer>(src: T) -> T {
    meta: OpInfo {},
    storage: UnaryReg,
    semantics: bv.neg(src)
}

op G_FADD<T: Float>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_FSUB<T: Float>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_FMUL<T: Float>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_FDIV<T: Float>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_FNEG<T: Float>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_FABS<T: Float>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_FSQRT<T: Float>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_AND<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.and(lhs, rhs)
}

op G_OR<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.or(lhs, rhs)
}

op G_XOR<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    storage: BinaryReg,
    semantics: bv.xor(lhs, rhs)
}

op G_CTPOP<T: Integer>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_CTLZ<T: Integer>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_CTTZ<T: Integer>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_SHL<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_LSHR<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_ASHR<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_ROTL<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_ROTR<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_ICMP<T: ScalarInteger | PTR>(lhs: T, rhs: T, @cc: IntCC) -> BOOL {
    meta: OpInfo { memory: Known([]) },
    storage: ICmp,
}

op G_FCMP<T: ScalarFloat>(lhs: T, rhs: T, @cc: FloatCC) -> BOOL {
    meta: OpInfo { memory: Known([]) },
    storage: FCmp,
}

op G_IEQZ(src: Integer) -> BOOL {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_ANYEXT(src: Integer) -> Integer {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_ABS<T: Integer>(src: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg,
}

op G_SMIN<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg,
}

op G_SMAX<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: Known([]) },
