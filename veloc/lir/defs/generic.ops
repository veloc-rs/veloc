op G_ICMP<T: ScalarInteger | Type::PTR>(lhs: T, rhs: T, cc: IntCC) -> (dst: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: ICmp { dst, lhs, rhs, cc },
}

op G_FCMP<T: ScalarFloat>(lhs: T, rhs: T, cc: FloatCC) -> (dst: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: FCmp { dst, lhs, rhs, cc },
}

op G_IEQZ(src: Integer) -> (dst: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_ANYEXT(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_ABS<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_SMIN<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SMAX<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UMIN<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UMAX<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UADDO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SADDO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_USUBO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SSUBO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_UADDE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: Type::BOOL) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_SADDE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: Type::BOOL) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_USUBE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: Type::BOOL) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_SSUBE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: Type::BOOL) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_UMULO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SMULO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_UMULH<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SMULH<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_CTLZ_ZERO_UNDEF<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_CTTZ_ZERO_UNDEF<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: UnaryReg { dst, src },
}

op G_SADDSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UADDSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: BinaryReg { dst, lhs, rhs },
