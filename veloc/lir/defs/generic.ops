import "../../defs/prelude.ops";

// Operand-array storage is independent of operation semantics and type contracts.
type StackSlot = rust("crate::StackSlot");
type Block = rust("veloc_mir::Block");

storage Operands { prefix: "G_" }

struct UnaryReg {
    dst: Def,
    src: Use,
}

struct BinaryReg {
    dst: Def,
    lhs: Use,
    rhs: Use,
}

struct BinaryRegWithFlags {
    dst: Def,
    flag: Def,
    lhs: Use,
    rhs: Use,
    carry_in: OptionalUse,
}

struct Load {
    dst: Def,
    base: Use,
}

struct LoadOffset {
    dst: Def,
    base: Use,
    offset: Imm,
}

struct IndexedLoad {
    dst: Def,
    wb_dst: TiedDefUse,
    base: Use,
    offset: Imm,
}

struct Store {
    src: Use,
    base: Use,
}

struct StackLoad {
    dst: Def,
    slot: StackSlot,
}

struct StackAddr {
    dst: Def,
    slot: StackSlot,
}

struct StackStore {
    src: Use,
    slot: StackSlot,
}

struct StoreOffset {
    src: Use,
    base: Use,
    offset: Imm,
}

struct IndexedStore {
    wb_dst: TiedDefUse,
    src: Use,
    base: Use,
    offset: Imm,
}

struct Constant {
    dst: Def,
    imm: Imm,
}

struct FloatConstant {
    dst: Def,
    imm: FImm,
}

struct Branch {
    target: Block,
}

struct BranchCond {
    cond: Use,
    then_blk: Block,
    else_blk: Block,
}

struct BranchTable {
    index: Use,
}

struct Select {
    dst: Def,
    cond: Use,
    v1: Use,
    v2: Use,
}

struct ICmp {
    dst: Def,
    lhs: Use,
    rhs: Use,
    cc: IntCC,
}

struct FCmp {
    dst: Def,
    lhs: Use,
    rhs: Use,
    cc: FloatCC,
}

struct Arg {
    dst: Def,
    index: Index,
}

struct Return {
    values: Uses,
}

struct Unreachable {

}

struct Call {
    shape: CallShape,
}

// Logical signatures use the same operation model and type checker as every IR.

op G_ADD<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.add(lhs, rhs)
}

op G_SUB<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.sub(lhs, rhs)
}

op G_MUL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.mul(lhs, rhs)
}

op G_SDIV<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UDIV<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SREM<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UREM<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_NEG<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo {},
    storage: UnaryReg { dst, src },
    semantics: bv.neg(src)
}

op G_FADD<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FSUB<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FMUL<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FDIV<T: Float>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_FNEG<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FABS<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FSQRT<T: Float>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_AND<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.and(lhs, rhs)
}

op G_OR<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.or(lhs, rhs)
}

op G_XOR<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo {},
    storage: BinaryReg { dst, lhs, rhs },
    semantics: bv.xor(lhs, rhs)
}

op G_CTPOP<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_CTLZ<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_CTTZ<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_SHL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_LSHR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ASHR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ROTL<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ROTR<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_ICMP<T: ScalarInteger | PTR>(lhs: T, rhs: T, cc: IntCC) -> (dst: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: ICmp { dst, lhs, rhs, cc },
}

op G_FCMP<T: ScalarFloat>(lhs: T, rhs: T, cc: FloatCC) -> (dst: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: FCmp { dst, lhs, rhs, cc },
}

op G_IEQZ(src: Integer) -> (dst: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_ANYEXT(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_ABS<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_SMIN<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SMAX<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UMIN<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UMAX<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UADDO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SADDO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_USUBO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SSUBO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_UADDE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: BOOL) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_SADDE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: BOOL) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_USUBE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: BOOL) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_SSUBE<T: ScalarInteger>(lhs: T, rhs: T, carry_in: BOOL) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: some(carry_in) },
}

op G_UMULO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_SMULO<T: ScalarInteger>(lhs: T, rhs: T) -> (dst: T, flag: BOOL) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryRegWithFlags { dst, flag, lhs, rhs, carry_in: none },
}

op G_UMULH<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SMULH<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_CTLZ_ZERO_UNDEF<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_CTTZ_ZERO_UNDEF<T: Integer>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_SADDSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_UADDSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_SSUBSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_USUBSAT<T: Integer>(lhs: T, rhs: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_LOAD(base: PTR) -> (dst: Any) {
    meta: OpInfo { memory: Unknown },
    storage: Load { dst, base },
}

op G_STORE(src: Any, base: PTR) -> () {
    meta: OpInfo { memory: Unknown },
    storage: Store { src, base },
}

op G_PTR_ADD(lhs: PTR, rhs: ScalarInteger) -> (dst: PTR) {
    meta: OpInfo { memory: Known([]) },
    storage: BinaryReg { dst, lhs, rhs },
}

op G_STACK_LOAD(slot: StackSlot) -> (dst: Any) {
    meta: OpInfo { memory: Known([READ]) },
    storage: StackLoad { dst, slot },
}

op G_STACK_STORE(src: Any, slot: StackSlot) -> () {
    meta: OpInfo { memory: Known([WRITE]) },
    storage: StackStore { src, slot },
}

op G_STACK_ADDR(slot: StackSlot) -> (dst: PTR) {
    meta: OpInfo { memory: Known([]) },
    storage: StackAddr { dst, slot },
}

op G_OFFSET_LOAD(base: PTR, offset: i64) -> (dst: Any) {
    meta: OpInfo { memory: Unknown },
    storage: LoadOffset { dst, base, offset },
}

op G_OFFSET_STORE(src: Any, base: PTR, offset: i64) -> () {
    meta: OpInfo { memory: Unknown },
    storage: StoreOffset { src, base, offset },
}

op G_INDEXED_LOAD(wb_dst: PTR, base: PTR, offset: i64) -> (dst: Any, out_wb_dst: PTR) {
    meta: OpInfo { memory: Unknown },
    storage: IndexedLoad { dst, wb_dst: tied(wb_dst, out_wb_dst), base, offset },
}

op G_INDEXED_STORE(wb_dst: PTR, src: Any, base: PTR, offset: i64) -> (out_wb_dst: PTR) {
    meta: OpInfo { memory: Unknown },
    storage: IndexedStore { wb_dst: tied(wb_dst, out_wb_dst), src, base, offset },
}

op G_CONSTANT(imm: i64) -> (dst: ScalarInteger | BOOL | PTR) {
    meta: OpInfo { memory: Known([]) },
    storage: Constant { dst, imm },
}

op G_FCONSTANT(imm: f64) -> (dst: ScalarFloat) {
    meta: OpInfo { memory: Known([]) },
    storage: FloatConstant { dst, imm },
}

op G_TRUNC(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_ZEXT(src: Integer | BOOL | vectors(BOOL)) -> (dst: Integer) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_SEXT(src: Integer) -> (dst: Integer) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FPTOSI(src: Float) -> (dst: Integer) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FPTOUI(src: Float) -> (dst: Integer) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_SITOFP(src: Integer) -> (dst: Float) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_UITOFP(src: Integer) -> (dst: Float) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FPTRUNC(src: Float) -> (dst: Float) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_FPEXT(src: Float) -> (dst: Float) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_BITCAST(src: Any) -> (dst: Any) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_INTTOPTR(src: ScalarInteger) -> (dst: PTR) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_PTRTOINT(src: PTR) -> (dst: ScalarInteger) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_BR(target: Block) -> () {
    meta: OpInfo { memory: Known([]) },
    storage: Branch { target },
    flow: Jump,
}

op G_BRCOND(cond: BOOL, then_blk: Block, else_blk: Block) -> () {
    meta: OpInfo { memory: Known([]) },
    storage: BranchCond { cond, then_blk, else_blk },
    flow: Jump,
}

op G_BRJT(index: ScalarInteger) -> () {
    meta: OpInfo { memory: Known([]) },
    storage: BranchTable { index },
    flow: Jump,
}

op G_RET(values: values) -> () {
    meta: OpInfo { memory: Known([]) },
    storage: Return { values },
    flow: Return,
}

op G_CALL(callee: SymbolId, args: values) -> signature {
    meta: OpInfo { memory: Unknown },
    storage: Call { shape: call(callee, args) },
    flow: Call,
}

op G_CALLIND(callee: PTR, args: values) -> signature {
    meta: OpInfo { memory: Unknown },
    storage: Call { shape: call(callee, args) },
    flow: Call,
}

op G_ARG(index: i64) -> (dst: Any) {
    meta: OpInfo { memory: Known([]) },
    storage: Arg { dst, index },
}

op G_SELECT<T: Any>(cond: BOOL, v1: T, v2: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: Select { dst, cond, v1, v2 },
}

op G_COPY<T: Any>(src: T) -> (dst: T) {
    meta: OpInfo { memory: Known([]) },
    storage: UnaryReg { dst, src },
}

op G_UNREACHABLE() -> () {
    meta: OpInfo { memory: Known([]) },
    storage: Unreachable {},
    flow: Trap,
}
