// Declaration order determines display order; bit positions remain explicit and stable.
// Semantic laws and control-flow behavior are implemented by trusted Rust consumers.
encoding MemFlags {
    storage: u16,
    fields: [alignment_log2(4), volatile(1)]
}

flags OpTraits {
    storage: u16,
    members: [TERMINATOR(0), COMMUTATIVE(1), ASSOCIATIVE(3), IDEMPOTENT(4), MAY_TRAP(2), ABORT(5)],
    separator: ", "
}

flags MemoryRegions {
    storage: u8,
    members: [MEMORY(0), EXTERNAL(1)],
    separator: ","
}

effect NONE { reads: [], writes: [] }
effect UNKNOWN { reads: [ALL], writes: [ALL], allocates: true, frees: true }

// All pointer-addressable storage shares one resource; alias analysis refines it.
effect READ { reads: [MEMORY], writes: [] }
effect WRITE { reads: [], writes: [MEMORY] }
effect ALLOCATE { reads: [], writes: [], allocates: true }
