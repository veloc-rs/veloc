import "types.ops";

// Rust-owned data types used by operation properties and host interfaces.
type Int = rust("crate::Int") {
    fn ty(self) -> Type { value: type(self) }
}
type Float = rust("crate::Float") {
    fn ty(self) -> Type { value: type(self) }
}
type VectorConst = rust("crate::VectorConst") {
    fn ty(self) -> Type { value: type(self) }
}
type FuncId = rust("crate::FuncId");
type SigId = rust("crate::SigId");
type Intrinsic = rust("crate::Intrinsic");
type ConstantPoolId = rust("crate::inst::ConstantPoolId");
type SymbolId = rust("crate::SymbolId");

// Declaration order determines display order; bit positions remain explicit and stable.
// Semantic laws and control-flow behavior are implemented by trusted Rust consumers.
encoding MemFlags {
    storage: u16,
    fields: [alignment_log2(4), volatile(1)]
}

flags OpTraits {
    storage: u16,
    members: [TERMINATOR(0), COMMUTATIVE(1), ASSOCIATIVE(3), IDEMPOTENT(4), MAY_TRAP(2), ABORT(5)],
    separator: ", "
}

// Known memory behaviors. Unknown information is not a member of this set.
flags MemoryEffects {
    storage: u8,
    members: [READ(0), WRITE(1), ALLOCATE(2), FREE(3)],
    separator: ", "
}


// Ordinary data declarations, usable in metadata or instruction properties.
enum MemoryEffect {
    variants: [Known(MemoryEffects), Unknown]
}
struct OpInfo {
    traits: OpTraits,
    memory: MemoryEffect,
}

// Reusable checked arithmetic, not a special verifier query.
fn is_power_of_two(value: u32) -> bool {
    value: value != 0 && (value & (value - 1)) == 0,
}

// Read-only host capabilities. Calls are qualified by interface name.
extern interface Constants {
    fn is_dense(value: VectorConst) -> bool;
    fn bytes(value: VectorConst) -> optional(sequence(u8));
}

extern interface Types {
    fn signature(ty: Type) -> optional(SigId);
}

extern interface Module {
    fn signature(func: FuncId) -> optional(SigId);
    fn current_signature() -> SigId;
    fn params(sig: SigId) -> optional(sequence(Type));
    fn returns(sig: SigId) -> optional(sequence(Type));
}
