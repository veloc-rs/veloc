// Rust representation and method interface are declared together.
// Methods without bodies bind same-named Rust methods; defs bodies expand normally.
type Type = rust("crate::Type") {
    fn element_bits(self) -> optional(u32);
    fn bit_size(self) -> optional(TypeBits);
    fn min_size_bytes(self) -> optional(u32);
    fn lanes(self) -> optional(u32);
    fn shape(self) -> optional(Shape);
    fn is_fixed(self) -> bool;
    fn is_scalar(self) -> bool;
    fn is_vector(self) -> bool;
    fn is_ptr(self) -> bool;
    fn is_predicate(self) -> bool;
    fn is_callable(self) -> bool;
    fn is_owned(self) -> bool;
    fn is_local(self) -> bool;
    fn is_shared(self) -> bool;
    fn is_compact(self) -> bool;

    fn same_shape(self, other: Type) -> bool {
        value: (self.is_scalar() && other.is_scalar())
            || (self.is_vector() && other.is_vector() && self.shape()? == other.shape()?)
    }

    fn wider_than(self, other: Type) -> bool {
        value: self.element_bits()? > other.element_bits()?
    }
}
type TypeBits = rust("crate::TypeBits");
type Shape = rust("veloc_types::Shape");
type Value = rust("crate::Value");

// The compact scalar/vector payload of Type, packed least significant bit first.
// Structural callable types use a disjoint tag and module signature ID;
// they never pass through this u16 bytecode encoding. Scalar code zero is invalid.
encoding Type {
    storage: u16,
    fields: [scalar(4), lanes_log2(4), scalable(1)],
    codes: [I8(1), I16(2), I32(3), I64(4), F32(5), F64(6), BOOL(7), PTR(8)]
}

// Type meanings are independent of their scalar codes above.
// Pointer width is supplied by the target.
type I8 = int(8);
type I16 = int(16);
type I32 = int(32);
type I64 = int(64);
type F32 = float(32);
type F64 = float(64);
type BOOL = bool();
type PTR = ptr();

// Named conveniences, not an exhaustive list of legal vector types.
type I32X4 = vector(I32, 4);
type I64X2 = vector(I64, 2);
type F32X4 = vector(F32, 4);
type F64X2 = vector(F64, 2);
type I8X16 = vector(I8, 16);
type I16X8 = vector(I16, 8);

// Members are exact types, other classes, or vectors(set). The latter includes
// every legal fixed and scalable shape over a set of non-pointer scalar types.
class Any { members: [Scalar, PTR, Vector] }
class Scalar { members: [ScalarInteger, ScalarFloat, BOOL] }
class ScalarInteger { members: [I8, I16, I32, I64] }
class ScalarFloat { members: [F32, F64] }
class Integer { members: [ScalarInteger, vectors(ScalarInteger)] }
class Float { members: [ScalarFloat, vectors(ScalarFloat)] }
class Number { members: [Integer, Float] }
class Vector { members: [vectors(Scalar)] }

// Public Type predicates. Unlike the Scalar class, is_scalar includes pointers.
// These are evaluated as exact type sets, not executable Rust expressions.
predicate is_scalar = Scalar | PTR;
predicate is_vector = Vector;
predicate is_integer = Integer;
predicate is_float = Float;
predicate is_ptr = PTR;
predicate is_predicate = vectors(BOOL);
