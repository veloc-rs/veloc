// Rust representation and method interface are declared together.
// Methods without bodies bind same-named Rust methods; defs bodies expand normally.
type Type = rust("crate::Type") {
    fn element_bits(self) -> optional(u32);
    fn bit_size(self) -> optional(TypeBits);
    fn min_size_bytes(self) -> optional(u32);
    fn lanes(self) -> optional(u32);
    fn shape(self) -> optional(Shape);
    fn is_fixed(self) -> bool;
    fn is_scalar(self) -> bool;
    fn is_vector(self) -> bool;
    fn is_ptr(self) -> bool;
    fn is_predicate(self) -> bool;
    fn is_callable(self) -> bool;
    fn is_owned(self) -> bool;
    fn is_local(self) -> bool;
    fn is_shared(self) -> bool;
    fn is_compact(self) -> bool;

    fn same_shape(self, other: Type) -> bool {
        value: (self.is_scalar() && other.is_scalar())
            || (self.is_vector() && other.is_vector() && self.shape()? == other.shape()?)
    }

    fn wider_than(self, other: Type) -> bool {
        value: self.element_bits()? > other.element_bits()?
    }
}
type TypeBits = rust("crate::TypeBits");
type Shape = rust("veloc_types::Shape");
type Value = rust("crate::Value") {
    field: operand,
    // Fundamental SSA type query; callers use the declared method.
    fn ty(self) -> Type { value: type(self) }
}

// Operand groups retain only lengths and control-flow metadata in instruction fields.
type ValueList = rust("crate::inst::Arguments") {
    field: list(Value),
}
type BlockCall = rust("crate::inst::Successor") {
    field: edge(Value),
}
type JumpTable = rust("crate::inst::Successors") {
    field: list(BlockCall),
}

// Scalar and named vector constants come from the shared Rust Type catalog.
// Members are exact types, other sets, or vectors(set). The latter includes
// every legal fixed and scalable shape over a set of non-pointer scalar types.
typeset Any = Scalar | Type.PTR | Vector;
typeset Scalar = ScalarInteger | ScalarFloat | Type.BOOL;
typeset ScalarInteger = Type.I8 | Type.I16 | Type.I32 | Type.I64;
typeset ScalarFloat = Type.F32 | Type.F64;
typeset Integer = ScalarInteger | vectors(ScalarInteger);
typeset Float = ScalarFloat | vectors(ScalarFloat);
typeset Number = Integer | Float;
typeset Vector = vectors(Scalar);
