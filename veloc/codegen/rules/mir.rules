// Exact pure-primitive matches (IAdd, ISub, IMul, bitwise ops) are inferred
// from OpSpec semantics and checked through the same rule compiler.
// These explicit rules are reviewed contracts, not SMT-proven equalities.
// Division/trap, masked shift and floating-point behavior remain obligations
// of LIR legalization and target selection.
rule INeg {
    match: mir.INeg(x),
    emit: lir.Neg(x),
}

rule IDivS {
    match: mir.IDivS(x, y),
    emit: lir.Sdiv(x, y),
}

rule IDivU {
    match: mir.IDivU(x, y),
    emit: lir.Udiv(x, y),
}

rule IRemS {
    match: mir.IRemS(x, y),
    emit: lir.Srem(x, y),
}

rule IRemU {
    match: mir.IRemU(x, y),
    emit: lir.Urem(x, y),
}

rule IRotl {
    match: mir.IRotl(x, y),
    emit: lir.Rotl(x, y),
}

rule IRotr {
    match: mir.IRotr(x, y),
    emit: lir.Rotr(x, y),
}

rule IShl {
    match: mir.IShl(x, y),
    emit: lir.Shl(x, y),
}

rule IShrS {
    match: mir.IShrS(x, y),
    emit: lir.Ashr(x, y),
}

rule IShrU {
    match: mir.IShrU(x, y),
    emit: lir.Lshr(x, y),
}

rule FAdd {
    match: mir.FAdd(x, y),
    emit: lir.Fadd(x, y),
}

rule FSub {
    match: mir.FSub(x, y),
    emit: lir.Fsub(x, y),
}

rule FMul {
    match: mir.FMul(x, y),
    emit: lir.Fmul(x, y),
}

rule FDiv {
    match: mir.FDiv(x, y),
    emit: lir.Fdiv(x, y),
}

rule IClz {
    match: mir.IClz(x),
    emit: lir.Ctlz(x),
}

rule ICtz {
    match: mir.ICtz(x),
    emit: lir.Cttz(x),
}

rule IPopcnt {
    match: mir.IPopcnt(x),
    emit: lir.Ctpop(x),
}

rule FAbs {
    match: mir.FAbs(x),
    emit: lir.Fabs(x),
}

rule FSqrt {
    match: mir.FSqrt(x),
    emit: lir.Fsqrt(x),
}

rule FNeg {
    match: mir.FNeg(x),
    emit: lir.Fneg(x),
}

rule IEqz {
    match: mir.IEqz(x),
    emit: lir.Ieqz(x),
}

rule Wrap {
    match: mir.Wrap(x),
    emit: lir.Trunc(x),
}

rule ExtendU {
    match: mir.ExtendU(x),
    emit: lir.Zext(x),
}

rule ExtendS {
    match: mir.ExtendS(x),
    emit: lir.Sext(x),
}

rule FloatDemote {
    match: mir.FloatDemote(x),
    emit: lir.Fptrunc(x),
}

rule FloatPromote {
    match: mir.FloatPromote(x),
    emit: lir.Fpext(x),
}

rule FloatToIntU {
    match: mir.FloatToIntU(x),
    emit: lir.Fptoui(x),
}

rule FloatToIntS {
    match: mir.FloatToIntS(x),
    emit: lir.Fptosi(x),
}

rule IntToFloatU {
    match: mir.IntToFloatU(x),
    emit: lir.Uitofp(x),
}

rule IntToFloatS {
    match: mir.IntToFloatS(x),
    emit: lir.Sitofp(x),
}

rule Reinterpret {
    match: mir.Reinterpret(x),
    emit: lir.Bitcast(x),
}

rule IntToPtr {
    match: mir.IntToPtr(x),
    emit: lir.Inttoptr(x),
}

rule PtrToInt {
    match: mir.PtrToInt(x),
    emit: lir.Ptrtoint(x),
}

rule Select {
    match: mir.Select(x, y, z),
    emit: lir.Select(x, y, z),
}
