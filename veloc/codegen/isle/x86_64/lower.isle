;; 比较/条件化选择
for (cmp, src_ty, cc, setcc) in
  X86Cmp32, GPR32Like, E, X86Sete
  X86Cmp32, GPR32Like, NE, X86Setne
  X86Cmp32, GPR32Like, L, X86Setl
  X86Cmp32, GPR32Like, LE, X86Setle
  X86Cmp32, GPR32Like, G, X86Setg
  X86Cmp32, GPR32Like, GE, X86Setge
  X86Cmp32, GPR32Like, B, X86Setb
  X86Cmp32, GPR32Like, BE, X86Setbe
  X86Cmp32, GPR32Like, A, X86Seta
  X86Cmp32, GPR32Like, AE, X86Setae
  X86Cmp64, GPR64Like, E, X86Sete
  X86Cmp64, GPR64Like, NE, X86Setne
  X86Cmp64, GPR64Like, L, X86Setl
  X86Cmp64, GPR64Like, LE, X86Setle
  X86Cmp64, GPR64Like, G, X86Setg
  X86Cmp64, GPR64Like, GE, X86Setge
  X86Cmp64, GPR64Like, B, X86Setb
  X86Cmp64, GPR64Like, BE, X86Setbe
  X86Cmp64, GPR64Like, A, X86Seta
  X86Cmp64, GPR64Like, AE, X86Setae
do
(select-rule
    (match (schema ICmp Icmp (dst (BOOL $dst)) (lhs ({{src_ty}} $x)) (rhs ({{src_ty}} $y)) (cc {{cc}}) @n))
    (temp $bit $dst)
    (emit (seq ({{cmp}} $x $y) ({{setcc}} $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end

for (cmp, src_ty, cc, setcc) in
  X86Ucomiss, FPR32, A, X86Seta
  X86Ucomiss, FPR32, AE, X86Setae
  X86Ucomisd, FPR64, A, X86Seta
  X86Ucomisd, FPR64, AE, X86Setae
do
(select-rule
    (match (schema FCmp Fcmp (dst (BOOL $dst)) (lhs ({{src_ty}} $x)) (rhs ({{src_ty}} $y)) (cc {{cc}}) @n))
    (temp $bit $dst)
    (emit (seq ({{cmp}} $x $y) ({{setcc}} $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end

for (test, src_ty) in
  X86Test32, GPR32Like
  X86Test64, GPR64Like
do
(select-rule
    (match (schema UnaryReg Ieqz (dst (BOOL $dst)) (src ({{src_ty}} $src)) @n))
    (temp $bit $dst)
    (emit (seq ({{test}} $src $src) (X86Sete $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end



;; 
(select-rule
    (match (schema Branch Br (target $block) @n))
    (emit (X86Jmp $block))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BranchCond Brcond (cond $cond) (then_blk $then) (else_blk $else) @n))
    (emit (seq (X86Test32 $cond $cond) (X86Jne $then) (X86Jmp $else)))
    (covers (@n))
    (cost 3))
(select-rule
    (match (schema Return Ret @n))
    (emit (X86Ret))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Unreachable Unreachable @n))
    (emit (X86Ud2))
    (covers (@n))
    (cost 1))

;; Division and Remainder (Lowering logic)
;; 指令融合路径：有符号/无符号的 div 与 rem 使用同一条底层除法序列。
(select-rule
    (match (schema BinaryReg Sdiv (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Cqo) (X86IDiv64 $rhs) (X86Mov64 $dst (reg RAX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg Sdiv (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Cdq) (X86IDiv32 $rhs) (X86Mov32 $dst (reg RAX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Srem (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Cqo) (X86IDiv64 $rhs) (X86Mov64 $dst (reg RDX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg Srem (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Cdq) (X86IDiv32 $rhs) (X86Mov32 $dst (reg RDX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Udiv (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Xor64 (reg RDX) (reg RDX) (reg RDX)) (X86Div64 $rhs) (X86Mov64 $dst (reg RAX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg Udiv (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Xor32 (reg RDX) (reg RDX) (reg RDX)) (X86Div32 $rhs) (X86Mov32 $dst (reg RAX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Urem (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Xor64 (reg RDX) (reg RDX) (reg RDX)) (X86Div64 $rhs) (X86Mov64 $dst (reg RDX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg Urem (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Xor32 (reg RDX) (reg RDX) (reg RDX)) (X86Div32 $rhs) (X86Mov32 $dst (reg RDX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fadd (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FAdd32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fadd (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FAdd64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fsub (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FSub32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fsub (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FSub64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fmul (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FMul32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fmul (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FMul64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fdiv (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FDiv32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg Fdiv (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FDiv64 $rhs $lhs))
    (covers (@n))
    (cost 1))
;; Symbolic frame address; the physical frame base is resolved during emission.
(select-rule
    (match (schema StackAddr StackAddr (dst (GPTR $dst)) (slot $slot) @n))
    (emit (X86LeaStack $dst $slot))
    (covers (@n))
    (cost 1))

;; Booleans have canonical 0/1 values in a zero-extended GPR.
(select-rule
    (match (schema Constant Constant (dst (BOOL $dst)) (imm $imm) @n))
    (emit (X86Mov32Imm $imm))
    (covers (@n))
    (cost 1))
for (ty) in
  GPR32
  GPR64
do
(select-rule
    (match (schema UnaryReg Zext (dst ({{ty}} $dst)) (src (BOOL $src)) @n))
    (emit (X86Movzx8to32 $dst $src))
    (covers (@n))
    (cost 1))
end

for (op, ty, native) in
    Rotl, GPR32, X86Rol32Cl
    Rotl, GPR64, X86Rol64Cl
    Rotr, GPR32, X86Ror32Cl
    Rotr, GPR64, X86Ror64Cl
do
(select-rule
    (match (schema BinaryReg {{op}} (dst ({{ty}} $dst)) (lhs ({{ty}} $x)) (rhs $y) @n))
    (emit ({{native}} $y $x))
    (covers (@n))
    (cost 1))
end

for (op, native) in
    And, X86And32
    Or, X86Or32
    Xor, X86Xor32
do
(select-rule
    (match (schema BinaryReg {{op}} (dst (BOOL $dst)) (lhs (BOOL $x)) (rhs (BOOL $y)) @n))
    (emit ({{native}} $y $x))
    (covers (@n))
    (cost 1))
end

for (op, dst, src, native) in
    Sitofp, FPR32, GPR32, X86I32ToF32
    Sitofp, FPR32, GPR64, X86I64ToF32
    Sitofp, FPR64, GPR32, X86I32ToF64
    Sitofp, FPR64, GPR64, X86I64ToF64
    Fptosi, GPR32, FPR32, X86F32ToI32
    Fptosi, GPR64, FPR32, X86F32ToI64
    Fptosi, GPR32, FPR64, X86F64ToI32
    Fptosi, GPR64, FPR64, X86F64ToI64
    Fpext, FPR64, FPR32, X86F32ToF64
    Fptrunc, FPR32, FPR64, X86F64ToF32
    Fsqrt, FPR32, FPR32, X86SqrtF32
    Fsqrt, FPR64, FPR64, X86SqrtF64
do
(select-rule
    (match (schema UnaryReg {{op}} (dst ({{dst}} $dst)) (src ({{src}} $src)) @n))
    (emit ({{native}} $src))
    (covers (@n))
    (cost 4))
end

for (ty, native) in
    GPR32, X86Popcnt32
    GPR64, X86Popcnt64
do
(select-rule
    (match (schema UnaryReg Ctpop (dst ({{ty}} $dst)) (src ({{ty}} $src)) @n))
    (emit ({{native}} $src))
    (covers (@n))
    (cost 3))
end
