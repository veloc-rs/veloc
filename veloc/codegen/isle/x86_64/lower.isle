;; 比较/条件化选择
for (cmp, src_ty, cc, setcc) in
  X86Cmp32, GPR32Like, E, X86Sete
  X86Cmp32, GPR32Like, NE, X86Setne
  X86Cmp32, GPR32Like, L, X86Setl
  X86Cmp32, GPR32Like, LE, X86Setle
  X86Cmp32, GPR32Like, G, X86Setg
  X86Cmp32, GPR32Like, GE, X86Setge
  X86Cmp32, GPR32Like, B, X86Setb
  X86Cmp32, GPR32Like, BE, X86Setbe
  X86Cmp32, GPR32Like, A, X86Seta
  X86Cmp32, GPR32Like, AE, X86Setae
  X86Cmp64, GPR64Like, E, X86Sete
  X86Cmp64, GPR64Like, NE, X86Setne
  X86Cmp64, GPR64Like, L, X86Setl
  X86Cmp64, GPR64Like, LE, X86Setle
  X86Cmp64, GPR64Like, G, X86Setg
  X86Cmp64, GPR64Like, GE, X86Setge
  X86Cmp64, GPR64Like, B, X86Setb
  X86Cmp64, GPR64Like, BE, X86Setbe
  X86Cmp64, GPR64Like, A, X86Seta
  X86Cmp64, GPR64Like, AE, X86Setae
do
(select-rule
    (match (schema ICmp G_ICMP (dst (BOOL $dst)) (lhs ({{src_ty}} $x)) (rhs ({{src_ty}} $y)) (cc {{cc}}) @n))
    (temp $bit $dst)
    (emit (seq ({{cmp}} $x $y) ({{setcc}} $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end

for (cmp, src_ty, cc, setcc) in
  X86Ucomiss, FPR32, A, X86Seta
  X86Ucomiss, FPR32, AE, X86Setae
  X86Ucomisd, FPR64, A, X86Seta
  X86Ucomisd, FPR64, AE, X86Setae
do
(select-rule
    (match (schema FCmp G_FCMP (dst (BOOL $dst)) (lhs ({{src_ty}} $x)) (rhs ({{src_ty}} $y)) (cc {{cc}}) @n))
    (temp $bit $dst)
    (emit (seq ({{cmp}} $x $y) ({{setcc}} $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end

for (test, src_ty) in
  X86Test32, GPR32Like
  X86Test64, GPR64Like
do
(select-rule
    (match (schema UnaryReg G_IEQZ (dst (BOOL $dst)) (src ({{src_ty}} $src)) @n))
    (temp $bit $dst)
    (emit (seq ({{test}} $src $src) (X86Sete $bit) (X86Movzx8to32 $dst $bit)))
    (covers (@n))
    (cost 1))
end



;; 
(select-rule
    (match (schema Branch G_BR (target $block) @n))
    (emit (X86Jmp $block))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BranchCond G_BRCOND (cond $cond) (then_blk $then) (else_blk $else) @n))
    (emit (seq (X86Jcc $cond $then) (X86Jmp $else)))
    (covers (@n))
    (cost 2))
(select-rule
    (match (schema Return G_RET @n))
    (emit (X86Ret))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Unreachable G_UNREACHABLE @n))
    (emit (X86Ud2))
    (covers (@n))
    (cost 1))

;; Division and Remainder (Lowering logic)
;; 指令融合路径：有符号/无符号的 div 与 rem 使用同一条底层除法序列。
(select-rule
    (match (schema BinaryReg G_SDIV (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Cqo) (X86IDiv64 $rhs) (X86Mov64 $dst (reg RAX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SDIV (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Cdq) (X86IDiv32 $rhs) (X86Mov32 $dst (reg RAX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_SREM (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Cqo) (X86IDiv64 $rhs) (X86Mov64 $dst (reg RDX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SREM (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Cdq) (X86IDiv32 $rhs) (X86Mov32 $dst (reg RDX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_UDIV (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Xor64 (reg RDX) (reg RDX) (reg RDX)) (X86Div64 $rhs) (X86Mov64 $dst (reg RAX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_UDIV (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Xor32 (reg RDX) (reg RDX) (reg RDX)) (X86Div32 $rhs) (X86Mov32 $dst (reg RAX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_UREM (dst $dst) (lhs $lhs) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Mov64 (reg RAX) $lhs) (X86Xor64 (reg RDX) (reg RDX) (reg RDX)) (X86Div64 $rhs) (X86Mov64 $dst (reg RDX))))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_UREM (dst $dst) (lhs $lhs) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Mov32 (reg RAX) $lhs) (X86Xor32 (reg RDX) (reg RDX) (reg RDX)) (X86Div32 $rhs) (X86Mov32 $dst (reg RDX))))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FADD (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FAdd32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FADD (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FAdd64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FSUB (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FSub32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FSUB (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FSub64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FMUL (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FMul32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FMUL (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FMul64 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FDIV (dst (FPR32 $dst)) (lhs (FPR32 $lhs)) (rhs (FPR32 $rhs)) @n))
    (emit (X86FDiv32 $rhs $lhs))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_FDIV (dst (FPR64 $dst)) (lhs (FPR64 $lhs)) (rhs (FPR64 $rhs)) @n))
    (emit (X86FDiv64 $rhs $lhs))
    (covers (@n))
    (cost 1))
;; Symbolic frame address; the physical frame base is resolved during emission.
(select-rule
    (match (schema StackAddr G_STACK_ADDR (dst (GPTR $dst)) (slot $slot) @n))
    (emit (X86LeaStack $dst $slot))
    (covers (@n))
    (cost 1))

;; Booleans have canonical 0/1 values in a zero-extended GPR.
(select-rule
    (match (schema Constant G_CONSTANT (dst (BOOL $dst)) (imm $imm) @n))
    (emit (X86Mov32Imm $imm))
    (covers (@n))
    (cost 1))
for (ty) in
  GPR32
  GPR64
do
(select-rule
    (match (schema UnaryReg G_ZEXT (dst ({{ty}} $dst)) (src (BOOL $src)) @n))
    (emit (X86Movzx8to32 $dst $src))
    (covers (@n))
    (cost 1))
end

for (op, ty, native) in
    G_ROTL, GPR32, X86Rol32Cl
    G_ROTL, GPR64, X86Rol64Cl
    G_ROTR, GPR32, X86Ror32Cl
    G_ROTR, GPR64, X86Ror64Cl
do
(select-rule
    (match (schema BinaryReg {{op}} (dst ({{ty}} $dst)) (lhs ({{ty}} $x)) (rhs $y) @n))
    (emit ({{native}} $y $x))
    (covers (@n))
    (cost 1))
end

for (op, native) in
    G_AND, X86And32
    G_OR, X86Or32
    G_XOR, X86Xor32
do
(select-rule
    (match (schema BinaryReg {{op}} (dst (BOOL $dst)) (lhs (BOOL $x)) (rhs (BOOL $y)) @n))
    (emit ({{native}} $y $x))
    (covers (@n))
    (cost 1))
end

for (op, dst, src, native) in
    G_SITOFP, FPR32, GPR32, X86I32ToF32
    G_SITOFP, FPR32, GPR64, X86I64ToF32
    G_SITOFP, FPR64, GPR32, X86I32ToF64
    G_SITOFP, FPR64, GPR64, X86I64ToF64
    G_FPTOSI, GPR32, FPR32, X86F32ToI32
    G_FPTOSI, GPR64, FPR32, X86F32ToI64
    G_FPTOSI, GPR32, FPR64, X86F64ToI32
    G_FPTOSI, GPR64, FPR64, X86F64ToI64
    G_FPEXT, FPR64, FPR32, X86F32ToF64
    G_FPTRUNC, FPR32, FPR64, X86F64ToF32
    G_FSQRT, FPR32, FPR32, X86SqrtF32
    G_FSQRT, FPR64, FPR64, X86SqrtF64
do
(select-rule
    (match (schema UnaryReg {{op}} (dst ({{dst}} $dst)) (src ({{src}} $src)) @n))
    (emit ({{native}} $src))
    (covers (@n))
    (cost 4))
end
