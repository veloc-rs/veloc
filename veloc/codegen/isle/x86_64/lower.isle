    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Mov32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR32 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movzx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR32 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movzx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movzx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movzx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR32 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movsx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR32 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movsx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movsx8to64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movsx16to64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Movsxd32to64 $src))
    (covers (@n))
    (cost 1))

;; 调用
(select-rule
    (match (schema Call G_CALL (shape $target) @n))
    (emit (X86Call $target))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Call G_CALLIND (shape $target) @n))
    (emit (X86CallReg $target))
    (covers (@n))
    (cost 1))

;; 算术运算
(select-rule
    (match (schema BinaryReg G_ADD (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Add32 $y))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SUB (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Sub32 $y))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_ADD (dst (GPR64 $dst)) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Add64 $y))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SUB (dst (GPR64 $dst)) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Sub64 $y))
    (covers (@n))
    (cost 1))

;; 内存操作
(select-rule
    (match (schema Load G_LOAD (dst (GPR64 $dst)) (base (GPTR $base)) @n))
    (emit (X86Load64 $base 0))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Load G_LOAD (dst (GPR64 $dst)) (base (GPR64 $base)) @n))
    (emit (X86Load64 $base 0))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema LoadOffset G_OFFSET_LOAD (dst (GPR64 $dst)) (base (GPTR $base)) (offset $off) @n))
    (emit (X86Load64 $base $off))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema LoadOffset G_OFFSET_LOAD (dst (GPR64 $dst)) (base (GPR64 $base)) (offset $off) @n))
    (emit (X86Load64 $base $off))
    (covers (@n))
    (cost 1))

