;; =============================================================================
;; x86_64  (Instruction Selection)
;; =============================================================================

;; -----------------------------------------------------------------------------
;; 1. External Declarations
;; -----------------------------------------------------------------------------

(type vreg (primitive Reg))

(decl is_i8 (vreg))
(decl is_i16 (vreg))
(decl is_i32 (vreg))
(decl is_i64 (vreg))
(decl is_f32 (vreg))
(decl is_f64 (vreg))
(decl is_ptr (vreg))
(decl is_fpr (vreg))
(decl has_bmi2 ())
(decl has_avx2 ())
(decl is_int32like (vreg))
(decl is_64like (vreg))
(decl is_bool (vreg))

;; -----------------------------------------------------------------------------
;; 2.  (Extractors)
;; -----------------------------------------------------------------------------

(def-extractor (GPR8 $reg)
    (and (is_i8 $reg) (not (is_fpr $reg))))

(def-extractor (GPR16 $reg)
    (and (is_i16 $reg) (not (is_fpr $reg))))

(def-extractor (GPR32 $reg)
    (and (is_i32 $reg) (not (is_fpr $reg))))

(def-extractor (GPR64 $reg)
    (and (is_i64 $reg) (not (is_fpr $reg))))

(def-extractor (GPTR $reg)
    (and (is_ptr $reg) (not (is_fpr $reg))))

(def-extractor (FPR32 $reg)
    (and (is_f32 $reg) (is_fpr $reg)))

(def-extractor (FPR64 $reg)
    (and (is_f64 $reg) (is_fpr $reg)))

(def-extractor (G_CONSTANT $imm)
    (and (is_i32 $unused) (not (is_fpr $unused))))

(def-extractor (GPR32Like $reg)
    (and (is_int32like $reg) (not (is_fpr $reg))))

(def-extractor (GPR64Like $reg)
    (and (is_64like $reg) (not (is_fpr $reg))))

(def-extractor (BOOL $reg)
    (is_bool $reg))

;; -----------------------------------------------------------------------------
;; 3.  (Lowering Rules)
;; -----------------------------------------------------------------------------

;; 常量
(select-rule
    (match (schema Constant G_CONSTANT (dst (GPR32Like $unused)) (imm $imm) @n))
    (emit (X86Mov32Imm $imm))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Constant G_CONSTANT (dst (GPR64 $unused)) (imm $imm) @n))
    (emit (X86Mov64Imm64 $imm))
    (covers (@n))
    (cost 1))

;; 简单拷贝/位宽等价转换
(select-rule
    (match (schema UnaryReg G_COPY (dst (GPR32 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Mov32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (GPR64 $dst)) (src (GPR64 $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (GPTR $dst)) (src (GPTR $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (GPR64 $dst)) (src (GPTR $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (GPTR $dst)) (src (GPR64 $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (FPR32 $dst)) (src (FPR32 $src)) @n))
    (emit (X86Movss $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_COPY (dst (FPR64 $dst)) (src (FPR64 $src)) @n))
    (emit (X86Movsd $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_INTTOPTR (dst (GPTR $dst)) (src (GPR64 $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_PTRTOINT (dst (GPR64 $dst)) (src (GPTR $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPR32 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Mov32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPR64 $dst)) (src (GPR64 $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPTR $dst)) (src (GPTR $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPR64 $dst)) (src (GPTR $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPTR $dst)) (src (GPR64 $src)) @n))
    (emit (X86Mov64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (FPR32 $dst)) (src (FPR32 $src)) @n))
    (emit (X86Movss $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (FPR64 $dst)) (src (FPR64 $src)) @n))
    (emit (X86Movsd $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (FPR32 $dst)) (src (GPR32 $src)) @n))
    (emit (X86MovdToXmm $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPR32 $dst)) (src (FPR32 $src)) @n))
    (emit (X86MovdFromXmm $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (FPR64 $dst)) (src (GPR64 $src)) @n))
    (emit (X86MovqToXmm $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_BITCAST (dst (GPR64 $dst)) (src (FPR64 $src)) @n))
    (emit (X86MovqFromXmm $src))
    (covers (@n))
    (cost 1))

;; 指针运算
(select-rule
    (match (schema BinaryReg G_PTR_ADD (dst $dst) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Add64 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_PTR_ADD (dst (GPR64 $dst)) (lhs (GPTR $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Add64 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_PTR_ADD (dst (GPTR $dst)) (lhs (GPTR $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Add64 $y $x))
    (covers (@n))
    (cost 1))

;; 类型转换
(select-rule
    (match (schema UnaryReg G_TRUNC (dst $dst) (src $src) @n))
    (emit (X86Mov32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Mov32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR32 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movzx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR32 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movzx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movzx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_ZEXT (dst (GPR64 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movzx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR32 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movsx8to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR32 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movsx16to32 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR8 $src)) @n))
    (emit (X86Movsx8to64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR16 $src)) @n))
    (emit (X86Movsx16to64 $src))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema UnaryReg G_SEXT (dst (GPR64 $dst)) (src (GPR32 $src)) @n))
    (emit (X86Movsxd32to64 $src))
    (covers (@n))
    (cost 1))

;; 调用
(select-rule
    (match (schema Call G_CALL (callee $target) @n))
    (emit (X86Call $target))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema CallIndirect G_CALLIND (callee $target) @n))
    (emit (X86CallReg $target))
    (covers (@n))
    (cost 1))

;; 算术运算
(select-rule
    (match (schema BinaryReg G_ADD (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Add32 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SUB (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Sub32 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_ADD (dst (GPR64 $dst)) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Add64 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SUB (dst (GPR64 $dst)) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86Sub64 $y $x))
    (covers (@n))
    (cost 1))

;; 内存操作
(select-rule
    (match (schema Load G_LOAD (dst (GPR64 $dst)) (base (GPTR $base)) @n))
    (emit (X86Load64 $base 0))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Load G_LOAD (dst (GPR64 $dst)) (base (GPR64 $base)) @n))
    (emit (X86Load64 $base 0))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema LoadOffset G_OFFSET_LOAD (dst (GPR64 $dst)) (base (GPTR $base)) (offset $off) @n))
    (emit (X86Load64 $base $off))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema LoadOffset G_OFFSET_LOAD (dst (GPR64 $dst)) (base (GPR64 $base)) (offset $off) @n))
    (emit (X86Load64 $base $off))
    (covers (@n))
    (cost 1))

