;; StackSlot-backed ABI materialization
(select-rule
    (match (schema StackLoad StackLoad (dst (GPR64 $dst)) (slot $slot) @n))
    (emit (X86Load64Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (GPTR $dst)) (slot $slot) @n))
    (emit (X86Load64Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (GPR32 $dst)) (slot $slot) @n))
    (emit (X86Load32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (GPR16 $dst)) (slot $slot) @n))
    (emit (X86Load16U32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (GPR8 $dst)) (slot $slot) @n))
    (emit (X86Load8U32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (FPR32 $dst)) (slot $slot) @n))
    (emit (X86LoadF32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad StackLoad (dst (FPR64 $dst)) (slot $slot) @n))
    (emit (X86LoadF64Stack $dst $slot))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema StackStore StackStore (src (GPR64 $src)) (slot $slot) @n))
    (emit (X86Store64Stack $src $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackStore StackStore (src (GPTR $src)) (slot $slot) @n))
    (emit (X86Store64Stack $src $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackStore StackStore (src (GPR32 $src)) (slot $slot) @n))
    (emit (X86Store32Stack $src $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackStore StackStore (src (GPR16 $src)) (slot $slot) @n))
