;; 比较/条件化选择
for (cmp, src_ty, cc, setcc) in
  X86Cmp32, GPR32Like, E, X86Sete
  X86Cmp32, GPR32Like, NE, X86Setne
  X86Cmp32, GPR32Like, L, X86Setl
  X86Cmp32, GPR32Like, LE, X86Setle
  X86Cmp32, GPR32Like, G, X86Setg
  X86Cmp32, GPR32Like, GE, X86Setge
  X86Cmp32, GPR32Like, B, X86Setb
  X86Cmp32, GPR32Like, BE, X86Setbe
  X86Cmp32, GPR32Like, A, X86Seta
  X86Cmp32, GPR32Like, AE, X86Setae
  X86Cmp64, GPR64Like, E, X86Sete
  X86Cmp64, GPR64Like, NE, X86Setne
  X86Cmp64, GPR64Like, L, X86Setl
  X86Cmp64, GPR64Like, LE, X86Setle
  X86Cmp64, GPR64Like, G, X86Setg
  X86Cmp64, GPR64Like, GE, X86Setge
  X86Cmp64, GPR64Like, B, X86Setb
  X86Cmp64, GPR64Like, BE, X86Setbe
  X86Cmp64, GPR64Like, A, X86Seta
  X86Cmp64, GPR64Like, AE, X86Setae
do
(select-rule
    (match (schema ICmp G_ICMP (dst (BOOL $dst)) (lhs ({{src_ty}} $x)) (rhs ({{src_ty}} $y)) (cc {{cc}}) @n))
    (emit (seq ({{cmp}} $x $y) ({{setcc}} $dst) (X86Movzx8to32 $dst $dst)))
    (covers (@n))
    (cost 1))
end

for (test, src_ty) in
  X86Test32, GPR32Like
  X86Test64, GPR64Like
do
(select-rule
    (match (schema UnaryReg G_IEQZ (dst (BOOL $dst)) (src ({{src_ty}} $src)) @n))
    (emit (seq ({{test}} $src $src) (X86Sete $dst) (X86Movzx8to32 $dst $dst)))
    (covers (@n))
    (cost 1))
end

for (test, movimm, movop, xorop, subop, andop, ty) in
  X86Test32, X86Mov32Imm, X86Mov32, X86Xor32, X86Sub32, X86And32, BOOL
  X86Test32, X86Mov32Imm, X86Mov32, X86Xor32, X86Sub32, X86And32, GPR32Like
  X86Test64, X86Mov64Imm32, X86Mov64, X86Xor64, X86Sub64, X86And64, GPR64Like
do
(select-rule
    (match (schema Select G_SELECT (dst ({{ty}} $dst)) (cond (BOOL $cond)) (v1 ({{ty}} $v1)) (v2 ({{ty}} $v2)) @n))
    (emit (seq
        ({{test}} $cond $cond)
        (X86Setne $cond)
        (X86Movzx8to32 $cond $cond)
        ({{movop}} $dst $v2)
        ({{xorop}} $dst $v1)
        ({{movimm}} $v1 0)
        ({{subop}} $v1 $cond)
        ({{andop}} $dst $v1)
        ({{xorop}} $dst $v2)))
    (covers (@n))
    (cost 1))
end

;; 
(select-rule
    (match (schema Branch G_BR (target $block) @n))
    (emit (X86Jmp $block))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BranchCond G_BRCOND (cond $cond) (then_blk $then) (else_blk $else) @n))
    (emit (X86Jcc $cond $then))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Return G_RET @n))
    (emit (X86Ret))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema Unreachable G_UNREACHABLE @n))
    (emit (X86Ud2))
    (covers (@n))
    (cost 1))

;; Division and Remainder (Lowering logic)
;; 指令融合路径：有符号/无符号的 div 与 rem 使用同一条底层除法序列。
(select-rule
    (match (schema BinaryReg G_SDIV (dst $dst) (lhs (GPR64 $lhs)) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Cqo) (X86IDiv64 $rhs)))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SDIV (dst $dst) (lhs (GPR32 $lhs)) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Cdq) (X86IDiv32 $rhs)))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_SREM (dst $dst) (lhs (GPR64 $lhs)) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Cqo) (X86IDiv64 $rhs)))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_SREM (dst $dst) (lhs (GPR32 $lhs)) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Cdq) (X86IDiv32 $rhs)))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_UDIV (dst $dst) (lhs (GPR64 $lhs)) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Xor64 (reg RDX) (reg RDX)) (X86Div64 $rhs)))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_UDIV (dst $dst) (lhs (GPR32 $lhs)) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Xor32 (reg RDX) (reg RDX)) (X86Div32 $rhs)))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_UREM (dst $dst) (lhs (GPR64 $lhs)) (rhs (GPR64 $rhs)) @n))
    (emit (seq (X86Xor64 (reg RDX) (reg RDX)) (X86Div64 $rhs)))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_UREM (dst $dst) (lhs (GPR32 $lhs)) (rhs (GPR32 $rhs)) @n))
    (emit (seq (X86Xor32 (reg RDX) (reg RDX)) (X86Div32 $rhs)))
    (covers (@n))
    (cost 1))
