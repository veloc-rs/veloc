;; StackSlot-backed ABI materialization
(select-rule
    (match (schema StackLoad G_STACK_LOAD (dst (GPR64 $dst)) (slot $slot) @n))
    (emit (X86Load64Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad G_STACK_LOAD (dst (GPTR $dst)) (slot $slot) @n))
    (emit (X86Load64Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad G_STACK_LOAD (dst (GPR32 $dst)) (slot $slot) @n))
    (emit (X86Load32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad G_STACK_LOAD (dst (GPR16 $dst)) (slot $slot) @n))
    (emit (X86Load16U32Stack $dst $slot))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema StackLoad G_STACK_LOAD (dst (GPR8 $dst)) (slot $slot) @n))
