(select-rule
    (match (schema BinaryReg G_MUL (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86IMul32 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_AND (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86And32 $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_OR (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Or32  $y $x))
    (covers (@n))
    (cost 1))
(select-rule
    (match (schema BinaryReg G_XOR (dst (GPR32 $dst)) (lhs (GPR32 $x)) (rhs (GPR32 $y)) @n))
    (emit (X86Xor32 $y $x))
    (covers (@n))
    (cost 1))

(select-rule
    (match (schema BinaryReg G_MUL (dst (GPR64 $dst)) (lhs (GPR64 $x)) (rhs (GPR64 $y)) @n))
    (emit (X86IMul64 $y $x))
    (covers (@n))
