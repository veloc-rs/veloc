// Instruction-local legality and concrete rewrite plans. Order is priority.
type Type = rust("veloc_mir::Type") {
    const BOOL: Self;
    const I8: Self;
    const I16: Self;
    const I32: Self;
    const I64: Self;
    const F32: Self;
    const F64: Self;
    const PTR: Self;
}
type Action = rust("crate::passes::lowering::LegalizeAction");
type Query = rust("crate::passes::lowering::legalize::Query") {
    fn signature(&self, results: sequence(sequence(Type)), inputs: sequence(sequence(Type))) -> bool;
    fn same(&self, indices: sequence(u32)) -> bool;
    fn value_type(&self, result: bool, index: u32) -> Type;
    fn input_is(&self, index: u32, ty: Type) -> bool;
    fn signed_offset(&self, bits: u32) -> bool;
}
type Instruction = rust("crate::target::x86_64::isle::TargetInst") {
    const POPCNT32: Self;
    const POPCNT64: Self;
}
type Target = rust("crate::target::arch::CpuDescription") {
    fn supports(&self, instruction: Instruction) -> bool;
}
type Recipes = rust("crate::target::x86_64::lowering::legalize::X86_64Legalizer") {
    fn legal(&self) -> Action;
    fn unsigned(&self) -> Action;
    fn float_sign(&self) -> Action;
    fn displacement(&self) -> Action;
    fn bit_count(&self) -> Action;
    fn branch_table(&self) -> Action;
}

typeset Narrow = Type::I8 | Type::I16;
typeset Word = Type::I32 | Type::I64;
typeset Float = Type::F32 | Type::F64;
typeset Scalar = Type::BOOL | Type::I8 | Type::I16 | Type::I32 | Type::I64 | Type::F32 | Type::F64 | Type::PTR;
typeset IntOrPtr = Type::I8 | Type::I16 | Type::I32 | Type::I64 | Type::PTR;
typeset WordValue = Type::BOOL | Type::I32 | Type::I64 | Type::F32 | Type::F64 | Type::PTR;
typeset Number = Type::I32 | Type::I64 | Type::F32 | Type::F64;
typeset WordOrPtr = Type::I32 | Type::I64 | Type::PTR;
typeset SmallInt = Type::I8 | Type::I16 | Type::I32;

rule arg_0<T: Scalar>(inst: lir::Arg<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule ret_0(inst: lir::Ret, recipes: &Recipes) {
    action = recipes.legal();
}

rule unreachable_0(inst: lir::Unreachable, recipes: &Recipes) {
    action = recipes.legal();
}

rule br_0(inst: lir::Br, recipes: &Recipes) {
    action = recipes.legal();
}

rule brcond_0(inst: lir::Brcond, recipes: &Recipes) {
    action = recipes.legal();
}

rule call_0(inst: lir::Call, recipes: &Recipes) {
    action = recipes.legal();
}

rule callind_0(inst: lir::Callind, query: &Query, recipes: &Recipes) {
    when = query.input_is(0, Type::PTR);
    action = recipes.legal();
}

rule add_0<T: Word>(inst: lir::Add<T> | lir::Sub<T> | lir::Mul<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule widen_add<T: Narrow>(inst: lir::Add<T>) {
    replace = lir::Trunc<T>(lir::Add<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule widen_sub<T: Narrow>(inst: lir::Sub<T>) {
    replace = lir::Trunc<T>(lir::Sub<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule widen_mul<T: Narrow>(inst: lir::Mul<T>) {
    replace = lir::Trunc<T>(lir::Mul<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule and_0(inst: lir::And<Type::BOOL> | lir::Or<Type::BOOL> | lir::Xor<Type::BOOL>, recipes: &Recipes) {
    action = recipes.legal();
}

rule and_1<T: Word>(inst: lir::And<T> | lir::Or<T> | lir::Xor<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule widen_and<T: Narrow>(inst: lir::And<T>) {
    replace = lir::Trunc<T>(lir::And<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule widen_or<T: Narrow>(inst: lir::Or<T>) {
    replace = lir::Trunc<T>(lir::Or<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule widen_xor<T: Narrow>(inst: lir::Xor<T>) {
    replace = lir::Trunc<T>(lir::Xor<Type::I32>(lir::Zext<Type::I32>(inst.lhs), lir::Zext<Type::I32>(inst.rhs)));
}

rule shl_0<T: Word>(inst: lir::Shl<T> | lir::Lshr<T> | lir::Ashr<T> | lir::Rotl<T> | lir::Rotr<T> | lir::Sdiv<T> | lir::Udiv<T> | lir::Srem<T> | lir::Urem<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule icmp_0<T: WordOrPtr>(inst: lir::Icmp<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fcmp_0<T: Float>(inst: lir::Fcmp<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule select_0(inst: lir::Select<Type::BOOL>, recipes: &Recipes) {
    action = recipes.legal();
}

rule select_1<T: WordValue>(inst: lir::Select<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule load_0<T: Scalar>(inst: lir::Load<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule stackload_0<T: Scalar>(inst: lir::StackLoad<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule stackaddr_0(inst: lir::StackAddr, recipes: &Recipes) {
    action = recipes.legal();
}

rule stackstore_0<T: Scalar>(inst: lir::StackStore<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule store_0<T: Scalar>(inst: lir::Store<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule offsetload_0_large<T: Scalar>(inst: lir::OffsetLoad<T>, query: &Query, recipes: &Recipes) {
    when = !query.signed_offset(32);
    action = recipes.displacement();
}

rule offsetload_0<T: Scalar>(inst: lir::OffsetLoad<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule offsetstore_0_large<T: Scalar>(inst: lir::OffsetStore<T>, query: &Query, recipes: &Recipes) {
    when = !query.signed_offset(32);
    action = recipes.displacement();
}

rule offsetstore_0<T: Scalar>(inst: lir::OffsetStore<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule indexedload_0<T: Number>(inst: lir::IndexedLoad<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule indexedstore_0<T: Number>(inst: lir::IndexedStore<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule constant_0(inst: lir::Constant<Type::BOOL>, recipes: &Recipes) {
    action = recipes.legal();
}

rule constant_1<T: IntOrPtr>(inst: lir::Constant<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule ieqz_0<T: Word>(inst: lir::Ieqz<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fneg_0<T: Float>(inst: lir::Fneg<T> | lir::Fabs<T>, recipes: &Recipes) {
    action = recipes.float_sign();
}

rule sitofp_0<T: Float, U: Word>(inst: lir::Sitofp<T, U>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fptosi_0<T: Word, U: Float>(inst: lir::Fptosi<T, U>, recipes: &Recipes) {
    action = recipes.legal();
}

rule uitofp_0<T: Float, U: Word>(inst: lir::Uitofp<T, U>, recipes: &Recipes) {
    action = recipes.unsigned();
}

rule fptoui_0<T: Word, U: Float>(inst: lir::Fptoui<T, U>, recipes: &Recipes) {
    action = recipes.unsigned();
}

rule fsqrt_0<T: Float>(inst: lir::Fsqrt<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fpext_0(inst: lir::Fpext<Type::F64, Type::F32>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fptrunc_0(inst: lir::Fptrunc<Type::F32, Type::F64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule zext_0<T: Word>(inst: lir::Zext<T, Type::BOOL>, recipes: &Recipes) {
    action = recipes.legal();
}

rule zext_1<T: Word, U: Narrow>(inst: lir::Zext<T, U>, recipes: &Recipes) {
    action = recipes.legal();
}

rule zext_2(inst: lir::Zext<Type::I64, Type::I32>, recipes: &Recipes) {
    action = recipes.legal();
}

rule sext_0<T: Word, U: Narrow>(inst: lir::Sext<T, U>, recipes: &Recipes) {
    action = recipes.legal();
}

rule sext_1(inst: lir::Sext<Type::I64, Type::I32>, recipes: &Recipes) {
    action = recipes.legal();
}

rule trunc_0<T: SmallInt, U: Word>(inst: lir::Trunc<T, U>, recipes: &Recipes) {
    action = recipes.legal();
}

rule inttoptr_0(inst: lir::Inttoptr<Type::I64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule ptrtoint_0(inst: lir::Ptrtoint<Type::I64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule ptradd_0(inst: lir::PtrAdd<Type::I64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule copy_0<T: Scalar>(inst: lir::Copy<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule bitcast_0(inst: lir::Bitcast<Type::F32, Type::I32>, recipes: &Recipes) {
    action = recipes.legal();
}

rule bitcast_1(inst: lir::Bitcast<Type::I32, Type::F32>, recipes: &Recipes) {
    action = recipes.legal();
}

rule bitcast_2(inst: lir::Bitcast<Type::F64, Type::I64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule bitcast_3(inst: lir::Bitcast<Type::I64, Type::F64>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fconstant_0<T: Float>(inst: lir::Fconstant<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule fadd_0<T: Float>(inst: lir::Fadd<T> | lir::Fsub<T> | lir::Fmul<T> | lir::Fdiv<T>, recipes: &Recipes) {
    action = recipes.legal();
}

rule brjt_0(inst: lir::Brjt<Type::I32>, recipes: &Recipes) {
    action = recipes.branch_table();
}

// Native candidates and the software fallback belong to the same decision.
rule ctpop<T: Word>(inst: lir::Ctpop<T>, recipes: &Recipes, target: &Target) {
    action = match T {
        Type::I32 if target.supports(Instruction::POPCNT32) => recipes.legal(),
        Type::I64 if target.supports(Instruction::POPCNT64) => recipes.legal(),
        _ => recipes.bit_count(),
    };
}

rule count_zeros<T: Word>(inst: lir::Ctlz<T> | lir::Cttz<T>, recipes: &Recipes) {
    action = recipes.bit_count();
}
