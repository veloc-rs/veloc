op X86Mov32Imm(imm: i64) -> (dst: Value<Any>) {
    encoding = Emission::legacy(
        Legacy { prefix: Prefix::None, map: OpcodeMap::Primary, opcode: 0xB8, wide: false },
        Form::OpcodeReg(dst),
        Immediate::Bits32(imm),
    );
    registers = {
        dst: GPR64,
    };
    schedule = { latency: 1 };
}

op X86Mov64Imm32(imm: i64) -> (dst: Value<Any>) {
