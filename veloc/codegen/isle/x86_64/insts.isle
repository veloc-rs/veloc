(def-inst X86StoreF64Stack (template StoreF64Stackm))

;; 
(def-inst X86Call
    (operands (global $target))
    (encode
        (byte 0xE8)
        (rel32 $target)))
(def-inst X86CallReg
    (operands (use $target))
    (encode
        (byte (rex-w 0 (hw-enc $target)))
        (byte 0xFF)
        (byte (modrm-rr 2 (hw-enc $target)))))
(def-inst X86Ret
    (encode (byte 0xC3)))
(def-inst X86Ud2
    (encode
        (byte 0x0F)
        (byte 0x0B)))
(def-inst X86Jmp
    (operands (block $target))
    (encode
        (byte 0xE9)
        (rel32 $target)))

(def-inst X86Jcc
    (operands (use $cond) (block $target))
    (clobbers EFLAGS)
    (encode
        (if (needs-rex (hw-enc $cond) (hw-enc $cond))
            (byte (rex-rr (hw-enc $cond) (hw-enc $cond))))
        (byte 0x85)
        (byte (modrm-rr (hw-enc $cond) (hw-enc $cond)))
        (byte 0x0F)
        (byte 0x85)
        (rel32 $target)))
(def-inst X86Je
    (operands (block $target))
    (clobbers EFLAGS)
    (encode
        (byte 0x0F)
        (byte 0x84)
        (rel32 $target)))

;; -----------------------------------------------------------------------------
;; 5.  (Prologue/Epilogue Support)
;; -----------------------------------------------------------------------------

(def-inst X86PushRbp
    (operands (use $rbp))
    (encode (byte 0x55)))

(def-inst X86PopRbp
    (operands (def $rbp))
    (encode (byte 0x5D)))

(def-inst X86MovRbpRsp
    (operands (def $rbp) (use $rsp))
    (encode (byte 0x48) (byte 0x89) (byte 0xE5)))

;;  IDiv 
(def-inst X86IDiv32
    (operands (use $src))
    (implicit-uses EAX EDX)
    (implicit-defs EAX EDX)
    (clobbers EFLAGS)
    (encode
        (byte 0xf7)
        (byte (modrm-rr 7 (hw-enc $src)))))

(def-inst X86IDiv64
    (operands (use $src))
    (implicit-uses RAX RDX)
    (implicit-defs RAX RDX)
    (clobbers EFLAGS)
    (encode
        (byte 0x48)
        (byte 0xf7)
        (byte (modrm-rr 7 (hw-enc $src)))))

(def-inst X86Div32
    (operands (use $src))
    (implicit-uses EAX EDX)
    (implicit-defs EAX EDX)
    (clobbers EFLAGS)
    (encode
        (byte 0xf7)
        (byte (modrm-rr 6 (hw-enc $src)))))

(def-inst X86Div64
    (operands (use $src))
    (implicit-uses RAX RDX)
    (implicit-defs RAX RDX)
    (clobbers EFLAGS)
    (encode
        (byte 0x48)
        (byte 0xf7)
        (byte (modrm-rr 6 (hw-enc $src)))))

;; CQO: Convert Quadword to Octoword (RAX -> RDX:RAX)
;; 符号扩展 RAX 到 RDX:RAX
(def-inst X86Cqo
    (operands)
    (implicit-uses RAX)
    (implicit-defs RDX)
    (encode (byte 0x48) (byte 0x99))
)

;; CDQ: Convert Doubleword to Quadword (EAX -> EDX:EAX)
;; 符号扩展 EAX 到 EDX:EAX
(def-inst X86Cdq
    (operands)
    (implicit-uses EAX)
    (implicit-defs EDX)
    (encode (byte 0x99))
)
