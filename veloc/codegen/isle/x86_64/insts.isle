(def-inst X86Setne (template Setcc8r 0x95))
(def-inst X86Setb  (template Setcc8r 0x92))
(def-inst X86Seta  (template Setcc8r 0x97))
(def-inst X86Setbe (template Setcc8r 0x96))
(def-inst X86Setae (template Setcc8r 0x93))
