// Typed property contracts run during validation, not construction.
property VectorConst {
    constraints: [
        require(!is_dense(value) || is_fixed(type(value)), "dense vector constant requires a fixed type"),
        require(!is_dense(value) || len(bytes(value)) == min_bytes(type(value)), "dense vector constant byte count must match its type"),
        require(!is_dense(value) || !is_predicate(type(value)) || all(bytes(value), |byte| byte <= 1), "boolean constant lanes must be zero or one")
    ]
}

// Logical records. SSA fields are extracted into the instruction's operands.
record PtrIndexImm {
    offset: i32,
    scale: u32,
}
record VectorMemOptions {
    offset: i32,
    flags: MemFlags,
    scale: u8,
    mask: optional(Value),
    evl: optional(Value),
}
record VectorExtData {
    mask: Value,
    evl: optional(Value),
}

// Fields describe logical groups, not physical storage. All SSA inputs,
// including successor arguments and record inputs, occupy one operand range.
// values(N) is fixed-arity; ValueList is variadic.
// An op's storage mapping selects a record as an instruction layout.
// Opcode fields are inferred from its users, never part of the record itself.

record Unary {
    arg: Value,
}
record Binary {
    args: values(2),
}
record Ternary {
    args: values(3),
}
record Iconst {
    value: Int,
}
record Fconst {
    value: Float,
}
record Bconst {
    value: bool,
}
record Vconst {
    value: VectorConst,
}
record Load {
    ptr: Value,
    offset: u32,
    flags: MemFlags,
}
record Store {
    ptr: Value,
    value: Value,
    offset: u32,
    flags: MemFlags,
}
record Alloca {
    size: u32,
    align: u32,
}
record PtrOffset {
    ptr: Value,
    offset: i32,
}
record PtrIndex {
    ptr: Value,
    index: Value,
    imm_id: PtrIndexImm,
}
record IntToPtr {
    arg: Value,
}
record PtrToInt {
    arg: Value,
}
record Call {
    func_id: FuncId,
    args: ValueList,
}
record ClosureNew {
    func_id: FuncId,
    captures: ValueList,
    cleanup: FuncId,
}
record Closure {
    func_id: FuncId,
    captures: ValueList,
}
record TailCall {
    func_id: FuncId,
    args: ValueList,
}
record CallValue {
    callee: Value,
    args: ValueList,
}
record CallIndirect {
    ptr: Value,
    args: ValueList,
    sig_id: SigId,
}
record CallIntrinsic {
    intrinsic: Intrinsic,
    args: ValueList,
    sig_id: SigId,
}
record Jump {
    dest: BlockCall,
}
record Br {
    condition: Value,
    then_dest: BlockCall,
    else_dest: BlockCall,
}
record BrTable {
    index: Value,
    table: JumpTable,
}
record Return {
    values: ValueList,
}
record IntCompare {
    kind: IntCC,
    args: values(2),
}
record FloatCompare {
    kind: FloatCC,
    args: values(2),
}
record VectorLoadStrided {
    ptr: Value,
    stride: Value,
    ext: VectorMemOptions,
}
record VectorStoreStrided {
    args: values(3),
    ext: VectorMemOptions,
}
record VectorGather {
    ptr: Value,
    index: Value,
    ext: VectorMemOptions,
}
record VectorScatter {
    args: values(3),
    ext: VectorMemOptions,
}
record Shuffle {
    args: values(2),
    mask: ConstantPoolId,
}
record Unreachable {

}
record Nop {

}

// Predication adds auxiliary operands while keeping the operation's
// logical Unary/Binary/Ternary format and type rules.
record VectorOpWithExt {
    args: ValueList,
    ext: VectorExtData,
}
layout VectorOpWithExt {
    format: arity(args, [Unary, Binary, Ternary]),
    text: "{args}, mask={ext.mask}[, evl={ext.evl}]",
    constraints: [
        require(len(results()) == 1 && all(results(), |t| is_vector(t)), "predicated operation must produce a vector"),
        require(all(results(), |t| is_predicate(type(ext.mask)) && shape(type(ext.mask)) == shape(t)), "mask must match vector shape"),
        require(all(ext.evl, |v| type(v) == I32), "EVL must be i32")
    ],
}
