// Typed property contracts run during validation, not construction.
property VectorConst {
    constraints: [
        require(!is_dense(value) || is_fixed(type(value)), "dense vector constant requires a fixed type"),
        require(!is_dense(value) || len(bytes(value)) == min_bytes(type(value)), "dense vector constant byte count must match its type"),
        require(!is_dense(value) || !is_predicate(type(value)) || all(bytes(value), |byte| byte <= 1), "boolean constant lanes must be zero or one")
    ]
}

// Logical records. SSA fields are extracted into the instruction's operands.
record PtrIndexImm {
    fields: [offset(i32, 0), scale(u32, 1)]
}
record VectorMemOptions {
    fields: [
        offset(i32, 0), flags(MemFlags, empty), scale(u8, 1),
        mask(optional(Value), none), evl(optional(Value), none)
    ]
}
record VectorExtData {
    fields: [mask(Value), evl(optional(Value), none)]
}

// Fields describe logical groups, not physical storage. All SSA inputs,
// including successor arguments and record inputs, occupy one operand range.
// values(N) is fixed-arity; ValueList is variadic.

format Unary {
    fields: [opcode(Opcode), arg(Value)],
    opcode: dynamic(opcode)
}
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
format Ternary {
    fields: [opcode(Opcode), args(values(3))],
    opcode: dynamic(opcode)
}
format Iconst {
    fields: [value(Int)],
    opcode: fixed(Iconst)
}
format Fconst {
    fields: [value(Float)],
    opcode: fixed(Fconst)
}
format Bconst {
    fields: [value(bool)],
    opcode: fixed(Bconst)
}
format Vconst {
    fields: [value(VectorConst)],
    opcode: fixed(Vconst)
}
format Load {
    fields: [ptr(Value), offset(u32), flags(MemFlags)],
    opcode: fixed(Load)
}
format Store {
    fields: [ptr(Value), value(Value), offset(u32), flags(MemFlags)],
    opcode: fixed(Store)
}
format StackLoad {
    fields: [slot(StackSlot), offset(u32)],
    opcode: fixed(StackLoad)
}
format StackStore {
    fields: [slot(StackSlot), value(Value), offset(u32)],
    opcode: fixed(StackStore)
}
format StackAddr {
    fields: [slot(StackSlot), offset(u32)],
    opcode: fixed(StackAddr)
}
format PtrOffset {
    fields: [ptr(Value), offset(i32)],
    opcode: fixed(PtrOffset)
}
format PtrIndex {
    fields: [ptr(Value), index(Value), imm_id(PtrIndexImm)],
    opcode: fixed(PtrIndex)
}
format IntToPtr {
    fields: [arg(Value)],
    opcode: fixed(IntToPtr)
}
format PtrToInt {
    fields: [arg(Value)],
    opcode: fixed(PtrToInt)
}
format Call {
    fields: [func_id(FuncId), args(ValueList)],
    opcode: fixed(Call)
}
format ClosureNew {
    fields: [func_id(FuncId), captures(ValueList), cleanup(FuncId)],
    opcode: fixed(ClosureNew)
}
format Closure {
    fields: [opcode(Opcode), func_id(FuncId), captures(ValueList)],
    opcode: dynamic(opcode)
}
format TailCall {
    fields: [func_id(FuncId), args(ValueList)],
    opcode: fixed(TailCall)
}
format CallValue {
    fields: [opcode(Opcode), callee(Value), args(ValueList)],
    opcode: dynamic(opcode)
}
format CallIndirect {
    fields: [ptr(Value), args(ValueList), sig_id(SigId)],
    opcode: fixed(CallIndirect)
}
format CallIntrinsic {
    fields: [intrinsic(Intrinsic), args(ValueList), sig_id(SigId)],
    opcode: fixed(CallIntrinsic)
}
format Jump {
    fields: [dest(BlockCall)],
    opcode: fixed(Jump)
}
format Br {
    fields: [condition(Value), then_dest(BlockCall), else_dest(BlockCall)],
    opcode: fixed(Br)
}
format BrTable {
    fields: [index(Value), table(JumpTable)],
    opcode: fixed(BrTable)
}
format Return {
    fields: [values(ValueList)],
    opcode: fixed(Return)
}
format IntCompare {
    fields: [kind(IntCC), args(values(2))],
    opcode: fixed(Icmp)
}
format FloatCompare {
    fields: [kind(FloatCC), args(values(2))],
    opcode: fixed(Fcmp)
}
format VectorLoadStrided {
    fields: [ptr(Value), stride(Value), ext(VectorMemOptions)],
    opcode: fixed(LoadStride)
}
format VectorStoreStrided {
    fields: [args(values(3)), ext(VectorMemOptions)],
    opcode: fixed(StoreStride)
}
format VectorGather {
    fields: [ptr(Value), index(Value), ext(VectorMemOptions)],
    opcode: fixed(Gather)
}
format VectorScatter {
    fields: [args(values(3)), ext(VectorMemOptions)],
    opcode: fixed(Scatter)
}
format Shuffle {
    fields: [args(values(2)), mask(ConstantPoolId)],
    opcode: fixed(Shuffle)
}
format Unreachable {
    fields: [],
    opcode: fixed(Unreachable)
}
format Nop {
    fields: [],
    opcode: fixed(Nop)
}

// Predication adds auxiliary operands while keeping the operation's
// logical Unary/Binary/Ternary format and type rules.
layout VectorOpWithExt {
    fields: [opcode(Opcode), args(ValueList), ext(VectorExtData)],
    opcode: dynamic(opcode),
    format: arity(args, [Unary, Binary, Ternary]),
    text: "{args}, mask={ext.mask}[, evl={ext.evl}]",
    constraints: [
        require(len(results()) == 1 && all(results(), |t| is_vector(t)), "predicated operation must produce a vector"),
        require(all(results(), |t| is_predicate(type(ext.mask)) && shape(type(ext.mask)) == shape(t)), "mask must match vector shape"),
        require(all(ext.evl, |v| type(v) == I32), "EVL must be i32")
    ]
}
