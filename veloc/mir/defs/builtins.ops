// Declaration order determines display order; bit positions remain explicit and stable.
// Semantic laws and control-flow behavior are implemented by trusted Rust consumers.
trait TERMINATOR { bit: 0 }
trait COMMUTATIVE { bit: 1 }
trait ASSOCIATIVE { bit: 3 }
trait IDEMPOTENT { bit: 4 }
trait MAY_TRAP { bit: 2 }

region HEAP { bit: 0 }
region STACK { bit: 1 }
region GLOBAL { bit: 2 }
region TABLE { bit: 3 }
region EXTERNAL { bit: 4 }

effect NONE { reads: [], writes: [] }
effect UNKNOWN { reads: [ALL], writes: [ALL] }
effect HEAP_READ { reads: [HEAP], writes: [] }
effect HEAP_WRITE { reads: [], writes: [HEAP] }
effect STACK_READ { reads: [STACK], writes: [] }
effect STACK_WRITE { reads: [], writes: [STACK] }
effect GLOBAL_READ { reads: [GLOBAL], writes: [] }
effect GLOBAL_WRITE { reads: [], writes: [GLOBAL] }
effect TABLE_READ { reads: [TABLE], writes: [] }
effect TABLE_WRITE { reads: [], writes: [TABLE] }
