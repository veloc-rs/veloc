// Logical signatures name SSA operands and properties; result names are optional.
// Storage mappings preserve the current compact MIR layout and SSA traversal order.
// Structural constraints compile to direct checks, not a runtime rule list.

op Iconst(@value: u64) -> ScalarInteger {
    mnemonic: "iconst",
    storage: Iconst { value: value },
    text: Text { args: [integer(value)] },
    memory: NONE
}

op Fconst(@value: u64) -> ScalarFloat {
    mnemonic: "fconst",
    storage: Fconst { value: value },
    text: Text { args: [float(value)] },
    memory: NONE
}

op Bconst(@value: bool) -> BOOL {
    mnemonic: "bconst",
    storage: Bconst { value: value },
    memory: NONE
}

op Vconst(@bytes: Bytes) -> Vector {
    mnemonic: "vconst",
    storage: Vconst { pool_id: pool(bytes) },
    text: Text { args: [bytes(bytes)] },
    memory: NONE,
    constraints: [require(len(bytes) == min_bytes(result_type(0)), "vector constant byte count must match its type")]
}

op IAdd<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "iadd",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.add(lhs, rhs)
}

op ISub<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "isub",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.sub(lhs, rhs)
}

op IMul<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "imul",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.mul(lhs, rhs)
}

op INeg<T: Integer>(arg: T) -> T {
    mnemonic: "ineg",
    storage: Unary { arg: arg },
    semantics: bv.sub(bv.zero(), arg)
}

op IAddSat<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "iadd-sat",
    storage: Binary { args: [lhs, rhs] },
    traits: [COMMUTATIVE], memory: NONE
}

op ISubSat<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "isub-sat",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op IAddWithOverflow<T: ScalarInteger>(lhs: T, rhs: T) -> (T, BOOL) {
    mnemonic: "iadd-with-overflow",
    storage: Binary { args: [lhs, rhs] },
    // The result wraps; the flag reports SIGNED overflow, not unsigned carry.
    semantics: [
        bv.add(lhs, rhs),
        bv.slt(bv.and(bv.xor(lhs, bv.add(lhs, rhs)), bv.xor(rhs, bv.add(lhs, rhs))), bv.zero())
    ]
}

op ISubWithOverflow<T: ScalarInteger>(lhs: T, rhs: T) -> (T, BOOL) {
    mnemonic: "isub-with-overflow",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op IMulWithOverflow<T: ScalarInteger>(lhs: T, rhs: T) -> (T, BOOL) {
    mnemonic: "imul-with-overflow",
    storage: Binary { args: [lhs, rhs] },
    traits: [COMMUTATIVE], memory: NONE
}

op IDivS<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "idiv-s",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.sdiv(lhs, rhs),
    traps: [
        DivisionByZero(bv.eq(rhs, bv.zero())),
        IntegerOverflow(bv.and(bv.eq(lhs, bv.smin()), bv.eq(rhs, bv.ones())))
    ]
}

op IDivU<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "idiv-u",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.udiv(lhs, rhs),
    traps: [DivisionByZero(bv.eq(rhs, bv.zero()))]
}

op IRemS<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "irem-s",
    storage: Binary { args: [lhs, rhs] },
    // Signed MIN % -1 returns zero; unlike signed division it does not trap.
    semantics: bv.srem(lhs, rhs),
    traps: [DivisionByZero(bv.eq(rhs, bv.zero()))]
}

op IRemU<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "irem-u",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.urem(lhs, rhs),
    traps: [DivisionByZero(bv.eq(rhs, bv.zero()))]
}

op FAdd<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fadd",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FSub<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fsub",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FMul<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fmul",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FNeg<T: Float>(arg: T) -> T {
    mnemonic: "fneg",
    storage: Unary { arg: arg },
    memory: NONE
}

op FDiv<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fdiv",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FMin<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fmin",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FMax<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fmax",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FCopysign<T: Float>(lhs: T, rhs: T) -> T {
    mnemonic: "fcopysign",
    storage: Binary { args: [lhs, rhs] },
    memory: NONE
}

op FAbs<T: Float>(arg: T) -> T {
    mnemonic: "fabs",
    storage: Unary { arg: arg },
    memory: NONE
}

op FSqrt<T: Float>(arg: T) -> T {
    mnemonic: "fsqrt",
    storage: Unary { arg: arg },
    memory: NONE
}

op FCeil<T: Float>(arg: T) -> T {
    mnemonic: "fceil",
    storage: Unary { arg: arg },
    memory: NONE
}

op FFloor<T: Float>(arg: T) -> T {
    mnemonic: "ffloor",
    storage: Unary { arg: arg },
    memory: NONE
}

op FTrunc<T: Float>(arg: T) -> T {
    mnemonic: "ftrunc",
    storage: Unary { arg: arg },
    memory: NONE
}

op FNearest<T: Float>(arg: T) -> T {
    mnemonic: "fnearest",
    storage: Unary { arg: arg },
    memory: NONE
}

op IAnd<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> T {
    mnemonic: "iand",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.and(lhs, rhs)
}

op IOr<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> T {
    mnemonic: "ior",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.or(lhs, rhs)
}

op IXor<T: Integer | BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> T {
    mnemonic: "ixor",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.xor(lhs, rhs)
}

op IShl<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "ishl",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.shl(lhs, bv.urem(rhs, bv.width()))
}

op IShrS<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "ishr-s",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.ashr(lhs, bv.urem(rhs, bv.width()))
}

op IShrU<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "ishr-u",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.lshr(lhs, bv.urem(rhs, bv.width()))
}

op IRotl<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "irotl",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.or(
        bv.shl(lhs, bv.urem(rhs, bv.width())),
        bv.lshr(lhs, bv.sub(bv.width(), bv.urem(rhs, bv.width())))
    )
}

op IRotr<T: Integer>(lhs: T, rhs: T) -> T {
    mnemonic: "irotr",
    storage: Binary { args: [lhs, rhs] },
    semantics: bv.or(
        bv.lshr(lhs, bv.urem(rhs, bv.width())),
        bv.shl(lhs, bv.sub(bv.width(), bv.urem(rhs, bv.width())))
    )
}

op IClz<T: Integer>(arg: T) -> T {
    mnemonic: "iclz",
    storage: Unary { arg: arg },
    semantics: bv.clz(arg)
}

op ICtz<T: Integer>(arg: T) -> T {
    mnemonic: "ictz",
    storage: Unary { arg: arg },
    semantics: bv.ctz(arg)
}

op IPopcnt<T: Integer>(arg: T) -> T {
    mnemonic: "ipopcnt",
    storage: Unary { arg: arg },
    semantics: bv.popcnt(arg)
}

op IEqz(arg: ScalarInteger) -> BOOL {
    mnemonic: "ieqz",
    storage: Unary { arg: arg },
    semantics: bv.eq(arg, bv.zero())
}

op Icmp<T: ScalarInteger | PTR>(@kind: IntCC, lhs: T, rhs: T) -> BOOL {
    mnemonic: "icmp",
    storage: IntCompare { kind: kind, args: [lhs, rhs] },
    text: Text { args: [space(kind, lhs), rhs] },
    semantics: bv.cmp(kind, lhs, rhs),
    constraints: [require(!is_ptr(type(lhs)) || kind == IntCC.Eq || kind == IntCC.Ne, "pointer comparison only supports eq and ne")]
}

op Fcmp<T: ScalarFloat>(@kind: FloatCC, lhs: T, rhs: T) -> BOOL {
    mnemonic: "fcmp",
    storage: FloatCompare { kind: kind, args: [lhs, rhs] },
    text: Text { args: [space(kind, lhs), rhs] },
    memory: NONE
}

op ExtendS<T: Integer>(arg: T) -> (result: shape(T, Integer)) {
    mnemonic: "extends",
    storage: Unary { arg: arg },
    where: [wider(arg, result)],
    semantics: bv.sext(arg, result(0))
}

op ExtendU<T: Integer | BOOL | vectors(BOOL)>(arg: T) -> (result: shape(T, Integer)) {
    mnemonic: "extendu",
    storage: Unary { arg: arg },
    where: [wider(arg, result)],
    semantics: bv.zext(arg, result(0))
}

op Wrap<T: Integer>(arg: T) -> (result: shape(T, Integer)) {
    mnemonic: "wrap",
    storage: Unary { arg: arg },
    where: [narrower(arg, result)],
    semantics: bv.trunc(arg, result(0))
}

op FloatToIntSatS<T: Float>(arg: T) -> shape(T, Integer) {
    mnemonic: "float-to-int-sat-s",
    storage: Unary { arg: arg },
    memory: NONE
}

op FloatToIntSatU<T: Float>(arg: T) -> shape(T, Integer) {
    mnemonic: "float-to-int-sat-u",
    storage: Unary { arg: arg },
    memory: NONE
}

op FloatToIntS<T: Float>(arg: T) -> shape(T, Integer) {
    mnemonic: "float-to-int-s",
    storage: Unary { arg: arg },
    traits: [MAY_TRAP], memory: NONE
}

op FloatToIntU<T: Float>(arg: T) -> shape(T, Integer) {
    mnemonic: "float-to-int-u",
    storage: Unary { arg: arg },
    traits: [MAY_TRAP], memory: NONE
}

op IntToFloatS<T: Integer>(arg: T) -> shape(T, Float) {
    mnemonic: "int-to-float-s",
    storage: Unary { arg: arg },
    memory: NONE
}

op IntToFloatU<T: Integer>(arg: T) -> shape(T, Float) {
    mnemonic: "int-to-float-u",
    storage: Unary { arg: arg },
    memory: NONE
}

op FloatPromote(arg: F32) -> F64 {
    mnemonic: "float-promote",
    storage: Unary { arg: arg },
    memory: NONE
}

op FloatDemote(arg: F64) -> F32 {
    mnemonic: "float-demote",
    storage: Unary { arg: arg },
    memory: NONE
}

op Reinterpret(arg: Number) -> (result: Number) {
    mnemonic: "reinterpret",
    storage: Unary { arg: arg },
    where: [same_width_distinct(arg, result)],
    memory: NONE
}

op IntToPtr(arg: ScalarInteger) -> PTR {
    mnemonic: "inttoptr",
    storage: IntToPtr { arg: arg },
    memory: NONE
}

op PtrToInt(arg: PTR) -> ScalarInteger {
    mnemonic: "ptrtoint",
    storage: PtrToInt { arg: arg },
    memory: NONE
}

op Load(ptr: PTR, @offset: u32, @flags: MemFlags) -> Any {
    mnemonic: "load",
    storage: Load { ptr: ptr, offset: offset, flags: flags },
    text: Text { args: [ptr], named: [default(offset, 0)], flags: flags },
    traits: [MAY_TRAP], memory: HEAP_READ
}

op Store(ptr: PTR, value: Any, @offset: u32, @flags: MemFlags) -> () {
    mnemonic: "store",
    storage: Store { ptr: ptr, value: value, offset: offset, flags: flags },
    text: Text { args: [value, ptr], named: [default(offset, 0)], flags: flags },
    traits: [MAY_TRAP], memory: HEAP_WRITE
}

op StackLoad(@slot: StackSlot, @offset: u32) -> Any {
    mnemonic: "stack-load",
    storage: StackLoad { slot: slot, offset: offset },
    text: Text { args: [slot], named: [default(offset, 0)] },
    memory: STACK_READ
}

op StackStore(@slot: StackSlot, value: Any, @offset: u32) -> () {
    mnemonic: "stack-store",
    storage: StackStore { slot: slot, value: value, offset: offset },
    text: Text { args: [value, slot], named: [default(offset, 0)] },
    memory: STACK_WRITE
}

op StackAddr(@slot: StackSlot, @offset: u32) -> PTR {
    mnemonic: "stack-addr",
    storage: StackAddr { slot: slot, offset: offset },
    text: Text { args: [slot], named: [default(offset, 0)] },
    memory: NONE
}

op PtrOffset(ptr: PTR, @offset: i32) -> PTR {
    mnemonic: "ptr-offset",
    storage: PtrOffset { ptr: ptr, offset: offset },
    memory: NONE
}

op PtrIndex(ptr: PTR, index: ScalarInteger, @imm: PtrIndexImm) -> PTR {
    mnemonic: "ptr-index",
    storage: PtrIndex { ptr: ptr, index: index, imm_id: pool(imm) },
    text: Text { args: [ptr, index], named: [default(imm.scale, 1), default(imm.offset, 0)] },
    memory: NONE,
    constraints: [require(imm.scale != 0, "ptr-index scale must be non-zero")]
}

op Call(@func_id: FuncId, args: values) -> signature {
    mnemonic: "call",
    storage: Call { func_id: func_id, args: args },
    signature: function(func_id),
    text: Text { args: [invoke(func_id, args)] },
    traits: [MAY_TRAP], memory: UNKNOWN
}

op CallIndirect(@sig_id: SigId, ptr: PTR, args: values) -> signature {
    mnemonic: "call-indirect",
    storage: CallIndirect { ptr: ptr, args: args, sig_id: sig_id },
    signature: sig_id,
    text: Text { args: [invoke(ptr, args, sig_id)] },
    traits: [MAY_TRAP], memory: UNKNOWN
}

op CallIntrinsic(@intrinsic: Intrinsic, @sig_id: SigId, args: values) -> signature {
    mnemonic: "call-intrinsic",
    storage: CallIntrinsic { intrinsic: intrinsic, args: args, sig_id: sig_id },
    signature: sig_id,
    text: Text { args: [invoke(intrinsic, args, sig_id)] },
    traits: [MAY_TRAP], memory: UNKNOWN
}

op Jump(dest: successor) -> () {
    mnemonic: "jump",
    storage: Jump { dest: dest },
    traits: [TERMINATOR], memory: NONE
}

op Br(condition: BOOL, then_dest: successor, else_dest: successor) -> () {
    mnemonic: "br",
    storage: Br { condition: condition, then_dest: then_dest, else_dest: else_dest },
    traits: [TERMINATOR], memory: NONE
}

op BrTable(index: I32, cases: successors, default: successor) -> () {
    mnemonic: "br-table",
    storage: BrTable { index: index, table: table(cases, default) },
    traits: [TERMINATOR], memory: NONE
}

op Return(values: values) -> () {
    mnemonic: "return",
    storage: Return { values: values },
    traits: [TERMINATOR], memory: NONE
}

op Select<T: Any>(condition: BOOL, if_true: T, if_false: T) -> T {
    mnemonic: "select",
    storage: Ternary { args: [condition, if_true, if_false] },
    memory: NONE
}

op Unreachable() -> () {
    mnemonic: "unreachable",
    storage: Unreachable {},
    traits: [TERMINATOR, MAY_TRAP], memory: NONE
}

op Nop() -> () {
    mnemonic: "nop",
    storage: Nop {},
    memory: NONE
}

op Splat<T: Scalar>(arg: T) -> vector(T) {
    mnemonic: "splat",
    storage: Unary { arg: arg },
    memory: NONE
}

op Shuffle<T: Vector>(lhs: T, rhs: T, @mask: Bytes) -> T {
    mnemonic: "shuffle",
    storage: Shuffle { args: [lhs, rhs], mask: pool(mask) },
    text: Text { args: [lhs, rhs], named: [bytes(mask)] },
    memory: NONE,
    constraints: [
        require(is_fixed(type(lhs)), "shuffle requires a fixed-width vector"),
        require(len(mask) == lanes(type(lhs)), "shuffle mask length must match its lane count"),
        require(all(mask, |i| i < 2 * lanes(type(lhs))), "shuffle selector is out of range")
    ]
}

op InsertElement<T: Vector>(vector: T, scalar: element(T), index: ScalarInteger) -> T {
    mnemonic: "insertelement",
    storage: Ternary { args: [vector, scalar, index] },
    memory: NONE
}

op ExtractElement<T: Vector>(vector: T, index: ScalarInteger) -> element(T) {
    mnemonic: "extractelement",
    storage: Binary { args: [vector, index] },
    memory: NONE
}

op ReduceSum<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-sum",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceAdd<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-add",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceMin<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-min",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceMax<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-max",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceAnd<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-and",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceOr<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-or",
    storage: Unary { arg: arg },
    memory: NONE
}

op ReduceXor<T: Vector>(arg: T) -> element(T) {
    mnemonic: "reduce-xor",
    storage: Unary { arg: arg },
    memory: NONE
}

op LoadStride(ptr: PTR, stride: ScalarInteger, @mem: VectorMemOptions) -> Vector {
    mnemonic: "load-stride",
    storage: VectorLoadStrided { ptr: ptr, stride: stride, ext: pool(mem) },
    text: Text { args: [ptr], named: [stride, default(mem.offset, 0), optional(mem.mask), optional(mem.evl)], flags: mem.flags },
    traits: [MAY_TRAP], memory: HEAP_READ
}

op StoreStride(ptr: PTR, stride: ScalarInteger, value: Vector, @mem: VectorMemOptions) -> () {
    mnemonic: "store-stride",
    storage: VectorStoreStrided { args: [ptr, stride, value], ext: pool(mem) },
    text: Text { args: [value, ptr], named: [stride, default(mem.offset, 0), optional(mem.mask), optional(mem.evl)], flags: mem.flags },
    traits: [MAY_TRAP], memory: HEAP_WRITE
}

op Gather<T: Integer & Vector>(ptr: PTR, index: T, @mem: VectorMemOptions) -> shape(T, Vector) {
    mnemonic: "gather",
    storage: VectorGather { ptr: ptr, index: index, ext: pool(mem) },
    text: Text { args: [ptr], named: [index, default(mem.scale, 1), default(mem.offset, 0), optional(mem.mask), optional(mem.evl)], flags: mem.flags },
    traits: [MAY_TRAP], memory: HEAP_READ
}

op Scatter<T: Integer & Vector>(ptr: PTR, index: T, value: shape(T, Vector), @mem: VectorMemOptions) -> () {
    mnemonic: "scatter",
    storage: VectorScatter { args: [ptr, index, value], ext: pool(mem) },
    text: Text { args: [value, ptr], named: [index, default(mem.scale, 1), default(mem.offset, 0), optional(mem.mask), optional(mem.evl)], flags: mem.flags },
    traits: [MAY_TRAP], memory: HEAP_WRITE
}

op SetVL(arg: ScalarInteger) -> I32 {
    mnemonic: "setvl",
    storage: Unary { arg: arg },
    memory: NONE
}
