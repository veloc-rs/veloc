op Load(ptr: PTR, @offset: u32, @flags: MemFlags) -> Any {
    meta: OpInfo { traits: [MAY_TRAP], memory: field(MemoryAccess, effects) },
    mnemonic: "load",
    storage: Load { ptr, offset, flags },
    text: "{.flags} {ptr}, offset={offset}",
    implements: [ReadAccess(ptr, i64(offset), result_type(0), flags)],
}

op Store(ptr: PTR, value: Any, @offset: u32, @flags: MemFlags) -> () {
    meta: OpInfo { traits: [MAY_TRAP], memory: field(MemoryAccess, effects) },
    mnemonic: "store",
    storage: Store { ptr, value, offset, flags },
    text: "{.flags} {value}, {ptr}, offset={offset}",
    implements: [WriteAccess(ptr, i64(offset), value, flags)],
}

// A fresh, uninitialized local object, valid until the invocation returns.
// Physical resource exhaustion is outside MIR equivalence: unused objects may
// be eliminated, but distinct live objects must not be merged or speculated.
op Alloca(@size: u32, @align: u32) -> PTR {
    meta: OpInfo { memory: Known([ALLOCATE]) },
    mnemonic: "alloca",
    storage: Alloca { size, align },
    text: "size={size}, align={align}",

    verify {
        require(size > 0, "alloca size must be positive");
        require(is_power_of_two(align), "alloca alignment must be a power of two");
    }
}

op PtrOffset(ptr: PTR, @offset: i32) -> PTR {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "ptr-offset",
    storage: PtrOffset { ptr, offset },
}

op PtrIndex(ptr: PTR, index: ScalarInteger, @imm: PtrIndexImm) -> PTR {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "ptr-index",
    storage: PtrIndex { ptr, index, imm_id: imm },
    text: "{ptr}, {index}, scale={imm.scale}, offset={imm.offset}",

    verify {
        require(imm.scale != 0, "ptr-index scale must be non-zero");
    }
}

op Call(@func_id: FuncId, move args: values) -> signature {
    meta: OpInfo { traits: [MAY_TRAP], memory: Unknown },
    mnemonic: "call",
    storage: Call { func_id, args },
    signature: function(func_id),
    text: "{func_id}({args}) : {function(func_id)}",
}

op CallIndirect(@sig_id: SigId, ptr: PTR, move args: values) -> signature {
    meta: OpInfo { traits: [MAY_TRAP], memory: Unknown },
    mnemonic: "call-indirect",
    storage: CallIndirect { ptr, args, sig_id },
    signature: sig_id,
    text: "{ptr}({args}) : {sig_id}",

    verify {
        require(all(Module.params(sig_id)?, |t| !t.is_callable()) && all(Module.returns(sig_id)?, |t| !t.is_callable()), "indirect and intrinsic callable calls require an ownership-aware callable type");
    }
}

op CallIntrinsic(@intrinsic: Intrinsic, @sig_id: SigId, move args: values) -> signature {
    meta: OpInfo { traits: [MAY_TRAP], memory: Unknown },
    mnemonic: "call-intrinsic",
    storage: CallIntrinsic { intrinsic, args, sig_id },
    signature: sig_id,
    text: "{intrinsic}({args}) : {sig_id}",

    verify {
        require(all(Module.params(sig_id)?, |t| !t.is_callable()) && all(Module.returns(sig_id)?, |t| !t.is_callable()), "indirect and intrinsic callable calls require an ownership-aware callable type");
    }
}

op Jump(dest: successor) -> () {
    meta: OpInfo { traits: [TERMINATOR], memory: Known([]) },
    mnemonic: "jump",
    storage: Jump { dest },
}

op Br(condition: BOOL, then_dest: successor, else_dest: successor) -> () {
    meta: OpInfo { traits: [TERMINATOR], memory: Known([]) },
    mnemonic: "br",
    storage: Br { condition, then_dest, else_dest },
}

op BrTable(index: I32, cases: successors, default: successor) -> () {
    meta: OpInfo { traits: [TERMINATOR], memory: Known([]) },
    mnemonic: "br-table",
    storage: BrTable { index, table: table(cases, default) },
}

op Return(move values: values) -> () {
    meta: OpInfo { traits: [TERMINATOR], memory: Known([]) },
    mnemonic: "return",
    storage: Return { values },

    verify {
        require(matches(values, Module.returns(Module.current_signature())?), "return value type mismatch");
    }
}

op Select<T: Any>(condition: BOOL, if_true: T, if_false: T) -> T {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "select",
    storage: Ternary { args: [condition, if_true, if_false] },
}

op Unreachable() -> () {
    meta: OpInfo { traits: [TERMINATOR, MAY_TRAP, ABORT], memory: Known([]) },
    mnemonic: "unreachable",
    storage: Unreachable {},
}

op Nop() -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "nop",
    storage: Nop {},
}

op Splat<T: Scalar>(arg: T) -> vector(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "splat",
    storage: Unary { arg },
}

op Shuffle<T: Vector>(lhs: T, rhs: T, @mask: Bytes) -> T {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "shuffle",
    storage: Shuffle { args: [lhs, rhs], mask: pool(mask) },
    text: "{lhs}, {rhs}, mask={mask:bytes}",

    verify {
        require(type(lhs).is_fixed(), "shuffle requires a fixed-width vector");
        require(len(mask) == type(lhs).lanes()?, "shuffle mask length must match its lane count");
        require(all(mask, |i| i < 2 * type(lhs).lanes()?), "shuffle selector is out of range");
    }
}

op InsertElement<T: Vector>(vector: T, scalar: element(T), index: ScalarInteger) -> T {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    mnemonic: "insertelement",
    storage: Ternary { args: [vector, scalar, index] },
    // Unsigned index; an index >= the runtime lane count traps.
}

op ExtractElement<T: Vector>(vector: T, index: ScalarInteger) -> element(T) {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([]) },
    mnemonic: "extractelement",
    storage: Binary { args: [vector, index] },
    // Unsigned index; an index >= the runtime lane count traps.
}

// Add in increasing lane order, starting at lane 0 (no extra zero).
// Integer addition wraps. Floating addition uses the scalar FAdd contract.
op ReduceAdd<T: Number & Vector>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-add",
    storage: Unary { arg },
}

// Integer extrema use signed comparison. Float extrema propagate NaN;
// min(-0,+0) is -0, max(-0,+0) is +0. Fold in increasing lane order.
op ReduceMin<T: Number & Vector>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-min",
    storage: Unary { arg },
}

op ReduceMax<T: Number & Vector>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-max",
    storage: Unary { arg },
}

op ReduceAnd<T: Integer & Vector | vectors(BOOL)>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-and",
    storage: Unary { arg },
}

op ReduceOr<T: Integer & Vector | vectors(BOOL)>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-or",
    storage: Unary { arg },
}

op ReduceXor<T: Integer & Vector | vectors(BOOL)>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "reduce-xor",
    storage: Unary { arg },
}

op LoadStride(ptr: PTR, stride: ScalarInteger, @mem: VectorMemOptions) -> Vector {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([READ]) },
    mnemonic: "load-stride",
    storage: VectorLoadStrided { ptr, stride, ext: mem },
    text: "{mem.scale=1} {.mem.flags} {ptr}, stride={stride}, offset={mem.offset}[, mask={mem.mask}][, evl={mem.evl}]",

    verify {
        require(all(mem.mask, |v| type(v).is_predicate() && type(v).shape()? == result_type(0).shape()?), "mask must match vector shape");
        require(all(mem.evl, |v| type(v) == I32), "EVL must be i32");
    }
}

op StoreStride(ptr: PTR, stride: ScalarInteger, value: Vector, @mem: VectorMemOptions) -> () {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([WRITE]) },
    mnemonic: "store-stride",
    storage: VectorStoreStrided { args: [ptr, stride, value], ext: mem },
    text: "{mem.scale=1} {.mem.flags} {value}, {ptr}, stride={stride}, offset={mem.offset}[, mask={mem.mask}][, evl={mem.evl}]",

    verify {
        require(all(mem.mask, |v| type(v).is_predicate() && type(v).shape()? == type(value).shape()?), "mask must match vector shape");
        require(all(mem.evl, |v| type(v) == I32), "EVL must be i32");
    }
}

op Gather<T: Integer & Vector, U: Vector>(ptr: PTR, index: T, @mem: VectorMemOptions) -> U {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([READ]) },
    mnemonic: "gather",
    storage: VectorGather { ptr, index, ext: mem },
    text: "{.mem.flags} {ptr}, index={index}, scale={mem.scale}, offset={mem.offset}[, mask={mem.mask}][, evl={mem.evl}]",

    verify {
        require(U.same_shape(T), "index and result must have the same shape");
        require(all(mem.mask, |v| type(v).is_predicate() && type(v).shape()? == result_type(0).shape()?), "mask must match vector shape");
        require(all(mem.evl, |v| type(v) == I32), "EVL must be i32");
    }
}

op Scatter<T: Integer & Vector, U: Vector>(ptr: PTR, index: T, value: U, @mem: VectorMemOptions) -> () {
    meta: OpInfo { traits: [MAY_TRAP], memory: Known([WRITE]) },
    mnemonic: "scatter",
    storage: VectorScatter { args: [ptr, index, value], ext: mem },
    text: "{.mem.flags} {value}, {ptr}, index={index}, scale={mem.scale}, offset={mem.offset}[, mask={mem.mask}][, evl={mem.evl}]",

    verify {
        require(U.same_shape(T), "index and value must have the same shape");
        require(all(mem.mask, |v| type(v).is_predicate() && type(v).shape()? == type(value).shape()?), "mask must match vector shape");
        require(all(mem.evl, |v| type(v) == I32), "EVL must be i32");
    }
}
