op Icmp<T: ScalarInteger | PTR>(@kind: IntCC, lhs: T, rhs: T) -> BOOL {
    meta: OpInfo {},
    mnemonic: "icmp",
    storage: IntCompare { kind, args: [lhs, rhs] },
    text: "{kind} {lhs}, {rhs}",
    semantics: bv.cmp(kind, lhs, rhs),
    verify {
        require(!type(lhs).is_ptr() || kind == IntCC.Eq || kind == IntCC.Ne, "pointer comparison only supports eq and ne");
    }
}

op Fcmp<T: ScalarFloat>(@kind: FloatCC, lhs: T, rhs: T) -> BOOL {
