// Logical signatures name SSA operands and properties; result names are optional.
// Storage mappings preserve the current compact MIR layout and SSA traversal order.
// Structural constraints compile to direct checks, not a runtime rule list.

// Query data, not instruction storage. Value(PTR) checks the logical signature
// at definition time; the runtime representation is an ordinary SSA Value.
interface MemoryAccess {
    ptr: Value(PTR),
    offset: i64,
    ty: Type,
    stored: optional(Value),
    flags: MemFlags,
    effects: MemoryEffect,
}

fn ReadAccess(ptr: Value(PTR), offset: i64, ty: Type, flags: MemFlags) -> MemoryAccess {
    value: MemoryAccess {
        ptr: ptr, offset: offset, ty: ty, stored: none, flags: flags,
        effects: Known([READ]),
    },
}

fn WriteAccess(ptr: Value(PTR), offset: i64, value: Value, flags: MemFlags) -> MemoryAccess {
    value: MemoryAccess {
        ptr: ptr, offset: offset, ty: type(value), stored: some(value), flags: flags,
        effects: Known([WRITE]),
    },
}

// First-class callable values. Captures bind a prefix of the function parameters;
// the resulting callable signature describes the remaining inputs and answer.
// Allocation/ownership are effects: these operations are not arithmetic CSE/DCE.
op ClosureNew(@func_id: FuncId, move captures: values, @cleanup: FuncId) -> Callable {
    meta: OpInfo { memory: Unknown },
    mnemonic: "closure-new",
    storage: ClosureNew { func_id, captures, cleanup },
    text: "{func_id}({captures}) : {function(func_id)}, {cleanup}",
    control: owned(func_id, captures, cleanup),

    verify {
        require(result_type(0).is_owned(), "callable ownership kind mismatch");
        require(matches(captures, prefix(Module.params(Module.signature(func_id)?)?, len(captures))), "capture parameter type mismatch");
        require(suffix(Module.params(Module.signature(func_id)?)?, len(captures)) == Module.params(Types.signature(result_type(0))?)? && Module.returns(Module.signature(func_id)?)? == Module.returns(Types.signature(result_type(0))?)?, "callable inputs or answer do not match the unbound function signature");
        require(all(captures, |v| !type(v).is_local() && !type(v).is_ptr()), "capture would escape a borrow or duplicate an owned environment");
        require(Module.params(Module.signature(cleanup)?)? == prefix(Module.params(Module.signature(func_id)?)?, len(captures)) && len(Module.returns(Module.signature(cleanup)?)?) == 0, "cleanup must consume the captured parameters and return void");
    }
}

op ClosureLocal(@func_id: FuncId, captures: values) -> Callable {
    meta: OpInfo { memory: Unknown },
    mnemonic: "closure-local",
    storage: Closure { func_id, captures },
    text: "{func_id}({captures}) : {function(func_id)}",
    control: local(func_id, captures),

    verify {
        require(result_type(0).is_local(), "callable ownership kind mismatch");
        require(matches(captures, prefix(Module.params(Module.signature(func_id)?)?, len(captures))), "capture parameter type mismatch");
        require(suffix(Module.params(Module.signature(func_id)?)?, len(captures)) == Module.params(Types.signature(result_type(0))?)? && Module.returns(Module.signature(func_id)?)? == Module.returns(Types.signature(result_type(0))?)?, "callable inputs or answer do not match the unbound function signature");
        require(all(captures, |v| !type(v).is_owned()), "capture would escape a borrow or duplicate an owned environment");
    }
}

op ClosureShared(@func_id: FuncId, captures: values) -> Callable {
    meta: OpInfo { memory: Unknown },
    mnemonic: "closure-shared",
    storage: Closure { func_id, captures },
    text: "{func_id}({captures}) : {function(func_id)}",
    control: shared(func_id, captures),

    verify {
        require(result_type(0).is_shared(), "callable ownership kind mismatch");
        require(matches(captures, prefix(Module.params(Module.signature(func_id)?)?, len(captures))), "capture parameter type mismatch");
        require(suffix(Module.params(Module.signature(func_id)?)?, len(captures)) == Module.params(Types.signature(result_type(0))?)? && Module.returns(Module.signature(func_id)?)? == Module.returns(Types.signature(result_type(0))?)?, "callable inputs or answer do not match the unbound function signature");
        require(all(captures, |v| (type(v).is_compact() && !type(v).is_ptr()) || type(v).is_shared()), "capture would escape a borrow or duplicate an owned environment");
    }
}

op TailCall(@func_id: FuncId, move args: values) -> () {
    meta: OpInfo { memory: Unknown },
    mnemonic: "tail-call",
    storage: TailCall { func_id, args },
    text: "{func_id}({args}) : {function(func_id)}",
    control: tail_call(func_id, args),

    verify {
        require(matches(args, Module.params(Module.signature(func_id)?)?), "tail-call parameter type mismatch");
        require(Module.returns(Module.signature(func_id)?)? == Module.returns(Module.current_signature())?, "tail-call answer type mismatch");
    }
}

op TailCallValue(move callee: Callable, move args: values) -> () {
    meta: OpInfo { memory: Unknown },
    mnemonic: "tail-call-value",
    storage: CallValue { callee, args },
    text: "{callee}({args})",
    control: tail_call_value(callee, args),

    verify {
        require(matches(args, Module.params(Types.signature(type(callee))?)?), "tail-call-value parameter type mismatch");
        require(Module.returns(Types.signature(type(callee))?)? == Module.returns(Module.current_signature())?, "tail-call-value answer type mismatch");
    }
}

op CallValue(move callee: Callable, move args: values) -> signature {
    meta: OpInfo { memory: Unknown },
    mnemonic: "call-value",
    storage: CallValue { callee, args },
    signature: callable(callee),
    text: "{callee}({args})",
    control: call(callee, args),
}

op ClosureDrop(move callee: Callable) -> () {
    meta: OpInfo { memory: Unknown },
    mnemonic: "closure-drop",
    storage: Unary { arg: callee },
    control: drop(callee),

    verify {
        require(type(callee).is_owned(), "only an owned one-shot callable can be dropped");
    }
}

