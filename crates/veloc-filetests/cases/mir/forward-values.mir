// run: roundtrip
// check: call-indirect v3() : () -> void
// check: br v0, block2(), block4()
// check: br-table v1, [], block4()
// check: v3: ptr = inttoptr v2
local function forward_values() -> void
block0():
  jump block3()
block1():
  call-indirect v3() : () -> void
  br v0, block2(), block4()
block2():
  br-table v1, [], block4()
block3():
  v0: bool = bconst true
  v1: i32 = iconst 0
  v2: i64 = iconst 0
  v3: ptr = inttoptr v2
  jump block1()
block4():
  return
