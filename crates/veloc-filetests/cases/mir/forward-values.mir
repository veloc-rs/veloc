// ----- forward-values
// run: roundtrip
// check: call-indirect $(id3=v\d+)() : () -> void
// check: br bool(true), block2(), block4()
// check: br-table i32(0), [], block4()
// check: $id3: ptr = inttoptr i64(0)
local function forward_values() -> void
block0():
  jump block3()
block1():
  call-indirect v3() : () -> void
  br bool(true), block2(), block4()
block2():
  br-table i32(0), [], block4()
block3():
  v3: ptr = inttoptr i64(0)
  jump block1()
block4():
  return

// ----- canonical-inline-constants
// run: roundtrip
// not: = const
// check: $(id2=v\d+): i64 = iadd i64(7), i64(7)
// check: $(id3=v\d+): i64 = iadd i64(7), i64(7)
// check: return $id2, $id3
local function same() -> (i64, i64)
block0():
  v2: i64 = iadd i64(7), i64(7)
  v3: i64 = iadd i64(7), i64(7)
  return v2, v3

// ----- literal-allocation-does-not-capture-ssa-slots
// run: roundtrip
// check: iadd i64(7), v
// check: return
local function names(i64) -> i64
block0(v0: i64):
  jump block2()
block1():
  v2: i64 = iadd i64(7), v1
  return v2
block2():
  v1: i64 = iadd v0, v0
  jump block1()
