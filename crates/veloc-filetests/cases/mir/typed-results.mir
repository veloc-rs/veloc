// ----- explicit-types-and-names
// run: roundtrip
// check: global.v1: i32 = iconst 1
// check: ss0.v2: i32 = iadd input.v0, global.v1
// check: (sum.v3: i32, overflow.v4: bool) = iadd-with-overflow ss0.v2, global.v1
// check: return sum.v3, overflow.v4
local function names(i32) -> (i32, bool)
block0(input: i32):
  global: i32 = iconst 1
  ss0: i32 = iadd input, global
  (sum: i32, overflow: bool) = iadd-with-overflow ss0, global
  return sum, overflow

