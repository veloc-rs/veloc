// run: roundtrip
// check: splat.i32<4>
// check: iadd.i32<4>
// check: extractelement.i32
// check: insertelement.i32<4>
// check: reduce-sum.f32
// check: reduce-add.f32
// check: reduce-min.f32
// check: reduce-max.f32
// check: shuffle.i32<4>
local function vectors(i32, f32, i32<4>) -> (i32<4>, i32, f32, f32, f32, f32)
block0(v0: i32, v1: f32, v2: i32<4>):
  v3 = splat.i32<4> v0
  v4 = iadd v3, v2
  v13 = iconst.i32 0
  v14 = iconst.i32 1
  v5 = extractelement v4, v13
  v6 = insertelement v4, v0, v14
  v7 = splat.f32<4> v1
  v8 = reduce-sum v7
  v9 = reduce-add v7
  v10 = reduce-min v7
  v11 = reduce-max v7
  v12 = shuffle v4, v6, mask=0x00070104
  return v12, v5, v8, v9, v10, v11

local function scalable(i64, i32, mask<scalable 4>) -> i32<scalable 4>
block0(v0: i64, v1: i32, v2: mask<scalable 4>):
  v3 = setvl v0
  v4 = splat.i32<scalable 4> v1
  v5 = iadd v4, v4, mask=v2, evl=v3
  return v5
