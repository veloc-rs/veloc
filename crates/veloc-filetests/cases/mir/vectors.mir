// run: roundtrip
// check: : i32<4> = splat
// check: : i32<4> = iadd
// check: : i32 = extractelement
// check: : i32<4> = insertelement
// check: : f32 = reduce-add
// check: : f32 = reduce-min
// check: : f32 = reduce-max
// check: : i32<4> = shuffle
local function vectors(i32, f32, i32<4>) -> (i32<4>, i32, f32, f32, f32)
block0(v0: i32, v1: f32, v2: i32<4>):
  v3: i32<4> = splat v0
  v4: i32<4> = iadd v3, v2
  v5: i32 = extractelement v4, i32(0)
  v6: i32<4> = insertelement v4, v0, i32(1)
  v7: f32<4> = splat v1
  v9: f32 = reduce-add v7
  v10: f32 = reduce-min v7
  v11: f32 = reduce-max v7
  v12: i32<4> = shuffle v4, v6, i32<4>(0x00000000070000000100000004000000)
  return v12, v5, v9, v10, v11

local function scalable(i32, i32, mask<scalable 4>) -> i32<scalable 4>
block0(v0: i32, v1: i32, v2: mask<scalable 4>):
  v4: i32<scalable 4> = splat v1
  v5: i32<scalable 4> = iadd v4, v4, mask=v2, evl=v0
  return v5


local function shuffle_resize(i32<4>, i32<4>) -> (i32<2>, i32<8>, i32<4>)
block0(v0: i32<4>, v1: i32<4>):
  v5: i32<2> = shuffle v0, v1, i32<2>(0x0000000005000000)
  v6: i32<8> = shuffle v0, v1, i32<8>(0x0000000001000000020000000300000004000000050000000600000007000000)
  v7: i32<4> = shuffle v0, v1, i16<4>(splat(4))
  return v5, v6, v7
