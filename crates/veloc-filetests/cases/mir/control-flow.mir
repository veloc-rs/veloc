// ----- terminator-in-the-middle
// run: validate-error
// check: terminator inst0 is not last in block0
local function bad() -> void
block0():
  jump block1()
  return
block1():
  return

// ----- use-before-definition
// run: validate-error
// check: definition of v1 does not precede its use
local function bad() -> i32
block0():
  v0: i32 = iadd v1, v1
  v1: i32 = iconst 1
  return v0

// ----- self-use
// run: validate-error
// check: definition of v0 does not precede its use
local function bad(i32) -> i32
block0(v1: i32):
  v0: i32 = iadd v0, v1
  return v0

// ----- sibling-definition
// run: validate-error
// check: definition of v1 in block1 does not dominate its use in block2
local function bad(bool) -> i32
block0(v0: bool):
  br v0, block1(), block2()
block1():
  v1: i32 = iconst 1
  return v1
block2():
  return v1

// ----- unreachable-definition-used-by-reachable-block
// run: validate-error
// check: definition of v0 in block1 does not dominate its use in block0
local function bad() -> i32
block0():
  return v0
block1():
  v0: i32 = iconst 1
  return v0

// ----- parallel-edges-have-distinct-arguments
// run: roundtrip
// check: br v0, block1(v1), block1(v2)
local function choose(bool, i32, i32) -> i32
block0(v0: bool, v1: i32, v2: i32):
  br v0, block1(v1), block1(v2)
block1(v3: i32):
  return v3

// ----- dominance-does-not-follow-text-order
// run: roundtrip
// check: return v0
// check: v0: i32 = iconst 7
local function good() -> i32
block0():
  jump block2()
block1():
  return v0
block2():
  v0: i32 = iconst 7
  jump block1()

// ----- loop-carried-block-parameter
// run: roundtrip
// check: block1(v2: i32):
// check: br v0, block1(v3), block2(v3)
local function loop(bool, i32) -> i32
block0(v0: bool, v1: i32):
  jump block1(v1)
block1(v2: i32):
  v3: i32 = iadd v2, v1
  br v0, block1(v3), block2(v3)
block2(v4: i32):
  return v4

// ----- entry-parameter-contract
// run: validate-error
// check: entry parameter v0 type mismatch
local function bad(i32) -> i64
block0(v0: i64):
  return v0

// ----- irreducible-cycle-does-not-create-dominance
// run: validate-error
// check: definition of v1 in block1 does not dominate its use in block2
local function bad(bool) -> i32
block0(v0: bool):
  br v0, block1(), block2()
block1():
  v1: i32 = iconst 1
  jump block2()
block2():
  v2: i32 = iadd v1, v1
  br v0, block1(), block3(v2)
block3(v3: i32):
  return v3
