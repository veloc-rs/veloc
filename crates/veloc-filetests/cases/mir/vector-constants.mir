// ----- splats
// run: roundtrip
// check: v0: i32<4> = const splat(-7)
// check: v1: f32<scalable 4> = const splat(0x7fa12345)
// check: v2: mask<4> = const splat(true)
// check: v3: f64<2> = const splat(0x8000000000000000)
local function splats() -> (i32<4>, f32<scalable 4>, bool<4>, f64<2>)
block0():
  v0: i32<4> = const splat(-7)
  v1: f32<scalable 4> = const splat(0x7fa12345)
  v2: bool<4> = const splat(true)
  v3: f64<2> = const splat(0x8000000000000000)
  return v0, v1, v2, v3

