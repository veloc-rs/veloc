// ----- splats
// run: roundtrip
// check: v0: i32<4> = vconst splat(-7)
// check: v1: f32<scalable 4> = vconst splat(0x7fa12345)
// check: v2: mask<4> = vconst splat(true)
// check: v3: f64<2> = vconst splat(0x8000000000000000)
local function splats() -> void
block0():
  v0: i32<4> = vconst splat(-7)
  v1: f32<scalable 4> = vconst splat(0x7fa12345)
  v2: bool<4> = vconst splat(true)
  v3: f64<2> = vconst splat(0x8000000000000000)
  return

