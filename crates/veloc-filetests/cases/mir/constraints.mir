// ----- arithmetic-family
// run: parse-error
// check: invalid operand types
local function bad(f32, f32) -> void
block0(v0: f32, v1: f32):
  v2 = iadd v0, v1
  return

// ----- vector-constant-size
// run: validate-error
// check: vector constant byte count must match its type
local function bad() -> void
block0():
  v0 = vconst.i32<4> 0x00000000
  return

// ----- pointer-scale
// run: validate-error
// check: non-zero
local function bad(ptr, i32) -> void
block0(v0: ptr, v1: i32):
  v2 = ptr-index v0, v1, scale=0
  return

// ----- pointer-ordering
// run: validate-error
// check: only supports eq and ne
local function bad(ptr, ptr) -> void
block0(v0: ptr, v1: ptr):
  v2 = icmp ltu v0, v1
  return

// ----- shuffle-length
