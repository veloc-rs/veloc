// ----- incomplete-or-ambiguous-alternates-return-definition-errors-1
// run: opgen-error
// check: text projection does not consume `tag`
record Pair {
    inputs: values(2),
}
op Difference<T: Integer>(left: T, right: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "difference",
    storage: Pair { inputs: [left, right] },
}

record Extended {
    inputs: ValueList,
    tag: u32,
}
layout Extended {
    format: arity(inputs, [Pair]),
    text: "{inputs}",
}

// ----- incomplete-or-ambiguous-alternates-return-definition-errors-2
// run: opgen-error
// check: optional named fields require optional(Value)
record Pair {
    inputs: values(2),
}
op Difference<T: Integer>(left: T, right: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "difference",
    storage: Pair { inputs: [left, right] },
}

record Extended {
    inputs: ValueList,
    tag: u32,
}
layout Extended {
    format: arity(inputs, [Pair]),
    text: "{inputs}[, tag={tag}]",
}

