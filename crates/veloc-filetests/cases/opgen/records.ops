// ----- legacy-struct-fields-are-rejected
// run: opgen-error
// check: expected data type name
struct Settings { fields: [budget(u8, 1)] }

// ----- struct-defaults-are-rejected
// run: opgen-error
// check: expected `,`
struct Settings { budget: u8 = 1 }

// ----- optional-fields-must-be-explicit
// run: opgen-error
// check: missing field `budget`
struct Settings { budget: optional(u32) }
struct Work {  }
op Work() -> () {
    meta: Settings {}, mnemonic: "work", storage: Work {}
}

// ----- fixed-text-binding-is-range-checked
// run: opgen-error
// check: fixed text binding requires an in-range integer literal
struct Settings { scale: u8 }
struct Work { settings: Settings }
op Work(settings: Settings) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "work", storage: Work { settings: settings },
    text: "{settings.scale=256}"
}

// ----- fixed-text-binding-cannot-also-consume-input
// run: opgen-error
// check: text field `settings.scale` is consumed more than once
struct Settings { scale: u8 }
struct Work { settings: Settings }
op Work(settings: Settings) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "work", storage: Work { settings: settings },
    text: "{settings.scale=1} {settings.scale}"
}


// ----- struct-without-instruction-use-is-plain-data
// run: opgen
// check: pub struct Operands
// check: pub budget: u32
struct Operands { budget: u32 }

// ----- legacy-format-declaration-is-rejected
// run: opgen-error
// check: unknown definition kind `format`
format Pair {}

// ----- opcode-is-not-a-struct-type
// run: opgen-error
// check: unknown data type `Opcode`
struct Pair { opcode: Opcode, args: values(2) }

// ----- alternate-layout-requires-a-struct
// run: opgen-error
// check: unknown layout struct `Alternate`
struct Pair { args: values(2) }
layout Alternate { format: fixed(Pair), text: "{args}" }

// ----- lir-layout-overrides-are-rejected
// run: opgen-error
// check: operand views are derived from structs
storage Operands {}
layout Missing { accessor: missing }
