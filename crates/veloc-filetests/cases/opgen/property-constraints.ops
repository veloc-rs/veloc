// ----- property-type-checking
// run: opgen-error
// check: constraint expects Bool, got Int
property VectorConst {
    constraints: [all(bytes(value), |byte| byte)]
}

// ----- property-result-context
// run: opgen-error
// check: property constraints cannot depend on instruction or module context
property VectorConst {
    constraints: [type(value) == result_type(0)]
}

// ----- property-module-context
// run: opgen-error
// check: property constraints cannot depend on instruction or module context
property VectorConst {
    constraints: [len(params(current_signature())) == 0]
}

// ----- unknown-property
// run: opgen-error
// check: unknown typed property
property Unknown {
    constraints: [true]
}
