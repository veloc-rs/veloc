// ----- property-type-checking
// run: opgen-error
// check: projection type mismatch: expected Named("bool"), found Named("u8")
property VectorConst {
    verify {
        all(Constants.bytes(value)?, |byte| byte);
    }
}

// ----- property-result-context
// run: opgen-error
// check: result_type requires a fixed operation result signature
property VectorConst {
    verify {
        type(value) == result_type(0);
    }
}

// ----- property-emits-declared-host-calls
// run: opgen
// check: crate::host::traits::Module::params(&_host, crate::host::traits::Module::current_signature
property VectorConst {
    verify {
        len(Module.params(Module.current_signature())?) == 0;
    }
}

// ----- unknown-property
// run: opgen-error
// check: unknown typed property
property Unknown {
    verify {
        true;
    }
}
