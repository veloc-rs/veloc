// ----- unknown-field
// run: opgen-error
// check: unknown field
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     memroy: NONE, semantics: bv.add(lhs, rhs)
}

// ----- duplicate-field
// run: opgen-error
// check: duplicate field
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]), memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
      semantics: bv.add(lhs, rhs)
}

// ----- unknown-format
// run: opgen-error
// check: unknown
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Missing { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- invalid-identifier
// run: opgen-error
// check: invalid generated identifier
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "type", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-variable
// run: opgen-error
// check: unbound type variable `U`
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: U) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-storage
// run: opgen-error
// check: missing
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, missing] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-semantics
// run: opgen-error
// check: missing
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, missing)
}

// ----- storage-arity
// run: opgen-error
// check: storage field `args` requires 2 arguments
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unknown-primitive
// run: opgen-error
// check: unknown
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.unknown(lhs, rhs)
}

// ----- wrong-primitive-type
// run: opgen-error
// check: floating-point
struct Binary {
    args: values(2),
}
op IAdd<T: Float>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- primitive-arity
// run: opgen-error
// check: bv.neg expects 1 arguments, got 2
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.neg(lhs, rhs)
}

// ----- unknown-memory
// run: opgen-error
// check: no memory effects
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Unknown },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- relation-operand
// run: opgen-error
// check: missing
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", verify {
        require(result.element_bits()? > type(missing).element_bits()?, "result must have more bits per lane than missing");
    } storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unknown-relation
// run: opgen-error
// check: expected value of type bool
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", verify { require(unknown(type(lhs)), "unknown constraint"); } storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- missing-colon
// run: opgen-error
// check: expected `:`
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo {},
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory NONE, semantics: bv.add(lhs, rhs)
}

// ----- string-newline
// run: opgen-error
// check: newline in string
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd, storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- out-of-range
// run: opgen-error
// check: out of range
struct Binary {
    args: values(99999999999999),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- duplicate-mnemonic
// run: opgen-error
// check: duplicate mnemonic
struct Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}
op Other<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}
