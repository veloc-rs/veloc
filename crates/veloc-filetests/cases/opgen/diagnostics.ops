// ----- unknown-field
// run: opgen-error
// check: unknown field
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, memroy: NONE, semantics: bv.add(lhs, rhs)
}

// ----- duplicate-field
// run: opgen-error
// check: duplicate field
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, memory: NONE, semantics: bv.add(lhs, rhs)
}

