// ----- out-of-range
// run: opgen-error
// check: out of range
format Binary {
    fields: [opcode(Opcode), args(values(99999999999999))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}

// ----- duplicate-mnemonic
// run: opgen-error
// check: duplicate mnemonic
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}
op Other<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}
