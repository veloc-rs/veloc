// ----- storage-arity
// run: opgen-error
// check: storage field `args` requires 2 arguments
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}

// ----- unknown-primitive
