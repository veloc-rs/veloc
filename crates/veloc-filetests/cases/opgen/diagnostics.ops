// ----- unknown-field
// run: opgen-error
// check: unknown field
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     memroy: NONE, semantics: bv.add(lhs, rhs)
}

// ----- duplicate-field
// run: opgen-error
// check: duplicate field
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]), memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
      semantics: bv.add(lhs, rhs)
}

// ----- unknown-format
// run: opgen-error
// check: unknown
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Missing { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- invalid-identifier
// run: opgen-error
// check: invalid generated identifier
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "type", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-variable
// run: opgen-error
// check: unbound type variable `U`
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: U) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-storage
// run: opgen-error
// check: missing
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, missing] },
     semantics: bv.add(lhs, rhs)
}

// ----- unbound-semantics
// run: opgen-error
// check: missing
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, missing)
}

// ----- storage-arity
// run: opgen-error
// check: storage field `args` requires 2 arguments
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unknown-primitive
// run: opgen-error
// check: unknown
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.unknown(lhs, rhs)
}

// ----- wrong-primitive-type
// run: opgen-error
// check: floating-point
record Binary {
    args: values(2),
}
op IAdd<T: Float>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- primitive-arity
// run: opgen-error
// check: bv.neg expects 1 arguments, got 2
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.neg(lhs, rhs)
}

// ----- unknown-memory
// run: opgen-error
// check: no memory effects
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Unknown },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- relation-operand
// run: opgen-error
// check: missing
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", where: [wider(missing, result)], storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- unknown-relation
// run: opgen-error
// check: type relation
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", where: [unknown(lhs, result)], storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- missing-colon
// run: opgen-error
// check: expected `:`
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo {},
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory NONE, semantics: bv.add(lhs, rhs)
}

// ----- string-newline
// run: opgen-error
// check: newline in string
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd, storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- out-of-range
// run: opgen-error
// check: out of range
record Binary {
    args: values(99999999999999),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}

// ----- duplicate-mnemonic
// run: opgen-error
// check: duplicate mnemonic
record Binary {
    args: values(2),
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}
op Other<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
     semantics: bv.add(lhs, rhs)
}
