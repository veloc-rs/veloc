// ----- primitive-arity
// run: opgen-error
// check: bv.neg expects 1 arguments, got 2
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.neg(lhs, rhs)
}

// ----- unknown-memory
// run: opgen-error
// check: no memory effects
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", storage: Binary { args: [lhs, rhs] },
    memory: UNKNOWN, semantics: bv.add(lhs, rhs)
}

// ----- relation-operand
// run: opgen-error
// check: missing
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", where: [wider(missing, result)], storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}

// ----- unknown-relation
// run: opgen-error
// check: type relation
format Binary {
    fields: [opcode(Opcode), args(values(2))],
    opcode: dynamic(opcode)
}
op IAdd<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    mnemonic: "iadd", where: [unknown(lhs, result)], storage: Binary { args: [lhs, rhs] },
    memory: NONE, semantics: bv.add(lhs, rhs)
}

