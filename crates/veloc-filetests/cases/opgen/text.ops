// ----- text-generation/incomplete-or-ambiguous-alternates-return-definition-errors-1
// run: opgen-error
// check: text projection does not consume `tag`
struct Pair {
    inputs: values(2),
}
op Difference<T: Integer>(left: T, right: T) -> (result: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "difference",
    storage: Pair { inputs: [left, right] },
}

struct Extended {
    inputs: ValueList,
    tag: u32,
}
layout Extended {
    format: arity(inputs, [Pair]),
    text: "{inputs}",
}

// ----- text-generation/incomplete-or-ambiguous-alternates-return-definition-errors-2
// run: opgen-error
// check: optional named fields require optional(Value)
struct Pair {
    inputs: values(2),
}
op Difference<T: Integer>(left: T, right: T) -> (result: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "difference",
    storage: Pair { inputs: [left, right] },
}

struct Extended {
    inputs: ValueList,
    tag: u32,
}
layout Extended {
    format: arity(inputs, [Pair]),
    text: "{inputs}[, tag={tag}]",
}

