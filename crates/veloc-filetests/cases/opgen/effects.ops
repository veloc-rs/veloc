// ----- unknown-is-not-a-member
// run: opgen-error
// check: unknown MemoryEffects
struct Effectful {  }
op Effectful() -> () {
    meta: OpInfo { memory: Known([unknown]) },
mnemonic: "effectful", storage: Effectful {}, }

// ----- duplicate-behavior
// run: opgen-error
// check: duplicate MemoryEffects member
struct Effectful {  }
op Effectful() -> () {
    meta: OpInfo { memory: Known([READ, READ]) },
mnemonic: "effectful", storage: Effectful {}, }

// ----- old-alias-is-not-supported
// run: opgen-error
// check: unknown field
struct Effectful {  }
op Effectful() -> () {
    meta: OpInfo { memory: Unknown },
    mnemonic: "effectful", storage: Effectful {}, memory: READ
}

// ----- old-effect-declaration-is-not-supported
// run: opgen-error
// check: unknown definition kind
effect CUSTOM { reads: true }
