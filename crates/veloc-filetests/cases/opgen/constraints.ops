// ----- pool-properties-and-lexical-binders-are-generic-1
// run: opgen-error
// check: constraint expects Bool, got Int
format Vconst { fields: [pool_id(ConstantPoolId)], opcode: fixed(Vconst) }
op Vconst(@data: Bytes) -> Vector {
    mnemonic: "vconst", storage: Vconst { pool_id: pool(data) },
    text: Text { args: [bytes(data)] }, memory: NONE,
    constraints: [len(data) == min_bytes(result_type(0)), all(data, |i| i)]
}

// ----- pool-properties-and-lexical-binders-are-generic-2
// run: opgen-error
// check: result_type index is out of bounds
format Vconst { fields: [pool_id(ConstantPoolId)], opcode: fixed(Vconst) }
op Vconst(@data: Bytes) -> () {
    mnemonic: "vconst", storage: Vconst { pool_id: pool(data) },
    text: Text { args: [bytes(data)] }, memory: NONE,
    constraints: [len(data) == min_bytes(result_type(0)), all(data, |i| i < 2 * lanes(result_type(0)))]
}

// ----- record-access-uses-logical-names-not-rule-or-storage-names-1
// run: opgen-error
// check: unknown field PtrIndexImm.unknown
record PtrIndexImm {
    storage: PtrIndexImmId,
    fields: [offset(i32, 0), scale(u32, 1)]
}

format PtrIndex {
    fields: [ptr(Value), index(Value), imm_id(PtrIndexImmId)],
    opcode: fixed(PtrIndex)
}

op PtrIndex(ptr: PTR, index: ScalarInteger, @imm: PtrIndexImm) -> PTR {
    mnemonic: "ptr-index",
    storage: PtrIndex { ptr: ptr, index: index, imm_id: pool(imm) },
    text: Text { args: [ptr, index], named: [default(imm.scale, 1), default(imm.offset, 0)] },
    memory: NONE,
    constraints: [require(imm.unknown != 0, "ptr-index scale must be non-zero")]
}

// ----- type-queries-use-static-signatures-and-operand-positions-1
// run: opgen-error
// check: constraint is always false: is_ptr(type(input))
format Unary { fields: [opcode(Opcode), arg(Value)], opcode: dynamic(opcode) }
op Example<T: Integer>(input: T) -> T {
    mnemonic: "example", storage: Unary { arg: input }, memory: NONE,
    constraints: [is_ptr(type(input)), lanes(type(input)) > 0]
}
