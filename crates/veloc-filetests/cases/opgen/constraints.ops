// ----- constant-folding-preserves-precedence-and-short-circuiting-1
// run: opgen-error
// check: constraint is always false: ((1 + (2 * 3)) == 9)
format Custom { fields: [opcode(Opcode), bits(u64), yes(bool)], opcode: dynamic(opcode) }
op Example(@number: u64, @flag: bool) -> ScalarInteger {
    mnemonic: "example", storage: Custom { bits: number, yes: flag },
    memory: NONE, constraints: [1 + 2 * 3 == 9]
}

// ----- ill-typed-or-unbounded-expressions-are-definition-errors-1
// run: opgen-error
// check: constraint expects Int, got Bool
format Custom { fields: [opcode(Opcode), bits(u64), yes(bool)], opcode: dynamic(opcode) }
op Example(@number: u64, @flag: bool) -> ScalarInteger {
    mnemonic: "example", storage: Custom { bits: number, yes: flag },
    memory: NONE, constraints: [number && flag]
}

// ----- ill-typed-or-unbounded-expressions-are-definition-errors-2
// run: opgen-error
// check: constraint expects Int, got Bool
format Custom { fields: [opcode(Opcode), bits(u64), yes(bool)], opcode: dynamic(opcode) }
op Example(@number: u64, @flag: bool) -> ScalarInteger {
    mnemonic: "example", storage: Custom { bits: number, yes: flag },
    memory: NONE, constraints: [number == flag]
}

