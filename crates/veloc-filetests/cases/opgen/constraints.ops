// ----- pool-properties-and-lexical-binders-are-generic-1
// run: opgen-error
// check: projection type mismatch: expected Named("bool"), found Named("i128")
struct Custom { pool_id: ConstantPoolId }
op Example(@data: Bytes) -> Vector {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "example", storage: Custom { pool_id: pool(data) },
    text: "{data:bytes}",
    verify {
        len(data) == min_bytes(result_type(0)); all(data, |i| i);
    }
}

// ----- pool-properties-and-lexical-binders-are-generic-2
// run: opgen-error
// check: result_type index is out of range
struct Custom { pool_id: ConstantPoolId }
op Example(@data: Bytes) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "example", storage: Custom { pool_id: pool(data) },
    text: "{data:bytes}",
    verify {
        len(data) == min_bytes(result_type(0)); all(data, |i| i < 2 * lanes(result_type(0)));
    }
}

// ----- struct-access-uses-logical-names-not-rule-or-storage-names-1
// run: opgen-error
// check: unknown field PtrIndexImm.unknown
struct PtrIndexImm {
    offset: i32,
    scale: u32,
}

struct PtrIndex {
    ptr: Value,
    index: Value,
    imm_id: PtrIndexImm,
}

op PtrIndex(ptr: PTR, index: ScalarInteger, @imm: PtrIndexImm) -> PTR {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "ptr-index",
    storage: PtrIndex { ptr: ptr, index: index, imm_id: imm },
    text: "{ptr}, {index}, scale={imm.scale}, offset={imm.offset}",

    verify {
        require(imm.unknown != 0, "ptr-index scale must be non-zero");
    }
}

// ----- type-queries-use-static-signatures-and-operand-positions-1
// run: opgen-error
// check: constraint is always false: is_ptr(type(input))
struct Unary { arg: Value }
op Example<T: Integer>(input: T) -> T {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "example", storage: Unary { arg: input },
    verify {
        is_ptr(type(input)); lanes(type(input)) > 0;
    }
}
