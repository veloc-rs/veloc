// ----- helpers-share-verification-query-and-metadata-expressions
// run: opgen
// check: impl InstructionQuery for Summary
// check: checked_mul(2u64)
// check: count: 14
// check: valid: true
struct Info { count: u64, valid: bool, memory: MemoryEffect }
interface Summary { count: u64 }
fn Twice(n: u64) -> u64 { value: n * 2 }
fn Positive(n: u64) -> bool { value: 0 < n }
struct Data { n: u64 }
op Example(@n: u64) -> () {
    meta: Info { count: Twice(7), valid: Positive(Twice(7)), memory: Known([]) },
    mnemonic: "example", storage: Data { n: n },
    implements: [Summary { count: Twice(n) }],
    verify {
        require(Positive(Twice(n)), "expected a positive doubled value");
    }
}

// ----- metadata-preserves-full-width-signed-integers
// run: opgen
// check: high: 18446744073709551615
// check: low: -7
struct Info { high: u64, low: i64, memory: MemoryEffect }
fn High() -> u64 { value: 18446744073709551615 }
fn Low() -> i64 { value: -7 }
struct Empty {}
op Example() -> () {
    meta: Info { high: High(), low: Low(), memory: Known([]) },
    mnemonic: "example", storage: Empty {},
}

// ----- invalid-helper-result-is-still-type-checked
// run: opgen-error
// check: projection type mismatch
fn Nonzero(n: u32) -> bool { value: n }

// ----- helper-does-not-silently-narrow-arguments
// run: opgen-error
// check: projection type mismatch
struct Data { n: u64 }
op Example(@n: u64) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "example", storage: Data { n: n },
    verify {
        require(is_power_of_two(n), "bad alignment");
    }
}

// ----- helpers-cannot-shadow-primitives
// run: opgen-error
// check: function conflicts with a projection primitive
fn lanes(n: u32) -> u32 { value: n }

// ----- legacy-constraints-have-no-compatibility-layer
// run: opgen-error
// check: use a verify block instead of constraints
property Int { constraints: [true] }

// ----- query-emits-declared-host-calls
// run: opgen
// check: crate::host::traits::Module::params(&_host, (crate::host::traits::Module::signature
interface Summary { count: i128 }
struct Data { function: FuncId }
op Example(@function: FuncId) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "example", storage: Data { function: function },
    implements: [Summary { count: len(Module.params(Module.signature(function)?)?) }],
}
