// ----- function-reference-is-not-a-single-token
// run: opgen-error
// check: space requires two single-token atoms
format RefTag {
    fields: [op(Opcode), target(FuncId), tag(u32)], opcode: dynamic(op)
}
op RefTag(@target: FuncId, @tag: u32) -> () {
    mnemonic: "ref-tag", storage: RefTag { target: target, tag: tag },
    text: Text { args: [space(target, tag)] }, memory: NONE
}
