// ----- storage/lir-mappings-can-reorder-inputs-and-results
// run: opgen
// check: pub fn pair(self, low: Writable<Reg>, high: Writable<Reg>, first: Reg, second: Reg)
// check: MachineOperand::Use(second), MachineOperand::Def(high), MachineOperand::Use(first), MachineOperand::Def(low)
storage Operands { prefix: "G_" }
struct Pair { right: Use, upper: Def, left: Use, lower: Def }
op G_PAIR(first: Type::I32, second: Type::I64) -> (low: Type::I32, high: Type::I64) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    storage: Pair { right: second, upper: high, left: first, lower: low },
}

// ----- storage/empty-mappings-are-explicit
// run: opgen
// check: pub fn stop(self, )
storage Operands { prefix: "G_" }
struct Empty {}
op G_STOP() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Empty {} }

// ----- storage/bare-layout-names-are-removed
// run: opgen-error
// check: expected storage: Layout
storage Operands {}
struct Empty {}
op Example() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Empty }

// ----- storage/missing-result-binding
// run: opgen-error
// check: result 0 has no storage mapping
storage Operands {}
struct Input { arg: Use }
op Example(arg: Type::I32) -> (value: Type::I32) { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Input { arg } }

// ----- storage/repeated-result-binding
// run: opgen-error
// check: result 'first' is stored more than once
storage Operands {}
struct Pair { a: Def, b: Def }
op Example() -> (first: Type::I32, second: Type::I32) { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Pair { a: first, b: first } }

// ----- storage/repeated-input-binding
// run: opgen-error
// check: input 'arg' is stored more than once
storage Operands {}
struct Pair { a: Use, b: Use }
op Example(arg: Type::I32) -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Pair { a: arg, b: arg } }

// ----- storage/definition-fields-cannot-bind-inputs
// run: opgen-error
// check: unknown result 'arg'
storage Operands {}
struct Output { dst: Def }
op Example(arg: Type::I32) -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Output { dst: arg } }

// ----- storage/optional-presence-is-not-inferred
// run: opgen-error
// check: expected some(...) storage binding
storage Operands {}
struct Maybe { value: OptionalUse }
op Example(value: Type::I32) -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Maybe { value } }

// ----- storage/omitted-operands-must-be-a-suffix
// run: opgen-error
// check: only trailing optional operands may be absent
storage Operands {}
struct Pair { optional: OptionalUse, required: Use }
op Example(value: Type::I32) -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Pair { optional: none, required: value } }

// ----- storage/tied-input-and-output-are-explicit
// run: opgen
// check: pub fn update(self, next: Writable<Reg>, previous: Reg)
// check: MachineOperand::Def(next)
storage Operands { prefix: "G_" }
struct Update { next: Def, previous: Use }
op G_UPDATE(previous: Type::PTR) -> (next: Type::PTR) { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Update { next, previous } }

// ----- storage/absent-optional-fields-still-require-a-mapping
// run: opgen-error
// check: missing storage field 'value'
storage Operands {}
struct Maybe { value: OptionalUse }
op Example() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, storage: Maybe {} }

// ----- storage/declaration-fields-do-not-use-value-shorthand
// run: opgen-error
// check: expected `:`
struct Bad { value }

// ----- encodings/packed-overflow
// run: opgen-error
// check: fit u8
encoding Packed { storage: u8, fields: [low(4), high(5)] }

// ----- encodings/zero-width
// run: opgen-error
// check: positive widths
encoding Packed { storage: u16, fields: [low(0)] }

// ----- encodings/repeated-field
// run: opgen-error
// check: duplicate bit field `low`
encoding Packed { storage: u16, fields: [low(4), low(4)] }

// ----- encodings/method-conflict
// run: opgen-error
// check: duplicate encoding method `is_enabled`
encoding Packed { storage: u16, fields: [enabled(1), is_enabled(4)] }

// ----- encodings/reserved-method
// run: opgen-error
// check: duplicate encoding method `empty`
encoding Packed { storage: u8, fields: [empty(2)] }

// ----- encodings/unknown-field
// run: opgen-error
// check: unknown field `typo`
encoding Packed { storage: u8, fields: [value(8)], typo: 1 }

// ----- encodings/type-conflict
// run: opgen-error
// check: bit layout `Opcode` conflicts
encoding Opcode { storage: u8, fields: [] }

// ----- records/legacy-struct-fields-are-rejected
// run: opgen-error
// check: expected data type name
struct Settings { fields: [budget(u8, 1)] }

// ----- records/struct-defaults-are-rejected
// run: opgen-error
// check: expected `,`
struct Settings { budget: u8 = 1 }

// ----- records/optional-fields-must-be-explicit
// run: opgen-error
// check: missing field `budget`
struct Settings { budget: optional(u32) }
struct Work {  }
op Work() -> () {
    meta: Settings {}, mnemonic: "work", storage: Work {}
}

// ----- records/fixed-text-binding-is-range-checked
// run: opgen-error
// check: fixed text binding requires an in-range integer literal
struct Settings { scale: u8 }
struct Work { settings: Settings }
op Work(settings: Settings) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "work", storage: Work { settings: settings },
    text: "{settings.scale=256}"
}

// ----- records/fixed-text-binding-cannot-also-consume-input
// run: opgen-error
// check: text field `settings.scale` is consumed more than once
struct Settings { scale: u8 }
struct Work { settings: Settings }
op Work(settings: Settings) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "work", storage: Work { settings: settings },
    text: "{settings.scale=1} {settings.scale}"
}


// ----- records/struct-without-instruction-use-is-plain-data
