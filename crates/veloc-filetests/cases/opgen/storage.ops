// ----- packing/pooled-value-lists-and-inline-arrays-keep-distinct-bindings-1
// run: opgen-error
// check: storage field `args` requires 3 arguments
struct Triple { args: values(3) }
op Triple<T: Integer>(a: T, b: T, c: T) -> (result: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "triple", storage: Triple { args: [a, b] }, }

// ----- packing/pooled-value-lists-and-inline-arrays-keep-distinct-bindings-2
// run: opgen-error
// check: parameter `a` is stored more than once
struct Triple { args: values(3) }
op Triple<T: Integer>(a: T, b: T, c: T) -> (result: T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "triple", storage: Triple { args: [a, a, c] }, }

// ----- packing/signature-sources-are-explicit-and-match-their-parameter-types-1
// run: opgen-error
// check: signature results require an explicit signature source
struct Invoke {
    callee: FuncId,
    args: ValueList,
}
op Invoke(callee: FuncId, args: sequence(Value)) -> signature {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    mnemonic: "invoke", storage: Invoke { callee: callee, args: args },
}

// ----- packing/signature-sources-are-explicit-and-match-their-parameter-types-2
// run: opgen-error
// check: signature source `callee` must be a SigId property
struct Invoke {
    callee: FuncId,
    args: ValueList,
}
op Invoke(callee: FuncId, args: sequence(Value)) -> signature {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    mnemonic: "invoke", storage: Invoke { callee: callee, args: args },
signature: callee, }

// ----- packing/signature-sources-are-explicit-and-match-their-parameter-types-3
// run: opgen-error
// check: signature source `missing` must be a FuncId property
struct Invoke {
    callee: FuncId,
    args: ValueList,
}
op Invoke(callee: FuncId, args: sequence(Value)) -> signature {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    mnemonic: "invoke", storage: Invoke { callee: callee, args: args },
signature: function(missing), }

// ----- packing/signature-sources-are-explicit-and-match-their-parameter-types-4
// run: opgen-error
// check: signature source requires signature results
struct Invoke {
    callee: FuncId,
    args: ValueList,
}
op Invoke(callee: FuncId, args: sequence(Value)) -> () {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    mnemonic: "invoke", storage: Invoke { callee: callee, args: args },
signature: function(callee), }

// ----- packing/tables-require-distinct-case-and-default-roles-1
// run: opgen-error
// check: expected parameter, array, pool(parameter) or table(cases, default)
struct Table {
    index: Value,
    table: JumpTable,
}
op Table(index: Type::I32, cases: successors, default: successor) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    mnemonic: "table", storage: Table { index: index, table: table(cases) },
}

// ----- packing/tables-require-distinct-case-and-default-roles-2
// run: opgen-error
// check: parameter `cases` is stored more than once
struct Table {
    index: Value,
    table: JumpTable,
}
op Table(index: Type::I32, cases: successors, default: successor) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    mnemonic: "table", storage: Table { index: index, table: table(cases, cases) },
}

// ----- packing/tables-require-distinct-case-and-default-roles-3
// run: opgen-error
// check: parameter `default` is incompatible with storage field `table`
struct Table {
    index: Value,
    table: JumpTable,
}
op Table(index: Type::I32, cases: successors, default: successors) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    mnemonic: "table", storage: Table { index: index, table: table(cases, default) },
}

// ----- packing/tables-require-distinct-case-and-default-roles-4
// run: opgen-error
// check: parameter `cases` is incompatible with storage field `table`
struct Table {
    index: Value,
    table: JumpTable,
}
op Table(index: Type::I32, cases: successors, default: successor) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::NONE },
    mnemonic: "table", storage: Table { index: index, table: cases },
}

// ----- packing/writer-constructor-name-collision
// run: opgen-error
// check: conflicting instruction constructor `a_b`
struct AB {  }
op AB() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "ab", storage: AB {} }
struct A_b {  }
op A_b() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "a_b", storage: A_b {} }

// ----- packing/writer-constructor-api-collision
// run: opgen-error
// check: conflicting instruction constructor `copy`
struct Copy {  }
op Copy() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "operands", storage: Copy {} }

// ----- packing/draft-constructor-keyword
// run: opgen-error
// check: invalid generated identifier `match`
struct Match {  }
op Match() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "match", storage: Match {} }

// ----- packing/field-contract-rejects-cycles
// run: opgen-error
// check: cyclic field reference
type Recursive = rust("crate::Value") { field: list(Recursive), }

// ----- packing/edge-contract-requires-ssa-parameters
// run: opgen-error
// check: edge parameters require an SSA operand element
type Tag = rust("crate::Tag");
type BadEdge = rust("crate::inst::Successor") { field: edge(Tag), }

// ----- packing/field-contract-rejects-unknown-types
// run: opgen-error
// check: field reference requires a declared Rust type
type Missing = rust("crate::Value") { field: list(NotDeclared), }

// ----- packing/field-contract-rejects-unsupported-nested-rust-views
// run: opgen-error
// check: unsupported nested Rust field interface
type Nested = rust("crate::inst::Arguments") { field: list(list(Value)), }

// ----- packing/field-contract-removes-role-labels
// run: opgen-error
// check: unknown field `role`
type Legacy = rust("crate::Value") { role: ssa, }

// ----- builders/impossible-type-variable-constraints-are-definition-errors-1
// run: opgen-error
// check: impossible element constraint on type variable `T`
struct Pair {
    args: values(2),
}
op Add<T: ScalarInteger>(lhs: T, rhs: T) -> (result: element(T)) {
    meta: OpInfo { traits: OpTraits::empty(), memory: MemoryEffect::NONE },
    mnemonic: "pair-add", storage: Pair { args: [lhs, rhs] },
}

// ----- builders/impossible-type-variable-constraints-are-definition-errors-2
// run: opgen-error
// check: impossible vector constraint on type variable `T`
struct Pair {
    args: values(2),
}
op Add<T: Vector>(lhs: T, rhs: T) -> (result: vector(T)) {
    meta: OpInfo { traits: OpTraits::empty(), memory: MemoryEffect::NONE },
    mnemonic: "pair-add", storage: Pair { args: [lhs, rhs] },
}

// ----- builders/impossible-type-variable-constraints-are-definition-errors-3
// run: opgen-const-error
// check: no admissible type signature
struct Pair {
    args: values(2),
}
op Add<T: ScalarInteger, U: Vector>(lhs: T, rhs: T) -> (result: U) {
    verify { require(U.same_shape(T), "input and result must have the same shape"); }
    meta: OpInfo { traits: OpTraits::empty(), memory: MemoryEffect::NONE },
    mnemonic: "pair-add", storage: Pair { args: [lhs, rhs] },
}

// ----- builders/normalizing-mnemonics-cannot-create-duplicate-methods-1
// run: opgen-error
// check: mnemonics `pair-add` and `pair_add` produce the same method name `pair_add`
struct Pair {
    args: values(2),
}
op Add<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { traits: OpTraits::empty(), memory: MemoryEffect::NONE },
    mnemonic: "pair-add", storage: Pair { args: [lhs, rhs] },
}

op Other<T: Integer>(lhs: T, rhs: T) -> (result: T) {
    meta: OpInfo { traits: OpTraits::empty(), memory: MemoryEffect::NONE },
mnemonic: "pair_add", storage: Pair { args: [lhs, rhs] },  }
