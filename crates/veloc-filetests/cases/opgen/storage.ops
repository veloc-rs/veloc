// check: pub struct Operands
// check: pub budget: u32
struct Operands { budget: u32 }

// ----- records/legacy-format-declaration-is-rejected
// run: opgen-error
// check: unknown definition kind `format`
format Pair {}

// ----- records/opcode-is-not-a-struct-type
// run: opgen-error
// check: unknown data type `Opcode`
struct Pair { opcode: Opcode, args: values(2) }

// ----- records/alternate-layout-requires-a-struct
// run: opgen-error
// check: unknown layout struct `Alternate`
struct Pair { args: values(2) }
layout Alternate { format: fixed(Pair), text: "{args}" }

// ----- records/lir-layout-overrides-are-rejected
// run: opgen-error
// check: operand views are derived from structs
storage Operands {}
layout Missing { accessor: missing }

// ----- packing/writer-method-name-is-reserved
// run: opgen-error
// check: conflicting instruction constructor `write`
struct Write {

}
op Write() -> () { meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "write", storage: Write {} }

// ----- packing/pool-bindings-are-typed-and-consume-the-complete-struct-1
// run: opgen-error
// check: unbound type variable `PtrIndexImm`
struct PtrIndexImm {
    offset: i32,
    scale: u32,
}
struct Indexed {
    ptr: Value,
    index: Value,
    imm_id: PtrIndexImm,
}
op Indexed(ptr: Type::PTR, index: Type::I32, imm: PtrIndexImm) -> (result: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: pool() },
}

// ----- packing/pool-bindings-are-typed-and-consume-the-complete-struct-2
// run: opgen-error
// check: parameter `imm` is incompatible with storage field `imm_id`
struct PtrIndexImm {
    offset: i32,
    scale: u32,
}
struct Indexed {
    ptr: Value,
    index: Value,
    imm_id: PtrIndexImm,
}
op Indexed(ptr: Type::PTR, index: Type::I32, imm: Bytes) -> (result: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: imm },
}

