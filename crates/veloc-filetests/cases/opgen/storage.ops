op Indexed(ptr: Type::PTR, index: Type::I32, imm: PtrIndexImm, unused: PtrIndexImm) -> (result: Type::PTR) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: imm },
}

