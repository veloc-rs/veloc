// ----- algebraic-constants-are-typed-and-names-round-trip-1
// run: opgen-error
// check: unknown algebraic constant `Two`
format Args { fields: [opcode(Opcode), args(values(2))], opcode: dynamic(opcode) }
op Test<T: Integer>(lhs: T, rhs: T) -> (result: T) {
             mnemonic: "test", storage: Args { args: [lhs, rhs] }, memory: NONE,
             semantics: bv.add(lhs, rhs), identity: Two
         }

// ----- rejects-incorrect-identity-and-absorbing-constants-1
// run: opgen-error
// check: bv.add does not support identity `One` at every supported width
format Args { fields: [opcode(Opcode), args(values(2))], opcode: dynamic(opcode) }
op Test<T: Integer>(lhs: T, rhs: T) -> (result: T) {
             mnemonic: "test", storage: Args { args: [lhs, rhs] }, memory: NONE,
             semantics: bv.add(lhs, rhs), traits: [COMMUTATIVE, ASSOCIATIVE], identity: One
         }

