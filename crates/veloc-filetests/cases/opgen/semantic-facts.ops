// check: bv.neg does not support trait `COMMUTATIVE` at every supported width
format Args { fields: [opcode(Opcode), args(values(1))], opcode: dynamic(opcode) }
op Test<T: Integer>(arg: T) -> (result: T) {
             mnemonic: "test", storage: Args { args: [arg] }, memory: NONE,
             semantics: bv.neg(arg), traits: [COMMUTATIVE]
         }

