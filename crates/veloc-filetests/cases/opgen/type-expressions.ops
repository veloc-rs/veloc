// ----- semantics-and-text-codecs-use-resolved-inline-constraints-1
// run: opgen-error
// check: invalid semantic types [Bool, Bool] -> [Bool]: expected a bitvector, got bool
format Pair { fields: [opcode(Opcode), args(values(2))], opcode: dynamic(opcode) }
op Add<T: BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> T {
    mnemonic: "add", storage: Pair { args: [lhs, rhs] }, semantics: bv.add(lhs, rhs)
}

// ----- semantics-and-text-codecs-use-resolved-inline-constraints-2
