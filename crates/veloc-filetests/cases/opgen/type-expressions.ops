// ----- direct-patterns-and-shape-constraints-accept-expressions-1
// run: opgen-error
// check: impossible shape constraint on type variable `T`
format Unary { fields: [opcode(Opcode), arg(Value)], opcode: dynamic(opcode) }
op Copy(arg: I32 | I64) -> I32 | I64 {
    mnemonic: "copy", storage: Unary { arg: arg }, memory: NONE
}
op Lane<T: vectors(I32 | I64)>(arg: T) -> element(T) {
    mnemonic: "lane", storage: Unary { arg: arg }, memory: NONE
}
op Convert<T: I32 | I64>(arg: T) -> shape(T, Float & Vector) {
    mnemonic: "convert", storage: Unary { arg: arg }, memory: NONE
}

// ----- direct-patterns-and-shape-constraints-accept-expressions-2
// run: opgen-error
// check: unknown type or class `T`
format Unary { fields: [opcode(Opcode), arg(Value)], opcode: dynamic(opcode) }
op Copy(arg: I32 | I64) -> I32 | I64 {
    mnemonic: "copy", storage: Unary { arg: arg }, memory: NONE
}
op Lane<T: vectors(T)>(arg: T) -> element(T) {
    mnemonic: "lane", storage: Unary { arg: arg }, memory: NONE
}
op Convert<T: I32 | I64>(arg: T) -> shape(T, Float & Scalar) {
    mnemonic: "convert", storage: Unary { arg: arg }, memory: NONE
}

// ----- expression-nesting-is-bounded-but-flat-unions-are-not-recursive-1
// run: opgen-error
// check: definition nesting exceeds 64 levels
format Pair { fields: [opcode(Opcode), args(values(2))], opcode: dynamic(opcode) }
op Add<T: ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((I32))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))>(lhs: T, rhs: T) -> T {
    mnemonic: "add", storage: Pair { args: [lhs, rhs] }, semantics: bv.add(lhs, rhs)
}

