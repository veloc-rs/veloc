// ----- semantics-and-text-codecs-use-resolved-inline-constraints-3
// run: opgen-error
// check: float text atoms require a scalar float first result
struct Literal { value: Float }
op Literal<T: Float & Vector>(@value: Float) -> T {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "literal", storage: Literal { value: value },
}
