// ----- direct-patterns-and-shape-constraints-accept-expressions-1
// run: opgen-error
// check: constraint is always false
struct Unary { arg: Value }
op Copy(arg: Type.I32 | Type.I64) -> Type.I32 | Type.I64 {
    meta: OpInfo { memory: Known([]) },
mnemonic: "copy", storage: Unary { arg: arg }, }
op Lane<T: vectors(Type.I32 | Type.I64)>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
mnemonic: "lane", storage: Unary { arg: arg }, }
op Convert<T: Type.I32 | Type.I64, U: Float & Vector>(arg: T) -> U {
    verify { require(U.same_shape(T), "input and result must have the same shape"); }
    meta: OpInfo { memory: Known([]) },
mnemonic: "convert", storage: Unary { arg: arg }, }

// ----- direct-patterns-and-shape-constraints-accept-expressions-2
// run: opgen-error
// check: unknown type or typeset `T`
struct Unary { arg: Value }
op Copy(arg: Type.I32 | Type.I64) -> Type.I32 | Type.I64 {
    meta: OpInfo { memory: Known([]) },
mnemonic: "copy", storage: Unary { arg: arg }, }
op Lane<T: vectors(T)>(arg: T) -> element(T) {
    meta: OpInfo { memory: Known([]) },
mnemonic: "lane", storage: Unary { arg: arg }, }
op Convert<T: Type.I32 | Type.I64, U: Float & Scalar>(arg: T) -> U {
    verify { require(U.same_shape(T), "input and result must have the same shape"); }
    meta: OpInfo { memory: Known([]) },
mnemonic: "convert", storage: Unary { arg: arg }, }

// ----- expression-nesting-is-bounded-but-flat-unions-are-not-recursive-1
// run: opgen-error
// check: definition nesting exceeds 64 levels
struct Pair { args: values(2) }
op Add<T: ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((Type.I32))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "add", storage: Pair { args: [lhs, rhs] }, semantics: bv.add(lhs, rhs)
}

