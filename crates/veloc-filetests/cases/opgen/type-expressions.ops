struct Pair { args: values(2) }
op Add<T: BOOL | vectors(BOOL)>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "add", storage: Pair { args: [lhs, rhs] }, semantics: bv.add(lhs, rhs)
}

