struct Info { count: u32, memory: MemoryEffect }
struct Empty {}
op Example() -> () {
    meta: Info { count: field(Summary, count), memory: MemoryEffect::NONE },
    implements(ctx: Numbers): [Summary { count: Count(ctx, 1) }],
    mnemonic: "example", storage: Empty {},
}

