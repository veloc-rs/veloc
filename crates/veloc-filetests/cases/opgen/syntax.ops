// ----- comments-and-adjacent-delimiters
// run: opgen
// check: pub fn example
struct Example{value:u32,}
op Example(@value:u32,)->I32{
    meta:OpInfo{memory:Known([]),}, // 中文注释
    mnemonic:"example",storage:Example{value:value,},
    verify {
        require(value>=0&&value<=4294967295,"valid // not a comment");
    },
}

// ----- an-arrow-is-one-token
// run: opgen-error
// check: expected `->`
op Example() - > () {}

// ----- constraint-number-range
// run: opgen-error
// check: expression integer is out of range
struct Empty {}
op Example() -> () {
    meta: OpInfo { memory: Known([]) }, mnemonic: "example", storage: Empty {},
    verify {
        170141183460469231731687303715884105728 > 0;
    }
}

// ----- definition-number-range
// run: opgen-error
// check: integer is out of range
encoding TooWide { storage: u64, fields: [bits(4294967296)] }

// ----- escaped-string-is-not-structural-syntax
// run: opgen
// check: pub fn empty
struct Empty {}
op Example() -> () {
    meta: OpInfo { memory: Known([]) }, mnemonic: "example", storage: Empty {},
    verify {
        require(true, "quotes: \" / slash: \\ / newline: \n / UTF-8: 字符 } ]");
    },
}

// ----- invalid-string-escape
// run: opgen-error
// check: invalid string escape
struct Empty {}
op Example() -> () {
    meta: OpInfo { memory: Known([]) }, storage: Empty {},
    mnemonic: "bad\q"
}
