// ----- pool-bindings-are-typed-and-consume-the-complete-record-1
// run: opgen-error
// check: expected parameter, array, pool(parameter) or table(cases, default)
record PtrIndexImm {
    storage: PtrIndexImmId, fields: [offset(i32, 0), scale(u32, 1)]
}
format Indexed {
    fields: [opcode(Opcode), ptr(Value), index(Value), imm_id(PtrIndexImmId)],
    opcode: dynamic(opcode)
}
op Indexed(ptr: PTR, index: I32, @imm: PtrIndexImm) -> (result: PTR) {
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: pool() },
    memory: NONE
}

// ----- pool-bindings-are-typed-and-consume-the-complete-record-2
// run: opgen-error
// check: parameter `imm` is incompatible with storage field `imm_id`
record PtrIndexImm {
    storage: PtrIndexImmId, fields: [offset(i32, 0), scale(u32, 1)]
}
format Indexed {
    fields: [opcode(Opcode), ptr(Value), index(Value), imm_id(PtrIndexImmId)],
    opcode: dynamic(opcode)
}
op Indexed(ptr: PTR, index: I32, @imm: Bytes) -> (result: PTR) {
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: pool(imm) },
    memory: NONE
}

// ----- pool-bindings-are-typed-and-consume-the-complete-record-3
// run: opgen-error
// check: parameter `unused` has no storage mapping
record PtrIndexImm {
    storage: PtrIndexImmId, fields: [offset(i32, 0), scale(u32, 1)]
}
format Indexed {
    fields: [opcode(Opcode), ptr(Value), index(Value), imm_id(PtrIndexImmId)],
    opcode: dynamic(opcode)
}
op Indexed(ptr: PTR, index: I32, @imm: PtrIndexImm, @unused: PtrIndexImm) -> (result: PTR) {
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: pool(imm) },
    memory: NONE
}

// ----- pool-bindings-are-typed-and-consume-the-complete-record-4
// run: opgen-error
// check: parameter `imm` is stored more than once
record PtrIndexImm {
    storage: PtrIndexImmId, fields: [offset(i32, 0), scale(u32, 1)]
}
format Indexed {
    fields: [opcode(Opcode), ptr(Value), index(Value), imm_id(PtrIndexImmId), other(PtrIndexImmId)],
    opcode: dynamic(opcode)
}
op Indexed(ptr: PTR, index: I32, @imm: PtrIndexImm) -> (result: PTR) {
    mnemonic: "indexed", storage: Indexed { ptr: ptr, index: index, imm_id: pool(imm), other: pool(imm) },
    memory: NONE
}

