// ----- pooled-value-lists-and-inline-arrays-keep-distinct-bindings-1
// run: opgen-error
// check: storage field `args` requires 3 arguments
record Triple { args: values(3) }
op Triple<T: Integer>(a: T, b: T, c: T) -> (result: T) {
    meta: OpInfo { memory: Known([]) },
mnemonic: "triple", storage: Triple { args: [a, b] }, }

