// ----- control-is-not-a-separate-operation-contract
// run: opgen-error
// check: unknown field `control`
struct Apply { cont: Value, args: ValueList }
op Apply(cont: Callable, args: values) -> () {
    meta: OpInfo { traits: [TERMINATOR, MAY_TRAP], memory: Unknown },
    mnemonic: "apply", storage: Apply { cont, args },
    control: tail_call_value(cont, args),
}

// ----- structural-type-name-cannot-be-shadowed
// run: opgen-error
// check: Callable is a reserved structural type name
class Callable { members: [I32] }

// ----- move-contract-rejects-properties
// run: opgen-error
// check: move requires a value operand
struct Take { function: FuncId }
op Take(@move function: FuncId) -> () {
    meta: OpInfo { memory: Unknown },
    mnemonic: "take", storage: Take { function: function },
}

// ----- abort-is-an-exit-contract
// run: opgen-error
// check: ABORT requires TERMINATOR
struct Stop {  }
op Stop() -> () {
    meta: OpInfo { traits: [ABORT], memory: Known([]) },
mnemonic: "stop", storage: Stop {},  }

// ----- signature-query-is-typed
// run: opgen-error
// check: projection type mismatch: expected Named("FuncId"), found Named("u32")
struct Check { n: u32 }
op Check(@n: u32) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "check", storage: Check { n: n },
    verify {
        len(Module.params(Module.signature(n)?)?) == 0;
    }
}

// ----- slice-query-is-typed
// run: opgen-error
// check: slice expects a sequence
struct Check { n: u32 }
op Check(@n: u32) -> () {
    meta: OpInfo { memory: Known([]) },
    mnemonic: "check", storage: Check { n: n },
    verify {
        len(prefix(n, 0)) == 0;
    }
}
