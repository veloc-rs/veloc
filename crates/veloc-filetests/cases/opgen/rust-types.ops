// ----- declared-paths-are-shared-by-fields-and-host-signatures
// run: opgen
// check: fn read(&self, value: crate::tokens::Token) -> Option<crate::tokens::Token>
// check: pub value: crate::tokens::Token
// check: Some(crate::tokens::Token)
type Token = rust("crate::tokens::Token");
extern interface Tokens { fn read(value: Token) -> optional(Token); }
struct Entry { value: Token }
enum EntryResult { variants: [Some(Token), None] }

// ----- foreign-types-are-not-ssa-types
// run: opgen-error
// check: Token
type Token = rust("crate::tokens::Token");
struct Empty {}
op Example() -> Token {
    mnemonic: "example", meta: OpInfo { memory: Known([]) }, storage: Empty {},
}

// ----- foreign-types-are-not-structural-type-aliases
// run: opgen-error
// check: TOKEN
type TOKEN = rust("crate::tokens::Token");
type BAD = vector(TOKEN, 4);

// ----- foreign-types-are-nominal
// run: opgen-error
// check: projection type mismatch
type First = rust("crate::tokens::Token");
type Second = rust("crate::tokens::Token");
extern interface Tokens { fn first() -> First; }
fn wrong() -> Second { value: Tokens.first() }

// ----- foreign-types-have-no-implicit-fields
// run: opgen-error
// check: field
type Token = rust("crate::tokens::Token");
fn wrong(token: Token) -> u32 { value: token.number }

// ----- foreign-types-have-no-implicit-arithmetic
// run: opgen-error
// check: unsupported expression operator or operand type
type Token = rust("crate::tokens::Token");
fn wrong(token: Token) -> Token { value: token + token }

// ----- binding-needs-one-path
// run: opgen-error
// check: rust requires one type path string
type Token = rust();

// ----- path-is-not-rust-code
// run: opgen-error
// check: identifier
type Token = rust("crate::Token; panic!()");

// ----- binding-cannot-shadow-a-primitive
// run: opgen-error
// check: conflicts with a built-in type
type u32 = rust("crate::Token");

// ----- binding-cannot-duplicate-generated-data
// run: opgen-error
// check: duplicate data type
type Token = rust("crate::tokens::Token");
struct Token { number: u32 }

// ----- binding-does-not-silently-declare-other-types
// run: opgen-error
// check: unknown projection type
extern interface Tokens { fn read(value: Undeclared) -> u32; }
