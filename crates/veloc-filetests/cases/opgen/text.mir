// ----- logical-order
// run: fixture
// check: v2: i32 = difference v0, v1
// check: v3: i32 = reverse-text v1, v0
// check: return v2, v3
local function order(i32, i32) -> (i32, i32)
block0(v0: i32, v1: i32):
  v2: i32 = difference v0, v1
  v3: i32 = reverse-text v1, v0
  return v2, v3

// ----- named-default
// run: fixture
// check: v1: ptr = offset v0
// nextln: v2: ptr = offset v0, amount=8
// not: amount=7
// check: return v1, v2
local function offsets(ptr) -> (ptr, ptr)
block0(v0: ptr):
  v1: ptr = offset v0, amount=7
  v2: ptr = offset v0, amount=8
  return v1, v2

// ----- alternate-layout
// run: fixture
// check: v2: i32 = difference v0, v1, tag=9
// check: return v2
local function extended(i32, i32) -> i32
block0(v0: i32, v1: i32):
  v2: i32 = difference v0, v1, tag=9
  return v2

// ----- anonymous-and-named-results
// run: fixture
// check: (v2: i32, v3: i64) = wide-pair v0, v1
// check: return v2, v3
local function wide(i32, i32) -> (i32, i64)
block0(v0: i32, v1: i32):
  (v2: i32, v3: i64) = wide-pair v0, v1
  return v2, v3

// ----- relation-on-second-result
// run: fixture-validate-error
// check: wide must have more bits per lane than lhs
local function wide(i64, i64) -> (i64, i64)
block0(v0: i64, v1: i64):
  (v2: i64, v3: i64) = wide-pair v0, v1
  return v2, v3

// ----- inline-types-and-shapes
// run: fixture
// check: v2: i32 = named v0, v0
// check: v3: i32 = inline v0, v2
// check: v4: i64 = lane v1
// check: v5: f32 = convert v0
// check: return v3, v4, v5
local function types(i32, i64<4>) -> (i32, i64, f32)
block0(v0: i32, v1: i64<4>):
  v2: i32 = named v0, v0
  v3: i32 = inline v0, v2
  v4: i64 = lane v1
  v5: f32 = convert v0
  return v3, v4, v5
