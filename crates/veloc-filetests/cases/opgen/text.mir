// ----- logical-order
// run: fixture
// check: v2 = difference.i32 v0, v1
// check: v3 = reverse-text.i32 v1, v0
// check: return v2, v3
local function order(i32, i32) -> (i32, i32)
block0(v0: i32, v1: i32):
  v2 = difference v0, v1
  v3 = reverse-text v1, v0
  return v2, v3

// ----- named-default
// run: fixture
// check: v1 = offset.ptr v0
// nextln: v2 = offset.ptr v0, amount=8
// not: amount=7
// check: return v1, v2
local function offsets(ptr) -> (ptr, ptr)
block0(v0: ptr):
  v1 = offset v0, amount=7
  v2 = offset v0, amount=8
  return v1, v2

// ----- alternate-layout
// run: fixture
// check: v2 = difference.i32 v0, v1, tag=9
// check: return v2
local function extended(i32, i32) -> i32
block0(v0: i32, v1: i32):
  v2 = difference v0, v1, tag=9
  return v2

// ----- anonymous-and-named-results
// run: fixture
// check: (v2, v3) = wide-pair.i32 v0, v1
// check: return v2, v3
local function wide(i32, i32) -> (i32, i64)
block0(v0: i32, v1: i32):
  (v2, v3) = wide-pair v0, v1
  return v2, v3

// ----- relation-on-second-result
// run: fixture-error
// check: results[1] must have more bits per lane than operands[0]
local function wide(i64, i64) -> (i64, i64)
block0(v0: i64, v1: i64):
  (v2, v3) = wide-pair v0, v1
  return v2, v3

// ----- inline-types-and-shapes
// run: fixture
// check: v2 = named.i32 v0, v0
// check: v3 = inline.i32 v0, v2
// check: v4 = lane.i64 v1
// check: v5 = convert.f32 v0
// check: return v3, v4, v5
local function types(i32, i64<4>) -> (i32, i64, f32)
block0(v0: i32, v1: i64<4>):
  v2 = named v0, v0
  v3 = inline v0, v2
  v4 = lane v1
  v5 = convert.f32 v0
  return v3, v4, v5
