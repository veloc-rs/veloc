// ----- a-fixed-operand-after-a-variadic-group-is-an-explicit-definition-error-1
// run: opgen-error
// check: fixed operands must precede variadic operands and successors
format CallIndirect {
    fields: [ptr(Value), args(ValueList), sig_id(SigId)],
    opcode: fixed(CallIndirect)
}
op CallIndirect(@sig_id: SigId, args: values, ptr: PTR) -> signature {
    mnemonic: "call-indirect",
    storage: CallIndirect { ptr: ptr, args: args, sig_id: sig_id },
    text: Text { args: [invoke(ptr, args, sig_id)] },
    signature: sig_id,
    traits: [MAY_TRAP], memory: UNKNOWN
}

// ----- anonymous-results-have-no-synthetic-names-1
// run: opgen-error
// check: type relation references missing operand or result `result`
format Pair {
    fields: [op(Opcode), args(values(2))],
    opcode: dynamic(op)
}
op PairAdd<T: Integer>(left: T, right: T) -> Integer {
    mnemonic: "pair-add",
    storage: Pair { args: [left, right] },
    where: [wider(left, result)], memory: NONE
}

