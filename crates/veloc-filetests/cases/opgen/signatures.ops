// ----- signatures/a-fixed-operand-after-a-variadic-group-is-an-explicit-definition-error-1
// run: opgen-error
// check: fixed operands must precede variadic operands and successors
struct CallIndirect {
    ptr: Value,
    args: ValueList,
    sig_id: SigId,
}
op CallIndirect(sig_id: SigId, args: sequence(Value), ptr: Type::PTR) -> signature {
    meta: OpInfo { traits: OpTraits::MAY_TRAP, memory: MemoryEffect::UNKNOWN },
    mnemonic: "call-indirect",
    storage: CallIndirect { ptr: ptr, args: args, sig_id: sig_id },
    text: "{ptr}({args}) : {sig_id}",
    signature: sig_id,
}

// ----- signatures/anonymous-results-have-no-synthetic-names-1
// run: opgen-error
// check: unknown expression name or operation: result
struct Pair {
    args: values(2),
}
op PairAdd<T: Integer>(left: T, right: T) -> Integer {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "pair-add",
    storage: Pair { args: [left, right] },
verify {
        require(result.element_bits()? > left.ty().element_bits()?, "result must have more bits per lane than left");
    } }

// ----- signatures/anonymous-results-have-no-synthetic-names-2
// run: opgen-error
// check: unknown expression name or operation: result0
struct Pair {
    args: values(2),
}
op PairAdd<T: Integer>(left: T, right: T) -> Integer {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "pair-add",
    storage: Pair { args: [left, right] },
verify {
        require(result0.element_bits()? > left.ty().element_bits()?, "result0 must have more bits per lane than left");
    } }

