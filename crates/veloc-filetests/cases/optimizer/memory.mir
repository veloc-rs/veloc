// ----- scalar-promotion
// run: o1
// check: iconst 42
// not: alloca
// not: load
// not: store
local function main() -> i32
block0():
  p: ptr = alloca size=8, align=8
  q: ptr = ptr-offset p, 4
  x: i32 = iconst 42
  store x, q, offset=0
  y: i32 = load p, offset=4
  return y

// ----- unknown-call-is-a-barrier
// run: o1
// check: call mutate
// check: = load
import function mutate(ptr) -> void
local function main() -> i32
block0():
  p: ptr = alloca size=4, align=4
  x: i32 = iconst 1
  store x, p, offset=0
  call mutate(p) : (ptr) -> void
  y: i32 = load p, offset=0
  return y

// ----- volatile-is-observable
