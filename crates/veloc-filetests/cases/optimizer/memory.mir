// ----- scalar-promotion
// run: o1
// not: stack-slot
// check: return i32(42)
// not: load
// not: store
local function main() -> i32
stack-slot p, size=8, align=8
block0():
  q: ptr = ptr-offset p, 4
  store i32(42), q, offset=0
  y: i32 = load p, offset=4
  return y

// ----- unknown-call-is-a-barrier
// run: o1
// check: call mutate
// check: = load
import function mutate(ptr) -> void
local function main() -> i32
stack-slot p, size=4, align=4
block0():
  store i32(1), p, offset=0
  call mutate(p) : (ptr) -> void
  y: i32 = load p, offset=0
  return y

// ----- volatile-is-observable
// run: o1
// check: store.volatile
// check: load.volatile
local function main() -> i32
stack-slot p, size=4, align=4
block0():
  store.volatile i32(1), p, offset=0
  y: i32 = load.volatile p, offset=0
  return y

// ----- partial-overwrite-invalidates-forwarding
// run: o1
// check: : i32 = load
local function main() -> i32
stack-slot p, size=4, align=4
block0():
  store i32(1), p, offset=0
  store i8(2), p, offset=1
  y: i32 = load p, offset=0
  return y

// ----- unused-object-is-removable
// run: o1
// not: stack-slot
// check: return
local function main() -> void
stack-slot p, size=4096, align=64
block0():
  return

// ----- stack-access-at-slot-end
// run: o1
// not: stack-slot
// check: return i32(42)
local function main() -> i32
stack-slot p, size=8, align=8
block0():
  store.align4 i32(42), p, offset=4
  end: ptr = ptr-offset p, 8
  last: ptr = ptr-offset end, -4
  x: i32 = load.align4 last, offset=0
  return x
