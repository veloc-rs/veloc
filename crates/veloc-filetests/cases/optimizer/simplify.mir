// ----- algebra
// run: simplify
// check: function algebra($(arg=v\d+): i32)
// check: $(sum=v\d+): i32 = iadd $arg, $arg
// check: return $arg, $arg, $arg, i32(-1), i32(0), $sum
local function algebra(v0: i32) -> (i32, i32, i32, i32, i32, i32)
block0():
  v3: i32 = iadd v0, i32(0)
  v4: i32 = iadd i32(0), v3
  v5: i32 = iand v4, v4
  v6: i32 = ior v0, i32(-1)
  v7: i32 = imul v0, i32(0)
  v8: i32 = iadd v3, v4
  return v3, v4, v5, v6, v7, v8

// ----- retired-identities
// run: simplify
// check: function identities($(arg=v\d+): i64)
// check: return $arg, $arg, $arg
local function identities(v0: i64) -> (i64, i64, i64)
block0():
  v2: i64 = isub v0, i64(0)
  v3: i64 = isub v0, i64(0)
  v4: i64 = iadd v2, i64(0)
  v5: i64 = ior v3, v4
  return v2, v3, v5

// ----- nonconstant-operands
// run: simplify
// check: $(sum=v\d+): i32 = iadd
// check: return $sum, $sum
local function partial(v0: i32) -> (i32, i32)
block0():
  v2: i32 = iadd v0, i32(1)
  v3: i32 = iadd i32(1), v0
  return v2, v3

// ----- division-and-traps
// run: simplify
// check: $(overflow=v\d+): i32 = idiv-s
// check: $(zero_divisor=v\d+): i32 = idiv-u
// check: return $overflow, $zero_divisor, i32(-1073741824), i32(0)
local function division() -> (i32, i32, i32, i32)
block0():
  v4: i32 = idiv-s i32(-2147483648), i32(-1)
  v5: i32 = idiv-u i32(2), i32(0)
  v6: i32 = idiv-s i32(-2147483648), i32(2)
  v7: i32 = irem-s i32(-2147483648), i32(-1)
  return v4, v5, v6, v7

// ----- wrapping-chain
// run: simplify
// check: return i32(-2147483648), i32(2147483647), i32(-2147483647), i32(-2147483648), i32(-2147483648), i32(-2147483648), i32(-2147483647)
local function wrapping() -> (i32, i32, i32, i32, i32, i32, i32)
block0():
  v3: i32 = iadd i32(2147483647), i32(1)
  v4: i32 = ixor v3, i32(-1)
  v5: i32 = ineg v4
  v6: i32 = isub v5, i32(1)
  v7: i32 = imul v6, i32(-1)
  v8: i32 = iand v7, i32(-1)
  v9: i32 = ior v8, i32(1)
  return v3, v4, v5, v6, v7, v8, v9

// ----- multiple-results
// run: simplify
// check: return i64(-128), bool(true), bool(true), i8(-128)
local function typed() -> (i64, bool, bool, i8)
block0():
  (v2: i8, v3: bool) = iadd-with-overflow i8(127), i8(1)
  v4: i64 = extends v2
  v5: bool = icmp lts v2, i8(1)
  v6: i8 = wrap v4
  return v4, v3, v5, v6

// ----- select-partial
// run: simplify
// check: function select_partial($(c=v\d+): bool, $(x=v\d+): i64, $(y=v\d+): i64)
// check: return $x, $y, $x
local function select_partial(v0: bool, v1: i64, v2: i64) -> (i64, i64, i64)
block0():
  v3: i64 = select bool(true), v1, v2
  v4: i64 = select bool(false), v1, v2
  v5: i64 = select v0, v3, v1
  return v3, v4, v5

// ----- select-types
// run: simplify
// check: function select_types($(c=v\d+): bool, $(p=v\d+): ptr, $(f=v\d+): f64, $(v=v\d+): i32<4>)
// check: return $p, $f, $v
local function select_types(v0: bool, v1: ptr, v2: f64, v3: i32<4>) -> (ptr, f64, i32<4>)
block0():
  v4: ptr = select v0, v1, v1
  v5: f64 = select bool(true), v2, f64(0)
  v6: i32<4> = select bool(false), i32<4>(splat(0)), v3
  return v4, v5, v6
