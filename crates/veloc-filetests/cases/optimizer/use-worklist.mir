// ----- later-layout-definition
// run: simplify
// check: $(result=v\d+) = iconst.i32 12
// check: return $result
// check: iconst.i32 6
local function later() -> i32
block0():
  v0 = iconst.i32 6
  jump block2()
block1():
  v3 = iadd.i32 v0, v2
  return v3
block2():
  v1 = iconst.i32 2
  v4 = iconst.i32 4
  v2 = iadd v1, v4
  jump block1()

// ----- multiple-functions-same-shape
// run: o1
// check: function first
// check: $(first=v\d+) = iconst.i32 3
// check: return $first
// check: function second
// check: $(second=v\d+) = iconst.i32 15
// check: return $second
local function first() -> i32
block0():
  v0 = iconst.i32 1
  v1 = iconst.i32 2
  v2 = iadd v0, v1
  return v2
local function second() -> i32
block0():
  v0 = iconst.i32 7
  v1 = iconst.i32 8
  v2 = iadd v0, v1
  return v2
