local function later() -> i32
block0():
  v0: i32 = const 6
  jump block2()
block1():
  v3: i32 = iadd v0, v2
  return v3
block2():
  v1: i32 = const 2
  v4: i32 = const 4
  v2: i32 = iadd v1, v4
  jump block1()

