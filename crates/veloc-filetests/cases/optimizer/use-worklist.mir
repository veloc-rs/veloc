// ----- later-layout-definition
// run: simplify
// check: $(result=v\d+): i32 = iconst 12
// check: return $result
// check: : i32 = iconst 6
local function later() -> i32
block0():
  v0: i32 = iconst 6
  jump block2()
block1():
  v3: i32 = iadd v0, v2
  return v3
block2():
  v1: i32 = iconst 2
  v4: i32 = iconst 4
  v2: i32 = iadd v1, v4
  jump block1()

// ----- multiple-functions-same-shape
// run: o1
// check: function first
// check: $(first=v\d+): i32 = iconst 3
// check: return $first
// check: function second
// check: $(second=v\d+): i32 = iconst 15
// check: return $second
local function first() -> i32
block0():
  v0: i32 = iconst 1
  v1: i32 = iconst 2
  v2: i32 = iadd v0, v1
  return v2
local function second() -> i32
block0():
  v0: i32 = iconst 7
  v1: i32 = iconst 8
  v2: i32 = iadd v0, v1
  return v2
