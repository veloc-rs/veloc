// ----- aligned-derived-address
// run: execute
// check: returned: [0x2a]
local function main() -> i32
stack-slot p, size=128, align=64
block0():
  q: ptr = ptr-offset p, 64
  store.align64 i32(42), q, offset=0
  y: i32 = load.align64 p, offset=64
  return y

// ----- call-mutates-local-object
// run: execute
// check: returned: [0x2a]
local function main() -> i32
stack-slot p, size=4, align=4
block0():
  store i32(1), p, offset=0
  call mutate(p) : (ptr) -> void
  y: i32 = load p, offset=0
  return y
local function mutate(p: ptr) -> void
block0():
  store i32(42), p, offset=0
  return

// ----- distinct-objects
// run: execute
// check: returned: [0x2b]
local function main() -> i32
stack-slot p, size=4, align=4
stack-slot q, size=4, align=4
block0():
  store i32(42), p, offset=0
  store i32(1), q, offset=0
  y: i32 = load p, offset=0
  w: i32 = load q, offset=0
  sum: i32 = iadd y, w
  return sum

// ----- recursive-slots
// run: execute
// check: returned: [0x6]
local function main() -> i32
block0():
  result: i32 = call sum(i32(3)) : (i32) -> i32
  return result

local function sum(n: i32) -> i32
stack-slot p, size=4, align=4
block0():
  done: bool = icmp eq n, i32(0)
  br done, block1(), block2()
block1():
  return i32(0)
block2():
  store n, p, offset=0
  next: i32 = isub n, i32(1)
  rest: i32 = call sum(next) : (i32) -> i32
  saved: i32 = load p, offset=0
  result: i32 = iadd saved, rest
  return result

// ----- slot-created-after-a-literal
// run: execute
// check: returned: [0x2a]
local function main() -> i32
stack-slot p.v1, size=4, align=4
block0():
  store i32(42), p.v1, offset=0
  v2: i32 = load p.v1, offset=0
  return v2
