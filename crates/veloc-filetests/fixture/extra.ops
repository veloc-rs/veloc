import "../../../veloc/mir/defs/module.ops";

// Exercise contracts not represented by production MIR instructions.
// These have no control lowering interface: validation comes only from defs.
struct SizeInfo { next: u32, aligned: bool }
fn NextSize(size: u32) -> u32 { value: size + 1 }
struct CheckedSize { size: u32 }
op CheckedSize(size: u32) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "checked-size", storage: CheckedSize { size },
    text: "size={size}",
    query size_info -> SizeInfo { next: NextSize(size), aligned: is_power_of_two(size) }
    query original_size -> SizeInfo { next: size, aligned: false }
    verify {
        require(NextSize(size) > size, "size overflow");
        require(is_power_of_two(size), "invalid size alignment");
    }
}

struct VectorLiteral {
    payload: VectorConst,
}
// Codec and result type follow the parameter type; validation is explicit.
op VectorLiteral(data: VectorConst) -> type(data) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "vector-literal", storage: VectorLiteral { payload: data },
    verify(ctx: ConstContext) {
        require(!data.is_dense() || len(ctx.bytes(data)?) == data.ty().min_size_bytes()?, "dense vector constant byte count must match its type");
    }
}

struct CallableInfo { signature: optional(SigId) }
fn InspectCallable(ty: Type) -> CallableInfo {
    value: CallableInfo { signature: ty.signature() },
}
op Rebind(move value: Callable) -> (result: Callable) {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
    mnemonic: "rebind", storage: Unary { arg: value },
    query callable_info -> CallableInfo { signature: value.ty().signature() }

    verify {
        require(value.ty() == result, "rebind type mismatch");
    }
}
struct MoveBranch {
    value: Value,
    dest: BlockCall,
}
op MoveBranch(move value: Callable, dest: successor) -> () {
    meta: OpInfo { traits: OpTraits::TERMINATOR, memory: MemoryEffect::UNKNOWN },
    mnemonic: "move-branch", storage: MoveBranch { value, dest },
}
op Observe(value: Callable) -> () {
    meta: OpInfo { memory: MemoryEffect::UNKNOWN },
mnemonic: "observe", storage: Unary { arg: value }, }

struct FunctionOperand {
    target: FuncId,
}
// Too large for inline fields: test symbol remapping through the field pool.
struct WideRef {
    target: FuncId,
    low: u64,
    high: u64,
}
op WideRef(target: FuncId, low: u64, high: u64) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "wide-ref", storage: WideRef { target, low, high },
}
op FunctionOperand(target: FuncId) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "function-operand", storage: FunctionOperand { target },
text: "{target}", }
struct ExplicitCall {
    target: FuncId,
    args: Inputs,
    sig: SigId,
}
op ExplicitCall(target: FuncId, args: sequence(Value), sig: SigId) -> signature {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "explicit-call", storage: ExplicitCall { target, args, sig },
    signature: sig,
text: "{target}({args}) : {sig}", }

// Alternate names exercise structural field contracts, not spelling-based dispatch.
type Input = rust("crate::Value") { field: operand, }
type Inputs = rust("crate::inst::Arguments") { field: list(Input), }
type Destination = rust("crate::inst::Successor") { field: edge(Input), }
type Destinations = rust("crate::inst::Successors") { field: list(Destination), }
struct TestOperands {
    token: Input,
    optional: optional(Input),
    tag: u32,
}
struct Grouped {
    before: Value,
    group: TestOperands,
    after: Value,
}
op Grouped(before: Type::I32, after: Type::I32, group: TestOperands) -> Type::I32 {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "grouped", storage: Grouped { before, group, after },
    text: "{before}, {after}, token={group.token}[, optional={group.optional}], tag={group.tag}",
}

struct Routed {
    operands: Value,
    group: TestOperands,
    dest: Destination,
    tail: VectorExtData,
}
op Routed(input: Type::I32, group: TestOperands, tail: VectorExtData, dest: successor) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "routed",
    storage: Routed { operands: input, group, dest, tail },
    text: "{input}, {dest}, token={group.token}[, optional={group.optional}], tag={group.tag}, mask={tail.mask}[, evl={tail.evl}]",
}

struct Quinary { args: values(5) }
struct Empty {  }

op Many<A: Any, B: Any, C: Any, D: Any, E: Any>(a: A, b: B, c: C, d: D, e: E) -> (E, A) {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "many", storage: Quinary { args: [a, b, c, d, e] }, }
op ThreeResults<A: Any, B: Any>(a: A, b: B) -> (B, A, Type::BOOL) {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "three-results", storage: Binary { args: [a, b] }, }
op Output<T: Integer>() -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "output", storage: Empty {}, }
op Sized<T: Scalar>(arg: T) -> (result: Type::I8) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "sized", storage: Unary { arg },
verify {
        require(result.element_bits()? > arg.ty().element_bits()?, "result must have more bits per lane than arg");
    } }
op First<T: Integer>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "first", storage: Binary { args: [lhs, rhs] }, }
op Second<U: Integer>(a: U, b: U) -> U {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "second", storage: Binary { args: [a, b] }, }
op FloatOnly<U: Float>(a: U, b: U) -> U {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "float-only", storage: Binary { args: [a, b] }, }

struct Pair { inputs: values(2) }
struct FieldPair { right: Value, left: Value }
struct Triple { args: values(3) }
struct Immediate { value: Value, displacement: i32 }
struct Compare { cc: IntCC, args: values(2) }

op Difference<T: Integer>(left: T, right: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "difference", storage: Pair { inputs: [left, right] }, }
op ReverseText<T: Integer>(left: T, right: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "reverse-text", storage: FieldPair { right: left, left: right },
text: "{right}, {left}", }
op SelectType<T: Integer>(lhs: T, rhs: T) -> Integer {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "select-type", storage: Pair { inputs: [lhs, rhs] }, }
op WidePair<T: ScalarInteger>(lhs: T, rhs: T) -> (T, wide: Type::I64) {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "wide-pair", storage: Pair { inputs: [lhs, rhs] },
verify {
        require(wide.element_bits()? > lhs.ty().element_bits()?, "wide must have more bits per lane than lhs");
    } }
op Triple<T: Integer>(base: T, index: T, increment: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "triple", storage: Triple { args: [base, index, increment] }, }
op Offset(arg: Type::PTR, amount: i32) -> Type::PTR {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "offset", storage: Immediate { value: arg, displacement: amount },
text: "{arg}, amount={amount}", }
struct Extended {
    inputs: ValueList,
    tag: u32,
}
layout Extended {
    format: arity(inputs, [Pair]),
    text: "{inputs}, tag={tag}",
}

typeset Wide = Type::I32 | Type::I64;
op Named<T: Wide>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "named", storage: Binary { args: [lhs, rhs] }, }
op Inline<T: (Type::I64 | Type::I32) & Scalar>(lhs: T, rhs: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "inline", storage: Binary { args: [lhs, rhs] }, }
op Lane<T: vectors(Type::I32 | Type::I64)>(arg: T) -> element(T) {
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "lane", storage: Unary { arg }, }
op Convert<T: Type::I32 | Type::I64, U: Float & Scalar>(arg: T) -> U {
    verify { require(U.same_shape(T), "input and result must have the same shape"); }
    meta: OpInfo { memory: MemoryEffect::NONE },
mnemonic: "convert", storage: Unary { arg }, }

op Direct<T: ScalarInteger>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "direct", storage: Binary { args: [lhs, rhs] }, semantics: bv.sub(lhs, rhs)
}
op Reversed<T: ScalarInteger>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "reversed", storage: Binary { args: [lhs, rhs] }, semantics: bv.sub(rhs, lhs)
}
op Composed<T: ScalarInteger>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "composed", storage: Binary { args: [lhs, rhs] }, semantics: bv.add(lhs, bv.sub(rhs, bv.one()))
}
op Trapping<T: ScalarInteger>(lhs: T, rhs: T) -> T {
    meta: OpInfo {},
    mnemonic: "trapping", storage: Binary { args: [lhs, rhs] }, semantics: bv.udiv(lhs, rhs),
    traps: [DivisionByZero(bv.eq(rhs, bv.zero()))]
}
op Multiple<T: ScalarInteger>(lhs: T, rhs: T) -> (T, Type::BOOL) {
    meta: OpInfo {},
    mnemonic: "multiple", storage: Binary { args: [lhs, rhs] }, semantics: [bv.add(lhs, rhs), bv.eq(lhs, rhs)]
}
op CompareValue<T: ScalarInteger>(lhs: T, condition: IntCC, rhs: T) -> Type::BOOL {
    meta: OpInfo {},
    mnemonic: "compare-value", storage: Compare { cc: condition, args: [lhs, rhs] },
    semantics: bv.cmp(condition, lhs, rhs)
}
op VectorOnly<T: vectors(ScalarInteger)>(arg: T) -> T {
    meta: OpInfo {},
    mnemonic: "vector-only", storage: Unary { arg }, semantics: bv.sub(bv.zero(), arg)
}

encoding PackedRecord {
    storage: u8,
    fields: [enabled(1), count(3), tag(4)]
}
encoding WideRecord { storage: u128, fields: [value(128)] }

// Defs-owned records/enums can contain shared Rust flag sets.
enum TestPolicy { variants: [Automatic, Prefer(MemoryEffects)] }
struct TestSettings {
    enabled: bool,
    policy: TestPolicy,
}
struct TestMetadata {
    settings: TestSettings,
    fallback: optional(TestPolicy),
}

// Deliberately reverse declaration order to exercise canonical set emission.
struct EffectSet {  }
op EffectSet() -> () {
    meta: OpInfo { memory: MemoryEffect::known(MemoryEffects::WRITE.union(MemoryEffects::READ)) },
mnemonic: "effect-set", storage: EffectSet {}, }

// One field declaration can serve as both a primary layout and a nested property.
struct LiteralPayload { bits: u32 }
struct WrappedPayload { inner: LiteralPayload }
op Payload(bits: u32) -> Type::I32 {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "payload", storage: LiteralPayload { bits }
}
op Wrapped(inner: LiteralPayload) -> Type::I32 {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "wrapped", storage: WrappedPayload { inner },
    text: "{inner.bits}"
}

type Stamp = rust("crate::tokens::Stamp") {
    fn number(self) -> u32;
    fn twice(self) -> u32 { value: self.number() * 2 }
}
type Tokens = rust("crate::tokens::Tokens") {
    fn stamp(&self, number: u32) -> Stamp;
}
struct StampRecord { stamp: Stamp }
enum StampResult { variants: [Present(Stamp), Absent] }
struct StampInfo { stamp: Stamp, doubled: u32 }
struct StampInput { number: u32 }
op ReadStamp(number: u32) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "read-stamp", storage: StampInput { number },
    text: "{number}",
    query stamp_info(ctx: Tokens) -> StampInfo { stamp: ctx.stamp(number), doubled: ctx.stamp(number).twice() }
}

fn double_bits(from: Type, to: Type) -> bool {
    value: to.element_bits()? == from.element_bits()? * 2
}

op DoubleWidth<T: Integer, U: Integer>(arg: T) -> (result: U) {
    meta: OpInfo {},
    mnemonic: "double-width",
    storage: Unary { arg },
    verify {
        require(U.same_shape(T), "input and result must have the same shape");
        require(double_bits(T, result), "result must have twice the element width");
        require(!T.is_vector() || T.lanes()? == 4, "only four-lane vectors");
    }
    semantics: bv.sext(arg, result(0))
}

op FourLane<T: Integer>(arg: T) -> T {
    meta: OpInfo {},
    mnemonic: "four-lane",
    storage: Unary { arg },
    verify {
        require(arg.ty().lanes()? == 4, "requires four lanes");
    }
    semantics: bv.neg(arg)
}

fn scalable(ty: Type) -> bool = rust("crate::Type::is_scalable");
op RuntimeScalable<T: Integer>(arg: T) -> T {
    meta: OpInfo { memory: MemoryEffect::NONE }, mnemonic: "runtime-scalable", storage: Unary { arg },
    verify { require(scalable(T), "scalable only"); }
}

struct RoutedTable {
    index: Input,
    targets: Destinations,
}
op RoutedTable(index: Type::I32, cases: successors, default: successor) -> () {
    meta: OpInfo { memory: MemoryEffect::NONE },
    mnemonic: "routed-table",
    storage: RoutedTable { index, targets: table(cases, default) },
    text: "{index}, {cases}, {default}",
}
